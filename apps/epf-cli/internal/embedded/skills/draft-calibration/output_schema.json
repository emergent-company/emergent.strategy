{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "draft-calibration output",
  "type": "object",
  "required": ["calibration_memo"],
  "properties": {
    "calibration_memo": {
      "type": "object",
      "required": [
        "name",
        "decision",
        "reasoning",
        "okr_hit_rate_pct",
        "invalidated_assumption_count",
        "learnings",
        "next_cycle_focus",
        "metadata"
      ],
      "properties": {
        "name": { "type": "string" },
        "decision": { "type": "string", "enum": ["persevere", "pivot", "pull_the_plug"] },
        "reasoning": { "type": "string", "minLength": 50, "maxLength": 500 },
        "okr_hit_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "invalidated_assumption_count": { "type": "integer", "minimum": 0 },
        "learnings": {
          "type": "object",
          "required": ["validated_assumptions", "invalidated_assumptions", "surprises"],
          "properties": {
            "validated_assumptions": {
              "type": "array",
              "items": { "type": "string", "minLength": 30, "maxLength": 300 },
              "minItems": 0,
              "maxItems": 10
            },
            "invalidated_assumptions": {
              "type": "array",
              "items": { "type": "string", "minLength": 30, "maxLength": 300 },
              "minItems": 0,
              "maxItems": 10
            },
            "surprises": {
              "type": "array",
              "items": { "type": "string", "minLength": 30, "maxLength": 300 },
              "minItems": 0,
              "maxItems": 10
            }
          },
          "additionalProperties": false
        },
        "next_cycle_focus": {
          "type": "object",
          "required": ["continue_building", "stop_building", "start_exploring"],
          "properties": {
            "continue_building": {
              "type": "array",
              "items": { "type": "string", "minLength": 30, "maxLength": 200 },
              "minItems": 0,
              "maxItems": 8
            },
            "stop_building": {
              "type": "array",
              "items": { "type": "string", "minLength": 30, "maxLength": 200 },
              "minItems": 0,
              "maxItems": 8
            },
            "start_exploring": {
              "type": "array",
              "items": { "type": "string", "minLength": 30, "maxLength": 200 },
              "minItems": 0,
              "maxItems": 8
            }
          },
          "additionalProperties": false
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
