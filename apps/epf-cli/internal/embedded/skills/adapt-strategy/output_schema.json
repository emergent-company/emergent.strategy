{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "adapt-strategy output",
  "description": "Output produced by the adapt-strategy skill. strategy_formula and roadmap_recipe are full replacement payloads. lra_evolution_entry is appended to the LRA evolution_log. new_assumptions replaces riskiest_assumptions for affected tracks.",
  "type": "object",
  "required": ["strategy_formula", "roadmap_recipe"],
  "properties": {
    "strategy_formula": {
      "type": "object",
      "description": "Full replacement payload for the strategy_formula artifact."
    },
    "roadmap_recipe": {
      "type": "object",
      "description": "Full replacement payload for the roadmap_recipe artifact."
    },
    "lra_evolution_entry": {
      "type": "object",
      "description": "A single evolution log entry to append to the LRA evolution_log.",
      "required": ["cycle_reference", "timestamp", "trigger", "summary", "changes"],
      "properties": {
        "cycle_reference": {
          "type": "string",
          "pattern": "^(bootstrap|C[0-9]+)$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "trigger": {
          "type": "string",
          "enum": ["bootstrap_complete", "aim_signals", "external_change", "milestone_reached", "constraint_change", "cycle_transition", "manual_update"]
        },
        "updated_by": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "maxLength": 200
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["section", "field", "change_type"],
            "properties": {
              "section": {
                "type": "string"
              },
              "field": { "type": "string" },
              "change_type": {
                "type": "string",
                "enum": ["created", "updated", "removed"]
              },
              "previous_value": {},
              "new_value": {},
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "new_assumptions": {
      "type": "array",
      "description": "Replacement riskiest_assumptions for affected tracks. Empty array clears all assumptions (pull_the_plug decision). Each item matches the riskiest_assumptions item schema.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^asm-[psoc]-[0-9]{3}$"
          },
          "description": { "type": "string", "minLength": 50, "maxLength": 500 },
          "type": {
            "type": "string",
            "enum": ["desirability", "feasibility", "viability", "adaptability"]
          },
          "criticality": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "evidence_required": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
