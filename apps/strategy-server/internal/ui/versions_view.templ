package ui

import (
	"fmt"
	"strconv"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
)

// VersionRow is a single published strategy version for the list view.
type VersionRow struct {
	ID                  string
	VersionNumber       int
	Label               string // empty string if no label
	Description         string
	Status              string // published | superseded | restored
	Source              string // manual | convergence | aim_cycle
	CalibrationDecision string // persevere | pivot | pull_the_plug — set when Source == "aim_cycle"
	ArtifactCount       int
	PublishedAt         string
	EquilibScore        string // formatted "87%" or "" if none
	InstanceID          string
}

// VersionDiffEntry is a single artifact in a diff.
type VersionDiffEntry struct {
	ArtifactKey   string
	ArtifactType  string   // e.g. "north_star", "feature_definition"
	Label         string   // human-readable, e.g. "North Star"
	Href          string   // link to the artifact view page (empty if not linkable)
	Category      string   // "READY", "FIRE", "AIM", or "Other"
	ChangeDetails []string // human-readable field-level changes
}

// VersionDetailData holds data for the single-version detail view.
type VersionDetailData struct {
	NavContext
	InstanceID    string
	Ver           VersionRow
	Added         []VersionDiffEntry
	Removed       []VersionDiffEntry
	Changed       []VersionDiffEntry
	DiffSummary   string
	HasParent     bool

	// Calibration context — extracted from calibration memo in snapshot.
	CalibrationDecision string // persevere | pivot | pull_the_plug
	CalibrationReasoning string
	OKRHitRatePct       string // formatted, e.g. "0%"

	// Strategic insights — from assessment report in snapshot.
	StrategicInsights []string

	// Cycle run link — the orchestration run that produced this version.
	CycleRunID string // empty if not found
}

// VersionsViewData holds data for the version list screen.
type VersionsViewData struct {
	NavContext
	InstanceID          string
	Versions            []VersionRow
	HasRealCalibration  bool // true when a real (non-stub) calibration decision exists
}

// VersionsContent renders the version history list.
templ VersionsContent(data VersionsViewData) {
	@TabBackLink(data.TabGroup, data.InstanceID, data.CurrentPath)
	<div class="space-y-6">
		// ── Header ──
		<div>
			<h2 class="text-xl font-bold text-base-content">{ langs.T(ctx, "page.version_history") }</h2>
			<p class="text-sm text-base-content/75 mt-0.5">
				Published snapshots of this strategy instance
			</p>
		</div>

		if len(data.Versions) == 0 {
			<div class="text-center py-12">
				<span class="iconify lucide--history size-12 text-base-content/20 mx-auto block mb-4"></span>
				<p class="text-base font-medium text-base-content/75">No versions yet</p>
				<p class="text-sm text-base-content/55 mt-1 mb-6 max-w-md mx-auto">
					Versions are point-in-time snapshots of your strategy. A version is
					automatically published when an AIM cycle completes, or you can publish
					one manually.
				</p>
				<div class="flex items-center justify-center gap-3">
					<form method="POST" action={ templ.URL("/strategies/" + data.InstanceID + "/aim/publish") }>
						<button type="submit" class="btn btn-sm btn-outline gap-2">
							<span class="iconify lucide--bookmark size-4"></span>
							Publish snapshot now
						</button>
					</form>
				</div>
			</div>
		} else {
			<div class="rounded-xl border border-base-content/15 bg-base-100 shadow-sm overflow-hidden">
				<div class="divide-y divide-base-content/5">
					for _, v := range data.Versions {
						@versionListRow(v)
					}
				</div>
			</div>
		}
	</div>
}

templ versionListRow(v VersionRow) {
	<a
		href={ templ.SafeURL("/strategies/" + v.InstanceID + "/aim/versions/" + v.ID) }
		class="flex items-center gap-4 px-5 py-3.5 hover:bg-base-100 transition-colors group"
	>
		// Version number + label
		<div class="grow min-w-0">
			<div class="flex items-center gap-2 flex-wrap">
				<span class="text-sm font-bold text-base-content tabular-nums">v{ strconv.Itoa(v.VersionNumber) }</span>
				if v.Label != "" {
					<span class="text-sm text-base-content/80">{ v.Label }</span>
				}
			@versionSourceBadge(v.Source)
			if v.Source == "convergence" {
				<span
					hx-get={ "/strategies/" + v.InstanceID + "/activity" }
					hx-target="#tab-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					onclick="event.preventDefault(); event.stopPropagation();"
					class="badge badge-xs badge-ghost gap-1 hover:badge-primary transition-colors cursor-pointer"
				>
					<span class="iconify lucide--activity size-2.5"></span>
					Activity
				</span>
			}
			if v.Source == "aim_cycle" {
				<span
					hx-get={ "/strategies/" + v.InstanceID + "/aim" }
					hx-target="#tab-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					onclick="event.preventDefault(); event.stopPropagation();"
					class="badge badge-xs badge-ghost gap-1 hover:badge-primary transition-colors cursor-pointer"
				>
					<span class="iconify lucide--play-circle size-2.5"></span>
					AIM cycle
				</span>
			}
			if v.CalibrationDecision != "" {
				@calibrationDecisionMini(v.CalibrationDecision)
			}
			@versionStatusBadge(v.Status)
			</div>
			if v.Description != "" {
				<p class="text-xs text-base-content/65 mt-0.5 truncate">{ v.Description }</p>
			}
			<p class="text-xs text-base-content/55 mt-0.5">{ v.PublishedAt }</p>
		</div>

		// Artifact count + equilibrium
		<div class="text-right shrink-0 hidden sm:block">
			<p class="text-xs text-base-content/65">{ fmt.Sprintf(langs.T(ctx, "settings.instance.artifact_count"), v.ArtifactCount) }</p>
			if v.EquilibScore != "" {
				<div class="tooltip tooltip-left" data-tip="Equilibrium — how aligned the strategy artifacts are">
					<p class="text-xs text-base-content/55">eq { v.EquilibScore }</p>
				</div>
			}
		</div>

		// Chevron
		<span class="iconify lucide--chevron-right size-4 text-base-content/30 group-hover:text-base-content/75 shrink-0"></span>
	</a>
}

// VersionDetailContent renders a single version with diff from parent.
templ VersionDetailContent(data VersionDetailData) {
	@StepBackLink(data.NavContext)
	<div class="space-y-6">
		// ── Header ──
		<div class="flex items-start justify-between gap-4">
			<div>
				<div class="flex items-center gap-2 flex-wrap mb-1">
					<h2 class="text-xl font-bold text-base-content">v{ strconv.Itoa(data.Ver.VersionNumber) }</h2>
					if data.Ver.Label != "" {
						<span class="text-xl text-base-content/75">{ data.Ver.Label }</span>
					}
					@versionSourceBadge(data.Ver.Source)
					if data.Ver.CalibrationDecision != "" {
						@calibrationDecisionMini(data.Ver.CalibrationDecision)
					}
					@versionStatusBadge(data.Ver.Status)
				</div>
				<p class="text-sm text-base-content/65">{ data.Ver.PublishedAt }</p>
				if data.Ver.Description != "" {
					<p class="text-sm text-base-content/75 mt-1">{ data.Ver.Description }</p>
				}
			</div>
			// Restore button — only for non-active versions
			if data.Ver.Status != "published" || true {
				<form
					hx-post={ "/strategies/" + data.InstanceID + "/aim/versions/" + data.Ver.ID + "/restore" }
					hx-confirm="Restore this version? Current state will be replaced."
				>
					<button type="submit" class="btn btn-sm btn-outline gap-2">
						<span class="iconify lucide--rotate-ccw size-4"></span>
						Restore
					</button>
				</form>
			}
		</div>

		// ── Stats ──
		<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
			@versionStatCard("Artifacts", fmt.Sprintf("%d", data.Ver.ArtifactCount), "lucide--layers")
			if data.Ver.EquilibScore != "" {
				@versionStatCard("Equilibrium", data.Ver.EquilibScore, "lucide--activity")
			}
			if data.HasParent {
				@versionStatCard("Changes vs parent", fmt.Sprintf("+%d / ~%d / -%d", len(data.Added), len(data.Changed), len(data.Removed)), "lucide--diff")
			}
		</div>

		// ── Calibration context (AIM cycle versions only) ──
		if data.CalibrationDecision != "" {
			<div class="rounded-xl border border-base-content/15 bg-base-100 shadow-sm overflow-hidden">
				<div class="px-5 py-4 border-b border-base-content/5 flex items-center gap-3">
					<span class="iconify lucide--compass size-4 text-base-content/55"></span>
					<h3 class="text-sm font-semibold text-base-content">Calibration Decision</h3>
					<span class={ "badge badge-sm ml-auto", calibrationDecisionBadgeClass(data.CalibrationDecision) }>
						{ calibrationDecisionLabel(data.CalibrationDecision) }
					</span>
					if data.OKRHitRatePct != "" {
						<span class="text-xs text-base-content/65">OKR hit rate: { data.OKRHitRatePct }</span>
					}
				</div>
				if data.CalibrationReasoning != "" {
					<div class="px-5 py-3">
						<p class="text-sm text-base-content/80 leading-relaxed">{ data.CalibrationReasoning }</p>
					</div>
				}
			</div>
		}

		// ── Strategic insights (from assessment report) ──
		if len(data.StrategicInsights) > 0 {
			<div class="rounded-xl border border-base-content/15 bg-base-100 shadow-sm overflow-hidden">
				<div class="px-5 py-4 border-b border-base-content/5 flex items-center gap-2">
					<span class="iconify lucide--lightbulb size-4 text-base-content/55"></span>
					<h3 class="text-sm font-semibold text-base-content">Strategic Insights</h3>
				</div>
				<div class="px-5 py-3 space-y-2">
					for _, insight := range data.StrategicInsights {
						<div class="flex items-start gap-2.5">
							<span class="iconify lucide--arrow-right size-3 text-primary shrink-0 mt-1"></span>
							<p class="text-sm text-base-content/80 leading-relaxed">{ insight }</p>
						</div>
					}
				</div>
			</div>
		}

		// ── Cycle run link ──
		if data.CycleRunID != "" {
			<div class="flex items-center gap-2">
				<span class="iconify lucide--play-circle size-3.5 text-base-content/55"></span>
				<a
					href={ templ.URL("/strategies/" + data.InstanceID + "/aim/runs/" + data.CycleRunID) }
					hx-get={ "/strategies/" + data.InstanceID + "/aim/runs/" + data.CycleRunID }
					hx-target="#tab-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="text-xs text-primary hover:underline"
				>
					View the cycle run that produced this version
				</a>
			</div>
		}

		// ── Diff ──
		if data.HasParent {
			<div class="space-y-4">
				<h3 class="text-sm font-bold text-base-content/75 uppercase tracking-widest">Changes from previous version</h3>
				if data.DiffSummary != "" {
					<p class="text-sm text-base-content/75">{ data.DiffSummary }</p>
				}
				if len(data.Added) > 0 {
					@diffSection("Added", data.Added, "text-success", "lucide--plus-circle")
				}
				if len(data.Changed) > 0 {
					@diffSection("Modified", data.Changed, "text-warning", "lucide--pencil")
				}
				if len(data.Removed) > 0 {
					@diffSection("Removed", data.Removed, "text-error", "lucide--minus-circle")
				}
				if len(data.Added) == 0 && len(data.Changed) == 0 && len(data.Removed) == 0 {
					<p class="text-sm text-base-content/55">No artifact changes detected from parent version.</p>
				}
			</div>
		} else {
			<div class="rounded-lg bg-base-100 border border-base-content/10 px-4 py-3 flex items-start gap-2">
				<span class="iconify lucide--info size-4 text-base-content/30 mt-0.5 shrink-0"></span>
				<p class="text-xs text-base-content/55">This is the first version — no parent to diff against.</p>
			</div>
		}
	</div>
}

templ diffSection(title string, entries []VersionDiffEntry, colorClass, iconClass string) {
	<div>
		<div class="flex items-center gap-2 mb-2">
			<span class={ "iconify size-4", iconClass, colorClass }></span>
			<span class={ "text-xs font-bold uppercase tracking-wide", colorClass }>{ title } ({ strconv.Itoa(len(entries)) })</span>
		</div>
		<div class="space-y-1">
			for _, e := range entries {
				<div class="rounded-lg bg-base-100 overflow-hidden">
					if e.Href != "" {
						<a
							href={ templ.URL(e.Href) }
							hx-get={ e.Href }
							hx-target="#tab-content"
							hx-swap="innerHTML"
							hx-push-url="true"
							class="flex items-center gap-2 px-3 py-2 hover:bg-base-200 transition-colors cursor-pointer group"
						>
							<span class="iconify lucide--file size-3.5 text-base-content/30 shrink-0"></span>
							<span class="text-xs text-base-content/80 group-hover:text-primary font-medium grow">{ e.Label }</span>
							if e.Category != "" {
								<span class="text-[10px] text-base-content/30">{ e.Category }</span>
							}
							<span class="iconify lucide--arrow-right size-3 text-base-content/20 group-hover:text-primary shrink-0"></span>
						</a>
					} else {
						<div class="flex items-center gap-2 px-3 py-2">
							<span class="iconify lucide--file size-3.5 text-base-content/30 shrink-0"></span>
							<span class="text-xs text-base-content/80 grow">
								if e.Label != "" {
									{ e.Label }
								} else {
									<span class="font-mono">{ e.ArtifactKey }</span>
								}
							</span>
							if e.Category != "" {
								<span class="text-[10px] text-base-content/30">{ e.Category }</span>
							}
						</div>
					}
					if len(e.ChangeDetails) > 0 {
						<div class="px-3 pb-2 pt-0 space-y-0.5">
							for _, detail := range e.ChangeDetails {
								<p class="text-[11px] text-base-content/65 leading-snug pl-5">{ detail }</p>
							}
						</div>
					}
				</div>
			}
		</div>
	</div>
}

templ versionStatCard(label, value, icon string) {
	<div class="rounded-xl border border-base-content/15 bg-base-100 px-4 py-3 text-center">
		<span class={ "iconify size-4 text-base-content/30 mx-auto block mb-1", icon }></span>
		<p class="text-lg font-bold text-base-content">{ value }</p>
		<p class="text-xs text-base-content/65">{ label }</p>
	</div>
}

templ versionSourceBadge(source string) {
	switch source {
		case "convergence":
			<div class="tooltip" data-tip="Published automatically by convergence resolution">
				<span class="badge badge-xs badge-success badge-outline gap-1">
					<span class="iconify lucide--cpu size-2.5"></span>
					Auto
				</span>
			</div>
		case "aim_cycle":
			<div class="tooltip" data-tip="Published as part of an AIM cycle run">
				<span class="badge badge-xs badge-primary badge-outline gap-1">
					<span class="iconify lucide--sparkles size-2.5"></span>
					AIM Cycle
				</span>
			</div>
		default:
			<div class="tooltip" data-tip="Published manually by a team member">
				<span class="badge badge-xs badge-ghost gap-1">
					<span class="iconify lucide--user size-2.5"></span>
					Manual
				</span>
			</div>
	}
}

templ calibrationDecisionMini(decision string) {
	switch decision {
		case "persevere":
			<div class="tooltip" data-tip="Continue with current strategy direction">
				<span class="badge badge-xs badge-success gap-1">{ langs.T(ctx, "calibration.decision.persevere") }</span>
			</div>
		case "pivot":
			<div class="tooltip" data-tip="Significant change in strategy direction">
				<span class="badge badge-xs badge-warning gap-1">{ langs.T(ctx, "calibration.decision.pivot") }</span>
			</div>
		case "pull_the_plug":
			<div class="tooltip" data-tip="Abandon this strategic direction">
				<span class="badge badge-xs badge-error gap-1">{ langs.T(ctx, "calibration.decision.pull_the_plug") }</span>
			</div>
	}
}

templ versionStatusBadge(status string) {
	switch status {
		case "published":
			<div class="tooltip" data-tip="This is the active published version">
				<span class="badge badge-xs badge-primary">Current</span>
			</div>
		case "restored":
			<div class="tooltip" data-tip="This version was restored from a previous snapshot">
				<span class="badge badge-xs badge-info">Restored</span>
			</div>
		case "superseded":
			<div class="tooltip" data-tip="This version has been replaced by a newer one">
				<span class="badge badge-xs badge-ghost text-base-content/55">Superseded</span>
			</div>
		default:
			<span class="badge badge-xs badge-ghost">{ status }</span>
	}
}
