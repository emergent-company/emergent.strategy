package ui

import (
	"strconv"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
)

// InsightAnalysesData holds all data for the bespoke Insight Analyses view.
type InsightAnalysesData struct {
	NavContext
	ArtifactKey  string
	Name         string
	Status       string
	LastUpdated  string
	NextReview   string
	Confidence   string

	// Trends by category
	Trends map[string][]InsightTrend

	// Personas
	Personas []InsightPersona

	// SWOT
	Strengths     []InsightStrength
	Weaknesses    []InsightWeakness
	Opportunities []InsightOpportunity
	Threats       []InsightThreat

	// Competitive landscape
	DirectCompetitors   []InsightCompetitor
	StrategyTools       []InsightCompetitor
	IndirectCompetitors []InsightIndirect

	// Key insights
	KeyInsights []InsightKey

	// White spaces
	WhiteSpaces []InsightWhiteSpace

	// Market
	MarketDefinition InsightMarket
	MarketSegments   []InsightSegment

	// Synthesis
	OpportunityConvergence []InsightConvergence

	// Sections whose entries share one card layout: market dynamics, value
	// chain, substitutes, barriers, strategic implications and tensions,
	// product-problem fit, validation, hypotheses, confidence gaps, next steps.
	Records []InsightRecordSection

	// Stored content that no section above shows. It is rendered as stored,
	// under a notice, so that nothing in the artifact is dropped silently.
	Unshown map[string]any

	// Section completeness gaps
	Gaps []ReadyGap
}

// Slots of the record sections on the page.
const (
	InsightSlotMarket      = "market"
	InsightSlotCompetitive = "competitive"
	InsightSlotSynthesis   = "synthesis"
)

// Kinds of record section. Each has a title, icon and slot in insightRecordStyles.
const (
	InsightKindMarketDynamics   = "market_dynamics"
	InsightKindValueChain       = "value_chain"
	InsightKindSubstitutes      = "substitutes"
	InsightKindBarriers         = "barriers_to_entry"
	InsightKindImplications     = "strategic_implications"
	InsightKindTensions         = "strategic_tensions"
	InsightKindProblemFit       = "product_problem_fit"
	InsightKindValidation       = "validation_status"
	InsightKindHypotheses       = "problem_solution_hypotheses"
	InsightKindConfidenceGaps   = "confidence_gaps"
	InsightKindNextSteps        = "next_analytical_steps"
)

type insightRecordStyle struct{ Slot, Title, Icon, Color string }

var insightRecordStyles = map[string]insightRecordStyle{
	InsightKindMarketDynamics: {InsightSlotMarket, "Market Dynamics", "lucide--waves", "info"},
	InsightKindValueChain:     {InsightSlotMarket, "Value Chain", "lucide--workflow", "info"},
	InsightKindSubstitutes:    {InsightSlotCompetitive, "Substitutes", "lucide--replace", "error"},
	InsightKindBarriers:       {InsightSlotCompetitive, "Barriers to Entry", "lucide--shield", "error"},
	InsightKindImplications:   {InsightSlotSynthesis, "Strategic Implications", "lucide--compass", "primary"},
	InsightKindTensions:       {InsightSlotSynthesis, "Strategic Tensions", "lucide--scale", "warning"},
	InsightKindProblemFit:     {InsightSlotSynthesis, "Product-Problem Fit", "lucide--puzzle", "secondary"},
	InsightKindValidation:     {InsightSlotSynthesis, "Validation Status", "lucide--flask-conical", "accent"},
	InsightKindHypotheses:     {InsightSlotSynthesis, "Problem-Solution Hypotheses", "lucide--target", "accent"},
	InsightKindConfidenceGaps: {InsightSlotSynthesis, "Confidence Gaps", "lucide--circle-help", "warning"},
	InsightKindNextSteps:      {InsightSlotSynthesis, "Next Analytical Steps", "lucide--list-checks", "primary"},
}

// InsightRecordSection is a list of InsightRecord cards of one kind.
type InsightRecordSection struct {
	Kind    string
	Records []InsightRecord
}

// InsightRecord is one card: a headline, labelled values and labelled lists.
type InsightRecord struct {
	Head  string
	Facts []InsightFact
	Lists []InsightList
}

type InsightFact struct{ Label, Value string }

type InsightList struct {
	Label string
	Items []string
}

type InsightTrend struct {
	Trend, Impact, Timeframe, ImplicationsForUs string
	Evidence                                    []string
}
type InsightPersona struct {
	Name, Description, Context, Frequency string
	Goals                                 []string
	Problems                              []InsightProblem
	Jobs                                  []InsightJob
}
type InsightProblem struct {
	Problem, Severity, Frequency, CurrentSolution, CostOfProblem, WillingnessToSolve string
	Workarounds, Evidence                                                            []string
}
type InsightJob struct {
	Job, When, DesiredOutcome, Satisfaction string
}
type InsightStrength struct {
	Strength, StrategicValue string
	Evidence                 []string
}
type InsightWeakness struct {
	Weakness, Impact, Mitigation string
}
type InsightOpportunity struct {
	Opportunity, Priority, HowToExploit string
}
type InsightThreat struct {
	Threat, Likelihood, Mitigation string
}
type InsightCompetitor struct {
	Name, Positioning                       string
	MarketShare, TargetSegment, BusinessModel string
	Strengths                               []string
	Weaknesses                              []string
}
type InsightIndirect struct {
	Name, ThreatLevel, HowTheySolve string
}
type InsightKey struct {
	Insight, StrategicImplication string
	SupportingTrends             []string
}
type InsightWhiteSpace struct {
	Gap, OpportunityPotential string
	Evidence                  []string
}
type InsightMarket struct {
	TAM, SAM, SOM, GrowthRate, MarketStage string
	TAMMethod, SAMDefinition, SOMTimeframe string
}
type InsightSegment struct {
	Segment, Size    string
	Characteristics  []string
	UnmetNeeds       []string
}
type InsightConvergence struct {
	Opportunity, Strength string
	SupportingAnalyses    []string
}

// HasContent reports whether any market field is set.
func (m InsightMarket) HasContent() bool {
	return m.TAM != "" || m.SAM != "" || m.SOM != "" || m.GrowthRate != "" || m.MarketStage != "" ||
		m.TAMMethod != "" || m.SAMDefinition != "" || m.SOMTimeframe != ""
}

func insightHasRecords(sections []InsightRecordSection, slot string) bool {
	for _, sec := range sections {
		if insightRecordStyles[sec.Kind].Slot == slot && len(sec.Records) > 0 {
			return true
		}
	}
	return false
}

templ InsightAnalysesContent(data InsightAnalysesData) {
	@TabBackLink(data.TabGroup, data.InstanceID, data.CurrentPath)
	<div class="space-y-8">
		@detailGapBanner(data.Gaps)
		// ── Hero ──
		<div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-info/10 via-base-100 to-primary/10 border border-info/10">
			<div class="px-6 py-8 sm:px-8">
				<div class="flex items-start justify-between">
					<div class="space-y-2">
						<div class="flex items-center gap-2">
							<span class="iconify lucide--search size-5 text-info"></span>
							<span class="text-xs font-semibold uppercase tracking-widest text-info">{ langs.T(ctx, "artifact.label.insight_analyses") }</span>
							if data.Confidence != "" {
								<span class="tooltip" data-tip={ confidenceHint(data.Confidence) }><span class={ "badge badge-sm", confidenceBadgeClass(data.Confidence) }>{ data.Confidence }</span></span>
							}
						</div>
						<h1 class="text-2xl font-bold text-base-content sm:text-3xl">{ data.Name }</h1>
					</div>
					if data.LastUpdated != "" || data.NextReview != "" {
				<div class="hidden sm:block text-right text-xs text-base-content/75">
					if data.LastUpdated != "" {
						<p>Updated { data.LastUpdated }</p>
					}
					if data.NextReview != "" {
						<p>Next review { data.NextReview }</p>
					}
				</div>
					}
				</div>
			</div>
		</div>

		// ── Market Overview ──
		if data.MarketDefinition.HasContent() || len(data.MarketSegments) > 0 || insightHasRecords(data.Records, InsightSlotMarket) {
			<section>
				@sectionHeading("Market", "lucide--globe", "info", marketSubtitle(data.MarketDefinition))
				<div class="mt-4 grid gap-3 md:grid-cols-4">
					if data.MarketDefinition.TAM != "" || data.MarketDefinition.TAMMethod != "" {
						@marketStatCard("TAM", data.MarketDefinition.TAM, data.MarketDefinition.TAMMethod)
					}
					if data.MarketDefinition.SAM != "" || data.MarketDefinition.SAMDefinition != "" {
						@marketStatCard("SAM", data.MarketDefinition.SAM, data.MarketDefinition.SAMDefinition)
					}
					if data.MarketDefinition.SOM != "" || data.MarketDefinition.SOMTimeframe != "" {
						@marketStatCard("SOM", data.MarketDefinition.SOM, data.MarketDefinition.SOMTimeframe)
					}
					if data.MarketDefinition.GrowthRate != "" {
						@marketStatCard("Growth", data.MarketDefinition.GrowthRate, "")
					}
				</div>
				if len(data.MarketSegments) > 0 {
					<div class="mt-4 space-y-2">
						for _, seg := range data.MarketSegments {
							@segmentRow(seg)
						}
					</div>
				}
				@insightRecordSections(data.Records, InsightSlotMarket)
			</section>
		}

		// ── Trends ──
		if len(data.Trends) > 0 {
			<section>
				@sectionHeading("Trends", "lucide--trending-up", "accent", trendSubtitle(data.Trends))
				<div class="mt-4 space-y-3">
					for _, cat := range trendCategories(data.Trends) {
						if trends, ok := data.Trends[cat]; ok && len(trends) > 0 {
							@trendCategoryAccordion(cat, trends)
						}
					}
				</div>
			</section>
		}

		// ── Personas ──
		if len(data.Personas) > 0 {
			<section>
				@sectionHeading("Target Users", "lucide--users", "primary", strconv.Itoa(len(data.Personas)) + " personas identified")
				<div class="mt-4 space-y-4">
					for _, p := range data.Personas {
						@personaCard(p)
					}
				</div>
			</section>
		}

		// ── Key Insights ──
		if len(data.KeyInsights) > 0 {
			<section>
				@sectionHeading("Key Insights", "lucide--lightbulb", "warning", "")
				<div class="mt-4 space-y-3">
					for _, ins := range data.KeyInsights {
						@keyInsightCard(ins)
					}
				</div>
			</section>
		}

		// ── Competitive Landscape ──
		if len(data.DirectCompetitors) > 0 || len(data.StrategyTools) > 0 || len(data.IndirectCompetitors) > 0 || insightHasRecords(data.Records, InsightSlotCompetitive) {
			<section>
				@sectionHeading("Competitive Landscape", "lucide--swords", "error", "")
				<div class="mt-4 space-y-4">
					if len(data.DirectCompetitors) > 0 {
						<div>
							<h4 class="text-sm font-semibold text-base-content/80 mb-2">Direct Competitors</h4>
							<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
								for _, c := range data.DirectCompetitors {
									@insightCompetitorCard(c)
								}
							</div>
						</div>
					}
					if len(data.StrategyTools) > 0 {
						<div>
							<h4 class="text-sm font-semibold text-base-content/80 mb-2">Strategy Tools</h4>
							<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
								for _, c := range data.StrategyTools {
									@insightCompetitorCard(c)
								}
							</div>
						</div>
					}
					if len(data.IndirectCompetitors) > 0 {
						<div>
							<h4 class="text-sm font-semibold text-base-content/80 mb-2">Indirect Competitors</h4>
							<div class="space-y-2">
								for _, c := range data.IndirectCompetitors {
									<div class="rounded-lg bg-base-100 px-4 py-3 flex items-start justify-between gap-4">
										<div>
											<p class="text-sm font-medium text-base-content">{ c.Name }</p>
											if c.HowTheySolve != "" {
												<p class="text-xs text-base-content/75 mt-0.5">{ c.HowTheySolve }</p>
											}
										</div>
									if c.ThreatLevel != "" {
										<span class="flex items-center gap-1 shrink-0 text-xs text-base-content/65">
											<span>Threat</span>
											<span class={ "badge badge-xs", likelihoodBadge(c.ThreatLevel) }>{ c.ThreatLevel }</span>
										</span>
									}
									</div>
								}
							</div>
						</div>
					}
					@insightRecordSections(data.Records, InsightSlotCompetitive)
				</div>
			</section>
		}

		// ── SWOT ──
		if len(data.Strengths) > 0 || len(data.Weaknesses) > 0 || len(data.Opportunities) > 0 || len(data.Threats) > 0 {
			<section>
				@sectionHeading("SWOT Analysis", "lucide--grid-2x2", "secondary", "")
				<div class="mt-4 grid gap-4 md:grid-cols-2">
					if len(data.Strengths) > 0 {
						@swotQuadrant("Strengths", "lucide--check-circle-2", "success", len(data.Strengths)) {
							for _, s := range data.Strengths {
								<div class="rounded-lg bg-success/5 px-3 py-2">
									<p class="text-sm font-medium text-base-content">{ s.Strength }</p>
									if s.StrategicValue != "" {
										<p class="text-xs text-base-content/75 mt-0.5">{ s.StrategicValue }</p>
									}
									if len(s.Evidence) > 0 {
										<div class="flex flex-wrap gap-1 mt-1.5">
											for _, e := range s.Evidence {
												<span class="badge badge-xs badge-ghost">{ e }</span>
											}
										</div>
									}
								</div>
							}
						}
					}
					if len(data.Weaknesses) > 0 {
						@swotQuadrant("Weaknesses", "lucide--alert-circle", "warning", len(data.Weaknesses)) {
							for _, w := range data.Weaknesses {
								<div class="rounded-lg bg-warning/5 px-3 py-2">
									<p class="text-sm font-medium text-base-content">{ w.Weakness }</p>
									if w.Impact != "" {
										<p class="text-xs text-base-content/75 mt-0.5">Impact: { w.Impact }</p>
									}
									if w.Mitigation != "" {
										<p class="text-xs text-base-content/75 mt-0.5">{ w.Mitigation }</p>
									}
								</div>
							}
						}
					}
					if len(data.Opportunities) > 0 {
						@swotQuadrant("Opportunities", "lucide--sparkles", "info", len(data.Opportunities)) {
							for _, o := range data.Opportunities {
								<div class="rounded-lg bg-info/5 px-3 py-2 flex items-start justify-between gap-2">
									<div>
										<p class="text-sm font-medium text-base-content">{ o.Opportunity }</p>
										if o.HowToExploit != "" {
											<p class="text-xs text-base-content/75 mt-0.5">{ o.HowToExploit }</p>
										}
									</div>
									if o.Priority != "" {
										<span class={ "badge badge-xs shrink-0", priorityBadge(o.Priority) }>{ o.Priority }</span>
									}
								</div>
							}
						}
					}
					if len(data.Threats) > 0 {
						@swotQuadrant("Threats", "lucide--shield-alert", "error", len(data.Threats)) {
							for _, t := range data.Threats {
								<div class="rounded-lg bg-error/5 px-3 py-2 flex items-start justify-between gap-2">
									<div>
										<p class="text-sm font-medium text-base-content">{ t.Threat }</p>
										if t.Mitigation != "" {
											<p class="text-xs text-base-content/75 mt-0.5">{ t.Mitigation }</p>
										}
									</div>
								if t.Likelihood != "" {
									<span class="flex items-center gap-1 shrink-0 text-xs text-base-content/65">
										<span>Likelihood</span>
										<span class={ "badge badge-xs", likelihoodBadge(t.Likelihood) }>{ t.Likelihood }</span>
									</span>
								}
								</div>
							}
						}
					}
				</div>
			</section>
		}

		// ── White Spaces ──
		if len(data.WhiteSpaces) > 0 {
			<section>
				@sectionHeading("White Spaces", "lucide--map-pin", "accent", "Gaps in the market")
				<div class="mt-4 grid gap-3 md:grid-cols-2">
					for _, ws := range data.WhiteSpaces {
						<div class="card bg-base-100 border border-base-content/15 shadow-sm">
							<div class="card-body p-4">
								<p class="text-sm font-medium text-base-content">{ ws.Gap }</p>
								if ws.OpportunityPotential != "" {
									<span class={ "badge badge-xs mt-2", priorityBadge(ws.OpportunityPotential) }>{ ws.OpportunityPotential }</span>
								}
								if len(ws.Evidence) > 0 {
									<div class="flex flex-wrap gap-1 mt-2">
										for _, e := range ws.Evidence {
											<span class="badge badge-xs badge-ghost">{ e }</span>
										}
									</div>
								}
							</div>
						</div>
					}
				</div>
			</section>
		}

		// ── Opportunity Convergence ──
		if len(data.OpportunityConvergence) > 0 {
			<section>
				@sectionHeading("Opportunity Convergence", "lucide--merge", "primary", "Where multiple signals align")
				<div class="mt-4 space-y-3">
					for _, oc := range data.OpportunityConvergence {
						<div class="card bg-base-100 border border-primary/10 shadow-sm">
							<div class="card-body p-4">
								<p class="text-sm font-semibold text-base-content">{ oc.Opportunity }</p>
								if oc.Strength != "" {
									<p class="text-xs text-primary/70 mt-1">{ oc.Strength }</p>
								}
								if len(oc.SupportingAnalyses) > 0 {
									<div class="flex flex-wrap gap-1 mt-2">
										for _, sa := range oc.SupportingAnalyses {
											<span class="badge badge-xs badge-outline badge-primary">{ sa }</span>
										}
									</div>
								}
							</div>
						</div>
					}
				</div>
			</section>
		}

		@insightRecordSections(data.Records, InsightSlotSynthesis)
		@StoredNotShown(data.Unshown)
	</div>
}

// ── Sub-components ──

templ trendCategoryAccordion(category string, trends []InsightTrend) {
	<details class="group rounded-xl border border-base-content/15 bg-base-100 shadow-sm" open?={ category == "technology" }>
		<summary class="flex cursor-pointer items-center gap-3 px-5 py-3.5 text-sm font-semibold text-base-content select-none">
			<span class={ "iconify size-4 text-base-content/65", trendCategoryIcon(category) }></span>
			<span class="grow">{ formatTrendCategory(category) }</span>
			<span class="badge badge-sm badge-ghost">{ strconv.Itoa(len(trends)) }</span>
			<span class="iconify lucide--chevron-right size-4 text-base-content/65 transition-transform group-open:rotate-90"></span>
		</summary>
		<div class="border-t border-base-content/5 px-5 pb-4 pt-3 space-y-3">
			for _, t := range trends {
				<div class="rounded-lg bg-base-100 px-4 py-3">
					<div class="flex items-start justify-between gap-2">
						<p class="text-sm text-base-content">{ t.Trend }</p>
						if t.Timeframe != "" {
							<span class="badge badge-xs badge-ghost shrink-0">{ t.Timeframe }</span>
						}
					</div>
				if t.Impact != "" {
					<p class="text-xs text-base-content/80 mt-1">{ t.Impact }</p>
					}
					if t.ImplicationsForUs != "" {
						<p class="text-xs text-base-content/80 mt-1">Implications for us: { t.ImplicationsForUs }</p>
					}
					if len(t.Evidence) > 0 {
						<div class="flex flex-wrap gap-1 mt-1.5">
							for _, e := range t.Evidence {
								<span class="badge badge-xs badge-ghost">{ e }</span>
							}
						</div>
					}
				</div>
			}
		</div>
	</details>
}

templ personaCard(p InsightPersona) {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body p-5">
			<div class="flex items-center gap-3 mb-3">
				<div class="rounded-full bg-primary/10 p-2">
					<span class="iconify lucide--user size-5 text-primary"></span>
				</div>
				<div>
					<h4 class="text-sm font-bold text-base-content">{ p.Name }</h4>
				if p.Description != "" {
					<p class="text-xs text-base-content/80">{ p.Description }</p>
					}
				</div>
			</div>
			if p.Context != "" || p.Frequency != "" {
				<div class="mb-3 space-y-0.5 text-xs text-base-content/80">
					if p.Context != "" {
						<p><span class="font-medium">Context:</span> { p.Context }</p>
					}
					if p.Frequency != "" {
						<p><span class="font-medium">Frequency:</span> { p.Frequency }</p>
					}
				</div>
			}
			if len(p.Goals) > 0 {
				<div class="mb-3">
					<p class="text-xs font-semibold uppercase tracking-wide text-base-content/75 mb-1">Goals</p>
					<div class="flex flex-wrap gap-1">
						for _, g := range p.Goals {
							<span class="badge badge-sm badge-ghost">{ g }</span>
						}
					</div>
				</div>
			}
			if len(p.Problems) > 0 {
				<div>
					<p class="text-xs font-semibold uppercase tracking-wide text-base-content/75 mb-1">Pain Points</p>
					<div class="space-y-1.5">
						for _, prob := range p.Problems {
							@insightProblemRow(prob)
						}
					</div>
				</div>
			}
			if len(p.Jobs) > 0 {
				<div class="mt-3">
					<p class="text-xs font-semibold uppercase tracking-wide text-base-content/75 mb-1">Jobs to be done</p>
					<div class="space-y-1.5">
						for _, j := range p.Jobs {
							<div class="text-xs text-base-content/80">
								<p class="font-medium text-base-content">{ j.Job }</p>
								if j.When != "" {
									<p>When: { j.When }</p>
								}
								if j.DesiredOutcome != "" {
									<p>Desired outcome: { j.DesiredOutcome }</p>
								}
								if j.Satisfaction != "" {
									<p>Satisfaction with today's solution: { j.Satisfaction }</p>
								}
							</div>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

templ keyInsightCard(ins InsightKey) {
	<div class="card bg-base-100 border border-warning/10 shadow-sm">
		<div class="card-body p-4">
			<div class="flex items-start gap-3">
				<span class="iconify lucide--lightbulb size-4 text-warning mt-0.5 shrink-0"></span>
				<div>
					<p class="text-sm font-medium text-base-content">{ ins.Insight }</p>
			if ins.StrategicImplication != "" {
					<p class="text-xs text-base-content/80 mt-1">{ ins.StrategicImplication }</p>
					}
					if len(ins.SupportingTrends) > 0 {
						<div class="flex flex-wrap gap-1 mt-2">
							for _, t := range ins.SupportingTrends {
								<span class="badge badge-xs badge-ghost">{ t }</span>
							}
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

templ insightCompetitorCard(c InsightCompetitor) {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body p-4">
			<h5 class="text-sm font-bold text-base-content">{ c.Name }</h5>
		if c.Positioning != "" {
			<p class="text-xs text-base-content/80 mt-1">{ c.Positioning }</p>
			}
			if c.MarketShare != "" {
				<p class="text-xs text-base-content/80 mt-1"><span class="font-medium">Market share:</span> { c.MarketShare }</p>
			}
			if c.TargetSegment != "" {
				<p class="text-xs text-base-content/80 mt-1"><span class="font-medium">Target segment:</span> { c.TargetSegment }</p>
			}
			if c.BusinessModel != "" {
				<p class="text-xs text-base-content/80 mt-1"><span class="font-medium">Business model:</span> { c.BusinessModel }</p>
			}
			if len(c.Strengths) > 0 || len(c.Weaknesses) > 0 {
				<div class="grid grid-cols-2 gap-2 mt-2">
					if len(c.Strengths) > 0 {
						<div>
					<p class="text-xs font-medium text-success mb-0.5">Strengths</p>
					<ul class="space-y-0.5">
						for _, s := range c.Strengths {
							<li class="text-xs text-base-content/80">{ s }</li>
						}
					</ul>
				</div>
			}
			if len(c.Weaknesses) > 0 {
				<div>
					<p class="text-xs font-medium text-error mb-0.5">Weaknesses</p>
					<ul class="space-y-0.5">
						for _, w := range c.Weaknesses {
							<li class="text-xs text-base-content/80">{ w }</li>
								}
							</ul>
						</div>
					}
				</div>
			}
		</div>
	</div>
}

templ swotQuadrant(title, icon, color string, count int) {
	<div class={ "card border shadow-sm", borderColor(color) }>
		<div class="card-body p-4">
			<div class="flex items-center gap-2 mb-3">
				<span class={ "iconify size-4", icon, textColor(color) }></span>
				<h4 class="text-sm font-semibold text-base-content">{ title }</h4>
				<span class="badge badge-xs badge-ghost">{ strconv.Itoa(count) }</span>
			</div>
			<div class="space-y-2">
				{ children... }
			</div>
		</div>
	</div>
}

templ marketStatCard(label, value, note string) {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body p-3 text-center">
			if value != "" {
				<p class="text-lg font-bold text-base-content">{ value }</p>
			}
			<p class="text-xs text-base-content/65">{ label }</p>
			if note != "" {
				<p class="text-xs text-base-content/80 mt-1">{ note }</p>
			}
		</div>
	</div>
}

templ insightProblemRow(prob InsightProblem) {
	<div class="flex items-start gap-2">
		<span class={ "size-2 rounded-full mt-1.5 shrink-0", severityDot(prob.Severity) }></span>
		<div class="text-xs text-base-content/80 space-y-0.5">
			<p>{ prob.Problem }</p>
			if prob.Severity != "" {
				<p class="text-base-content/65">Severity: { prob.Severity }</p>
			}
			if prob.Frequency != "" {
				<p class="text-base-content/65">Frequency: { prob.Frequency }</p>
			}
			if prob.CurrentSolution != "" {
				<p class="text-base-content/65">Today: { prob.CurrentSolution }</p>
			}
			if prob.CostOfProblem != "" {
				<p class="text-base-content/65">Cost: { prob.CostOfProblem }</p>
			}
			if prob.WillingnessToSolve != "" {
				<p class="text-base-content/65">Willingness to solve: { prob.WillingnessToSolve }</p>
			}
			for _, w := range prob.Workarounds {
				<p class="text-base-content/65">Workaround: { w }</p>
			}
			if len(prob.Evidence) > 0 {
				<div class="flex flex-wrap gap-1 pt-0.5">
					for _, e := range prob.Evidence {
						<span class="badge badge-xs badge-ghost">{ e }</span>
					}
				</div>
			}
		</div>
	</div>
}

// insightRecordSections renders the record sections that belong in a slot.
templ insightRecordSections(sections []InsightRecordSection, slot string) {
	for _, sec := range sections {
		if insightRecordStyles[sec.Kind].Slot == slot && len(sec.Records) > 0 {
			{{ style := insightRecordStyles[sec.Kind] }}
			<section class="mt-6 first:mt-0">
				@sectionHeading(style.Title, style.Icon, style.Color, strconv.Itoa(len(sec.Records)))
				<div class="mt-4 grid gap-3 md:grid-cols-2">
					for _, rec := range sec.Records {
						@insightRecordCard(rec)
					}
				</div>
			</section>
		}
	}
}

templ insightRecordCard(rec InsightRecord) {
	<div class="rounded-lg bg-base-100 border border-base-content/15 px-4 py-3">
		if rec.Head != "" {
			<p class="text-sm font-medium text-base-content">{ rec.Head }</p>
		}
		for _, f := range rec.Facts {
			<p class="text-xs text-base-content/80 mt-1"><span class="font-medium">{ f.Label }:</span> { f.Value }</p>
		}
		for _, l := range rec.Lists {
			<div class="mt-1.5">
				<p class="text-xs font-medium text-base-content/80">{ l.Label }</p>
				<div class="flex flex-wrap gap-1 mt-0.5">
					for _, item := range l.Items {
						<span class="badge badge-xs badge-ghost">{ item }</span>
					}
				</div>
			</div>
		}
	</div>
}

templ segmentRow(seg InsightSegment) {
	<div class="rounded-lg bg-base-100 px-4 py-3">
		<div class="flex items-start justify-between gap-2">
			<p class="text-sm font-medium text-base-content">{ seg.Segment }</p>
			if seg.Size != "" {
				<span class="badge badge-xs badge-ghost shrink-0">{ seg.Size }</span>
			}
		</div>
		if len(seg.Characteristics) > 0 {
			<div class="flex flex-wrap gap-1 mt-1.5">
				for _, c := range seg.Characteristics {
					<span class="badge badge-xs badge-ghost">{ c }</span>
				}
			</div>
		}
		if len(seg.UnmetNeeds) > 0 {
			<div class="flex flex-wrap gap-1 mt-1.5">
				for _, n := range seg.UnmetNeeds {
					<span class="badge badge-xs badge-outline badge-info">{ n }</span>
				}
			</div>
		}
	</div>
}
