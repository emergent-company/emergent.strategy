package ui

import "strconv"

// StoredNotShown renders the part of an artifact that a bespoke page has no
// dedicated view for, as it is stored, under a notice. content is keyed by the
// top-level field it was found under. It renders nothing when content is empty.
templ StoredNotShown(content map[string]any) {
	if len(content) > 0 {
		<section id="stored-not-shown" class="space-y-3">
			<div class="flex items-start gap-3 rounded-xl border border-warning/30 bg-warning/5 px-4 py-3">
				<span class="iconify lucide--eye-off size-4 text-warning mt-0.5 shrink-0"></span>
				<div>
					<p class="text-sm font-semibold text-base-content">{ storedNotShownTitle(len(content)) }</p>
					<p class="text-xs text-base-content/80 mt-0.5">This page has no dedicated view for it yet, so it is shown here as it is stored.</p>
				</div>
			</div>
			for _, key := range sortedKeys(content) {
				@renderSection(key, content[key], 0)
			}
		</section>
	}
}

// storedNotShownTitle is the headline of the notice.
func storedNotShownTitle(n int) string {
	if n == 1 {
		return "1 section is stored but has no dedicated view"
	}
	return strconv.Itoa(n) + " sections are stored but have no dedicated view"
}
