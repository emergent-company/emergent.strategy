package ui

// SkillRunsPageData holds data for the Skill Runs listing page.
type SkillRunsPageData struct {
	Nav  NavContext
	Runs []SkillRunRow

	// Aggregated usage
	UsageSummary []SkillUsageRow
	TotalRuns    int
	TotalTokens  int
}

// SkillRunRow is a single row in the skill runs table.
type SkillRunRow struct {
	RunID             string
	SkillName         string
	Status            string
	Trigger           string
	ChunksCompleted   int
	ChunkCount        int
	TotalInputTokens  int
	TotalOutputTokens int
	DurationSec       float64
	StartedAt         string // formatted
	Error             string
	BatchID           string
}

// SkillUsageRow is an aggregated usage row by skill name.
type SkillUsageRow struct {
	SkillName    string
	RunCount     int
	InputTokens  int
	OutputTokens int
}

// SkillRunsPageContent renders the Skill Runs page.
templ SkillRunsPageContent(data SkillRunsPageData) {
	@TabRelatedPages("execution", data.Nav.InstanceID, data.Nav.CurrentPath)
	<div class="space-y-6">
		// Header
		<div class="flex items-center gap-3">
			<span class="iconify lucide--cpu size-5 text-primary"></span>
			<div>
				<h2 class="text-lg font-bold text-base-content">Skill Runs</h2>
				<p class="text-xs text-base-content/50">Autonomous skill execution history and LLM token usage</p>
			</div>
		</div>

		// Usage summary cards
		if len(data.UsageSummary) > 0 {
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
				<div class="rounded-xl border border-base-content/10 bg-base-100 px-5 py-4">
					<p class="text-xs font-semibold uppercase tracking-widest text-base-content/50">Total Runs</p>
					<p class="text-2xl font-bold text-base-content mt-1">{ itoa(data.TotalRuns) }</p>
				</div>
				<div class="rounded-xl border border-base-content/10 bg-base-100 px-5 py-4">
					<p class="text-xs font-semibold uppercase tracking-widest text-base-content/50">Total Tokens</p>
					<p class="text-2xl font-bold text-base-content mt-1">{ formatTokens(data.TotalTokens) }</p>
				</div>
				<div class="rounded-xl border border-base-content/10 bg-base-100 px-5 py-4">
					<p class="text-xs font-semibold uppercase tracking-widest text-base-content/50">Skills Used</p>
					<p class="text-2xl font-bold text-base-content mt-1">{ itoa(len(data.UsageSummary)) }</p>
				</div>
			</div>

			// Per-skill token breakdown
			<div class="rounded-xl border border-base-content/10 bg-base-100 overflow-hidden">
				<div class="px-5 py-3 border-b border-base-content/5">
					<p class="text-xs font-semibold uppercase tracking-widest text-base-content/50">Token Usage by Skill</p>
				</div>
				<table class="table table-xs w-full">
					<thead>
						<tr class="text-base-content/50">
							<th>Skill</th>
							<th class="text-right">Runs</th>
							<th class="text-right">Input</th>
							<th class="text-right">Output</th>
							<th class="text-right">Total</th>
						</tr>
					</thead>
					<tbody>
						for _, u := range data.UsageSummary {
							<tr>
								<td class="font-medium">{ cascadeSkillLabel(u.SkillName) }</td>
								<td class="text-right font-mono text-base-content/60">{ itoa(u.RunCount) }</td>
								<td class="text-right font-mono text-base-content/60">{ formatTokens(u.InputTokens) }</td>
								<td class="text-right font-mono text-base-content/60">{ formatTokens(u.OutputTokens) }</td>
								<td class="text-right font-mono font-semibold">{ formatTokens(u.InputTokens + u.OutputTokens) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}

		// Run history table
		if len(data.Runs) > 0 {
			<div class="rounded-xl border border-base-content/10 bg-base-100 overflow-hidden">
				<div class="px-5 py-3 border-b border-base-content/5">
					<p class="text-xs font-semibold uppercase tracking-widest text-base-content/50">Run History</p>
				</div>
				<table class="table table-xs w-full">
					<thead>
						<tr class="text-base-content/50">
							<th>Skill</th>
							<th>Status</th>
							<th>Trigger</th>
							<th>Progress</th>
							<th class="text-right">Tokens</th>
							<th class="text-right">Duration</th>
							<th>Started</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range data.Runs {
							<tr class="hover">
								<td class="font-medium">{ cascadeSkillLabel(r.SkillName) }</td>
								<td>
									@skillRunStatusBadge(r.Status)
								</td>
								<td>
									@cascadeTriggerBadge(r.Trigger)
								</td>
								<td>
									if r.ChunkCount > 0 {
										<span class="font-mono text-base-content/60">{ itoa(r.ChunksCompleted) }/{ itoa(r.ChunkCount) }</span>
									}
								</td>
								<td class="text-right font-mono text-base-content/60">
									if r.TotalInputTokens + r.TotalOutputTokens > 0 {
										{ formatTokens(r.TotalInputTokens + r.TotalOutputTokens) }
									}
								</td>
								<td class="text-right text-base-content/60">
									if r.DurationSec > 0 {
										{ formatDuration(r.DurationSec) }
									}
								</td>
								<td class="text-base-content/50">{ r.StartedAt }</td>
								<td>
									<a
										href={ templ.URL("/strategies/" + data.Nav.InstanceID + "/skill-runs/" + r.RunID) }
										hx-get={ "/strategies/" + data.Nav.InstanceID + "/skill-runs/" + r.RunID }
										hx-target="#tab-content"
										hx-swap="innerHTML"
										hx-push-url="true"
										class="btn btn-xs btn-ghost"
									>Detail</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<div class="flex flex-col items-center justify-center py-16 text-center">
				<span class="iconify lucide--cpu size-10 text-base-content/20 mb-4"></span>
				<p class="text-sm font-medium text-base-content/50">No skill runs yet</p>
				<p class="text-xs text-base-content/30 mt-1 max-w-xs">
					Autonomous skill runs are created when adapt-strategy or adapt-foundations
					executes via MCP or the continuous strategy loop.
				</p>
			</div>
		}
	</div>
}

templ skillRunStatusBadge(status string) {
	switch status {
	case "running":
		<span class="badge badge-xs badge-info gap-1">
			<span class="iconify lucide--loader-2 size-2.5 animate-spin"></span>
			Running
		</span>
	case "completed":
		<span class="badge badge-xs badge-success gap-1">
			<span class="iconify lucide--check size-2.5"></span>
			Completed
		</span>
	case "failed":
		<span class="badge badge-xs badge-error gap-1">
			<span class="iconify lucide--x size-2.5"></span>
			Failed
		</span>
	default:
		<span class="badge badge-xs badge-ghost">{ status }</span>
	}
}
