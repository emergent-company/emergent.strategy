package ui

import (
	"context"
	"strconv"
	"strings"

	"github.com/emergent-company/go-daisy/components/layout"
	"github.com/emergent-company/go-daisy/components/nav"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
	strategynav "github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/navigation"
)

// instanceIDFromPath extracts the UUID segment from a /strategies/:id/... path.
func instanceIDFromPath(path string) string {
	// path looks like /strategies/864950e9-60a9-4432-abf1-981c776e6e71/execution
	parts := strings.SplitN(strings.TrimPrefix(path, "/strategies/"), "/", 2)
	if len(parts) > 0 {
		return parts[0]
	}
	return ""
}

// StrategyShellPage renders the full page shell with sidebar and navbar.
// Used for root-level pages (dashboard, settings).
templ StrategyShellPage(title string, currentPath string, sidebarGroups []layout.SidebarGroup) {
	@layout.Page(title, "nord") {
		@themeRestoreScript()
		@layout.AppShell("Emergent Strategy") {
			@layout.Sidebar("Emergent Strategy", sidebarGroups)
			<div class="flex min-w-0 grow overflow-hidden">
			<div class="flex min-w-0 grow flex-col overflow-hidden">
				@layout.Navbar("Emergent Strategy") {
					@layout.ThemeToggle("nord", "dark")
				}
				@systemWarningBanner()
				<main id="main-content" class="flex flex-col flex-1 min-w-0 overflow-hidden bg-base-200">
					<div class="flex flex-col flex-1 min-h-0 overflow-y-auto">
						{ children... }
					</div>
				</main>
			</div>
			</div>
		}
	}
}

// InstanceShellPage renders the full page shell for a strategy-scoped page.
// Includes tabs (Execution / READY / FIRE / AIM) below the strategy name.
templ InstanceShellPage(title string, currentPath string, sidebarGroups []layout.SidebarGroup, instanceName string, tabs []TabProps) {
	@layout.Page(title, "nord") {
		@themeRestoreScript()
		@layout.AppShell("Emergent Strategy") {
			@layout.Sidebar("Emergent Strategy", sidebarGroups)
			<div class="flex min-w-0 grow overflow-hidden">
			<div class="flex min-w-0 grow flex-col overflow-hidden">
				@layout.Navbar("Emergent Strategy") {
					@layout.ThemeToggle("nord", "dark")
				}
			@systemWarningBanner()
			<main id="main-content" class="flex flex-col flex-1 min-w-0 overflow-hidden bg-base-200">
				@InstanceChrome(instanceName, tabs, currentPath) {
					{ children... }
				}
			</main>
			</div>
			</div>
		}
	}
}

// InstanceChrome renders the instance breadcrumb + tab content area.
// Matches 21st-captable's companyChrome pattern exactly: the breadcrumb div
// and #tab-content are rendered as direct children of #main-content (no
// intermediate wrapper div), so Chrome's flex height chain is unbroken.
templ InstanceChrome(instanceName string, tabs []TabProps, currentPath string) {
	// Breadcrumb bar — "Strategies > Instance Name"
	<div class="bg-base-100 border-b border-base-200 px-6 py-3">
		<nav class="flex items-center gap-2 text-sm" aria-label="Breadcrumb">
			<a href="/strategies" class="text-base-content/80 hover:text-base-content transition-colors">{ langs.T(ctx, "nav.breadcrumb.strategies") }</a>
			<svg class="w-3 h-3 text-base-content/65" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
			<span class="font-bold text-base-content text-lg">
				if instanceName != "" {
					{ instanceName }
				} else {
					{ langs.T(ctx, "nav.breadcrumb.strategy_fallback") }
				}
			</span>
		</nav>
	</div>
	@instanceTabContent(tabs, currentPath) {
		{ children... }
	}
	@activityStreamSSE()
}

// activityStreamSSE wires the SSE activity stream to drive live UI indicators
// and the cascade tracker panel.
// Extracts instance ID from URL path and opens an EventSource to
// /strategies/:id/activity/stream. Handles skill.started, skill.chunk_staged,
// skill.completed, and skill.failed events.
//
// IMPORTANT: This script is re-executed on every HTMX sidebar navigation
// (Tier 2 swap into #main-content). To prevent zombie EventSource connections,
// runaway setInterval timers, and accumulated visibilitychange listeners from
// freezing the browser, all state is stored on window.__activitySSE and torn
// down before each re-initialization.
templ activityStreamSSE() {
	<script>
	(function() {
		// Extract instance ID from URL: /strategies/:id/...
		var m = window.location.pathname.match(/^\/strategies\/([0-9a-f-]{36})/);
		if (!m) return;
		var instanceId = m[1];

		// --- Tear down previous instance's resources ---
		// On HTMX Tier 2 swaps, the old <script> IIFE's closure is orphaned
		// but its EventSource, setInterval, and document listeners survive.
		// Clean them up before creating new ones.
		var prev = window.__activitySSE;
		if (prev) {
			if (prev.es) { prev.es.close(); prev.es = null; }
			if (prev.reconcileTimer) { clearInterval(prev.reconcileTimer); prev.reconcileTimer = null; }
			if (prev.visHandler) {
				document.removeEventListener('visibilitychange', prev.visHandler);
			}
		}

		// Skill name → affected artifact CSS IDs (for toggling generating badges).
		var skillArtifacts = {
			'adapt-strategy':     ['strategy_formula', 'roadmap_recipe'],
			'adapt-foundations':  ['north_star', 'strategy_foundations', 'insight_analyses', 'insight_opportunity'],
			'draft-north-star':   ['north_star'],
			'draft-insights':     ['insight_analyses'],
			'draft-foundations':  ['strategy_foundations'],
			'draft-opportunity':  ['insight_opportunity'],
			'draft-formula':      ['strategy_formula'],
			'draft-roadmap':      ['roadmap_recipe'],
			'align-portfolio':    ['strategy_formula', 'roadmap_recipe']
		};
		// Flat set of all artifact IDs that can have a generating badge.
		var allBadgeIds = [];
		for (var k in skillArtifacts) {
			skillArtifacts[k].forEach(function(id) {
				if (allBadgeIds.indexOf(id) === -1) allBadgeIds.push(id);
			});
		}

		// --- Singleton state on window ---
		var state = { es: null, reconcileTimer: null, errorCount: 0, visHandler: null };
		window.__activitySSE = state;

		var MAX_ERRORS = 5;        // close after 5 consecutive failures
		var RECONCILE_MS = 30000;  // 30s polling fallback

		// reconcileBadges checks the cascade endpoint and shows/hides generating
		// badges based on which skill runs are actually active right now.
		function reconcileBadges() {
			fetch('/strategies/' + instanceId + '/cascade')
				.then(function(r) { return r.text(); })
				.then(function(html) {
					var hasRunningRow = html.indexOf('animate-spin') !== -1 && html.indexOf('lucide--loader') !== -1;
					var activeIds = {};
					if (hasRunningRow) {
						for (var sk in skillArtifacts) {
							if (html.indexOf(sk) !== -1) {
								skillArtifacts[sk].forEach(function(id) { activeIds[id] = true; });
							}
						}
					}
					allBadgeIds.forEach(function(id) {
						var badge = document.getElementById('generating-' + id);
						if (!badge) return;
						if (activeIds[id]) {
							badge.classList.remove('hidden');
						} else {
							badge.classList.add('hidden');
						}
					});
				})
				.catch(function() { /* ignore network errors */ });
		}

		function onActivity(e) {
			try {
				var evt = JSON.parse(e.data);
				var payload = evt.payload || {};
				var skillName = payload.skill_name || '';
				var targets = skillArtifacts[skillName] || [];

				if (evt.event_type === 'skill.started') {
					targets.forEach(function(t) {
						var badge = document.getElementById('generating-' + t);
						if (badge) badge.classList.remove('hidden');
					});
				}
				if (evt.event_type === 'skill.completed' || evt.event_type === 'skill.failed') {
					targets.forEach(function(t) {
						var badge = document.getElementById('generating-' + t);
						if (badge) badge.classList.add('hidden');
					});
					if (evt.event_type === 'skill.completed' && payload.batch_id) {
						var banner = document.getElementById('pending-draft-banner');
						if (banner) {
							banner.classList.remove('hidden');
							var link = banner.querySelector('a');
							if (link) link.href = '/strategies/' + instanceId + '/aim/draft-review/' + payload.batch_id;
						}
					}
				}
			} catch(err) { /* ignore parse errors */ }
		}

		function connectSSE() {
			if (state.es) { state.es.close(); state.es = null; }
			state.errorCount = 0;

			state.es = new EventSource('/strategies/' + instanceId + '/activity/stream');
			state.es.addEventListener('activity', onActivity);

			state.es.onopen = function() {
				state.errorCount = 0;
			};

			state.es.onerror = function() {
				state.errorCount++;
				if (state.errorCount >= MAX_ERRORS) {
					state.es.close();
					state.es = null;
				}
			};
		}

		function disconnectSSE() {
			if (state.es) { state.es.close(); state.es = null; }
		}

		function startReconcile() {
			if (state.reconcileTimer) return;
			reconcileBadges();
			state.reconcileTimer = setInterval(reconcileBadges, RECONCILE_MS);
		}

		function stopReconcile() {
			if (state.reconcileTimer) { clearInterval(state.reconcileTimer); state.reconcileTimer = null; }
		}

		function teardown() {
			disconnectSSE();
			stopReconcile();
		}

		// --- Page visibility handling ---
		// Single named handler so we can remove it on teardown.
		state.visHandler = function() {
			if (document.hidden) {
				disconnectSSE();
				stopReconcile();
			} else {
				connectSSE();
				startReconcile();
			}
		};
		document.addEventListener('visibilitychange', state.visHandler);

		// --- Initial setup ---
		connectSSE();
		startReconcile();

		// Close on full page unload (refresh, hard navigation).
		window.addEventListener('beforeunload', teardown);
	})();
	</script>
}

// instanceTabContent renders the tab bar + content. This is also the fragment
// returned for HTMX tab/sub-nav swaps (swapped into #tab-content).
templ instanceTabContent(tabs []TabProps, currentPath string) {
	<div id="tab-content" class="flex flex-col flex-1 min-h-0">
		<div class="sticky top-0 z-10 border-b border-base-content/15 bg-base-100 px-6 shrink-0 flex items-end">
			<div class="flex-1">
				@StrategyTabs(tabs, currentPath)
			</div>
			@instanceSettingsMenu(instanceIDFromPath(currentPath))
		</div>
		<div class="overflow-x-auto overflow-y-auto flex-1 px-3 py-4 sm:px-6">
			{ children... }
		</div>
	</div>
}

// instanceSettingsMenu renders a right-aligned gear icon dropdown for instance-level
// stats, admin actions (move to workspace, delete). Shown to the right of the tab bar.
templ instanceSettingsMenu(instanceID string) {
	if instanceID == "" {
		return
	}
	{{ stats := InstanceStatsFromContext(ctx) }}
	<div class="relative flex items-center pb-1 shrink-0 ml-4">
		<button
			type="button"
			class="btn btn-ghost btn-xs gap-1.5 text-base-content/55 hover:text-base-content/80"
			title={ langs.T(ctx, "instance.settings_menu.title") }
			onclick="event.stopPropagation();var p=this.nextElementSibling;var wasHidden=p.classList.contains('hidden');document.querySelectorAll('.inst-settings-panel').forEach(function(el){el.classList.add('hidden')});if(wasHidden){p.classList.remove('hidden')}"
		>
			<span class="iconify lucide--settings-2 size-3.5"></span>
		</button>
		<!-- Dropdown panel — close on any outside click via document listener in script below -->
		<div
			class="inst-settings-panel hidden absolute right-0 top-full mt-1 z-50 w-64 rounded-lg border border-base-content/15 bg-base-100 shadow-lg"
		>
			<!-- Stats section -->
			<div class="px-3 pt-3 pb-2 space-y-2">
				<!-- Stat grid: artifacts / features / versions / AIM cycles -->
				<div class="grid grid-cols-4 gap-1">
					@instanceStatCell(strconv.Itoa(stats.ArtifactCount), "Artifacts", "")
					@instanceStatCell(strconv.Itoa(stats.FeatureCount), "Features", "")
					@instanceStatCell(strconv.Itoa(stats.VersionCount), "Versions", "")
					@instanceStatCell(strconv.Itoa(stats.AIMCycles), "AIM cycles", "")
				</div>
				<!-- Coherence + signals row -->
				if stats.CoherenceScore != "" || stats.CriticalSignals > 0 || stats.WarningSignals > 0 {
					<div class="flex items-center gap-3 pt-1">
						if stats.CoherenceScore != "" {
							<div class="flex items-center gap-1">
								<span class="iconify lucide--activity size-3 text-base-content/55"></span>
								<span class={ "text-xs font-mono font-medium " + instanceCoherenceColor(stats.CoherenceScore) }>{ stats.CoherenceScore }</span>
								<span class="text-xs text-base-content/55">coherence</span>
							</div>
						}
						if stats.CriticalSignals > 0 {
							<div class="flex items-center gap-1">
								<span class="iconify lucide--alert-circle size-3 text-error"></span>
								<span class="text-xs text-error font-medium">{ strconv.FormatInt(stats.CriticalSignals, 10) }</span>
							</div>
						}
						if stats.WarningSignals > 0 {
							<div class="flex items-center gap-1">
								<span class="iconify lucide--alert-triangle size-3 text-warning"></span>
								<span class="text-xs text-warning font-medium">{ strconv.FormatInt(stats.WarningSignals, 10) }</span>
							</div>
						}
					</div>
				}
				<!-- GitHub info -->
				if stats.GithubRepo != "" {
					<div class="flex items-center gap-1.5 pt-0.5">
						<span class="iconify lucide--github size-3 text-base-content/55 shrink-0"></span>
						<span class="text-xs text-base-content/65 font-mono truncate">{ stats.GithubRepo }</span>
						if stats.CommitSHA != "" {
							<span class="text-xs text-base-content/30 font-mono shrink-0">{ stats.CommitSHA }</span>
						}
					</div>
				}
				<!-- Last version + status -->
				<div class="flex items-center justify-between pt-0.5">
					if stats.LastVersionAt != "" {
						<span class="text-xs text-base-content/55">v{ strconv.Itoa(stats.VersionCount) } · { stats.LastVersionAt }</span>
					}
					<span class={ "badge badge-xs " + instanceStatusBadge(stats.Status) }>{ stats.Status }</span>
				</div>
			</div>
			<!-- Sync status section -->
			if stats.GithubRepo != "" {
				<div class="border-t border-base-content/15 mx-3 my-2"></div>
				<div class="px-3 pb-2 space-y-1.5">
					<!-- Sync state badge + SHA comparison -->
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-1.5">
							<span class="iconify lucide--git-branch size-3 text-base-content/55"></span>
							<span class="text-xs text-base-content/65">
								if stats.GithubBranch != "" {
									{ stats.GithubBranch }
								} else {
									main
								}
							</span>
						</div>
						@syncStateBadge(stats.SyncState)
					</div>
					<!-- SHA comparison: local → remote -->
					if stats.CommitSHA != "" || stats.RemoteSHA != "" {
						<div class="flex items-center gap-1.5 font-mono text-xs text-base-content/55">
							if stats.CommitSHA != "" {
								<span title="Local (last synced)">{ stats.CommitSHA }</span>
							}
							if stats.CommitSHA != "" && stats.RemoteSHA != "" && stats.CommitSHA != stats.RemoteSHA {
								<span class="iconify lucide--arrow-right size-3"></span>
								<span class="text-info" title="Remote HEAD">{ stats.RemoteSHA }</span>
							} else if stats.RemoteSHA != "" && stats.CommitSHA == "" {
								<span title="Remote HEAD">{ stats.RemoteSHA }</span>
							}
						</div>
					}
					<!-- Pending local changes -->
					if stats.PendingBatchCount > 0 {
						<div class="flex items-center gap-1.5">
							<span class="iconify lucide--layers size-3 text-warning"></span>
							<span class="text-xs text-warning">{ strconv.Itoa(stats.PendingBatchCount) } staged change(s) not pushed</span>
						</div>
					}
					<!-- Last sync -->
					if stats.LastSyncAt != "" {
						<div class="flex items-center gap-1.5">
							<span class="iconify lucide--clock size-3 text-base-content/30"></span>
							<span class="text-xs text-base-content/55">
								if stats.LastSyncDirection == "import" {
									Imported { strconv.Itoa(stats.LastSyncArtifacts) } artifacts · { stats.LastSyncAt }
								} else if stats.LastSyncDirection == "export" {
									Pushed { strconv.Itoa(stats.LastSyncArtifacts) } artifacts · { stats.LastSyncAt }
								} else {
									Last sync · { stats.LastSyncAt }
								}
							</span>
							if stats.LastSyncPRURL != "" {
								<a href={ templ.SafeURL(stats.LastSyncPRURL) } target="_blank" rel="noopener"
									class="iconify lucide--external-link size-3 text-primary hover:text-primary/80 shrink-0"
									onclick="event.stopPropagation()"
									title="View PR"></a>
							}
						</div>
					}
				</div>
			}
			<!-- Divider + actions -->
			<div class="border-t border-base-content/15"></div>
			<div class="py-1">
				<!-- Move to workspace — links to settings where the move UI lives -->
				<a
					href="/settings"
					class="flex items-center gap-2.5 px-3 py-2 text-sm text-base-content/80 hover:bg-base-200 hover:text-base-content transition-colors"
				>
					<span class="iconify lucide--folder-symlink size-3.5 shrink-0"></span>
					{ langs.T(ctx, "instance.settings_menu.move") }
				</a>
				<!-- Delete instance -->
				<form
					method="POST"
					action={ templ.SafeURL("/strategies/" + instanceID + "/delete") }
					onclick="event.stopPropagation()"
				>
					<button
						type="submit"
						class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-error/70 hover:bg-error/5 hover:text-error transition-colors"
						onclick="return confirm('Delete this instance? This cannot be undone.')"
					>
						<span class="iconify lucide--trash-2 size-3.5 shrink-0"></span>
						{ langs.T(ctx, "instance.settings_menu.delete") }
					</button>
				</form>
			</div>
		</div>
	</div>
	<script>
		document.addEventListener('click', function() {
			document.querySelectorAll('.inst-settings-panel').forEach(function(el) {
				el.classList.add('hidden');
			});
		}, { once: false, capture: false });
	</script>
}

// syncStateBadge renders a compact badge for a sync state string.
templ syncStateBadge(state string) {
	switch state {
	case "in_sync":
		<span class="inline-flex items-center gap-1 badge badge-xs badge-success">
			<span class="iconify lucide--check size-2.5"></span>
			In sync
		</span>
	case "github_ahead":
		<span class="inline-flex items-center gap-1 badge badge-xs badge-warning">
			<span class="iconify lucide--download size-2.5"></span>
			Behind
		</span>
	case "server_ahead":
		<span class="inline-flex items-center gap-1 badge badge-xs badge-info">
			<span class="iconify lucide--upload size-2.5"></span>
			Ahead
		</span>
	case "diverged":
		<span class="inline-flex items-center gap-1 badge badge-xs badge-error">
			<span class="iconify lucide--git-merge size-2.5"></span>
			Diverged
		</span>
	case "unlinked":
		<span class="badge badge-xs badge-ghost">Not linked</span>
	default:
		// Empty string = sync state not loaded (no App, or no repo)
	}
}

// instanceStatCell renders a single stat number + label in the stats grid.
templ instanceStatCell(value, label, colorClass string) {
	<div class="flex flex-col items-center gap-0.5 bg-base-content/8 border border-base-content/10 rounded px-1 py-1.5">
		if colorClass != "" {
			<span class={ "text-sm font-bold tabular-nums", colorClass }>{ value }</span>
		} else {
			<span class="text-sm font-bold tabular-nums text-base-content">{ value }</span>
		}
		<span class="text-xs text-base-content/55 leading-tight text-center">{ label }</span>
	</div>
}

// instanceStatusBadge returns the badge class for an instance status.
func instanceStatusBadge(status string) string {
	switch status {
	case "active":
		return "badge-success"
	case "draft":
		return "badge-ghost"
	case "archived":
		return "badge-neutral"
	default:
		return "badge-ghost"
	}
}

// InstanceTabContent renders the tab bar + content for HTMX swaps.
// This is the second-to-content tier in RenderTriple: when HTMX targets
// #tab-content, this re-renders the tab bar with correct active state.
templ InstanceTabContent(tabs []TabProps, currentPath string, content templ.Component) {
	@instanceTabContent(tabs, currentPath) {
		@content
	}
}

// TabProps describes a single tab.
type TabProps struct {
	Label    string
	Icon     string
	URL      string
	IsActive bool
}

// StrategyTabs renders the Execution / READY / FIRE / AIM horizontal tab bar.
templ StrategyTabs(tabs []TabProps, currentPath string) {
	<div role="tablist" class="flex gap-1">
		for _, tab := range tabs {
			<a
				role="tab"
				href={ templ.URL(tab.URL) }
				hx-get={ tab.URL }
				hx-target="#tab-content"
				hx-swap="innerHTML"
				hx-push-url="true"
				class={ "tab tab-bordered pb-3 px-4 gap-2 text-sm font-medium",
					templ.KV("tab-active", tab.IsActive) }
			>
				if tab.Icon != "" {
					<span class={ "iconify size-4 " + tab.Icon }></span>
				}
				{ tab.Label }
			</a>
		}
	</div>
}

// --- Sub-navigation components (rendered by page content templates) ---

// TabSubNavItem describes a single sub-navigation link within a tab.
type TabSubNavItem struct {
	Label  string
	Icon   string
	Href   string
	Active bool
}

// navGraph is the singleton navigation graph used for sub-nav and breadcrumb generation.
var navGraph = strategynav.DefaultGraph()

// tabSubNavItems returns sub-navigation items for a tab's child pages.
// ctx is used to resolve screen title lang keys via langs.T.
func tabSubNavItems(ctx context.Context, tabGroup strategynav.TabGroup, instanceID, currentPath string) []TabSubNavItem {
	screens := navGraph.TabSubNavScreens(tabGroup)
	if len(screens) == 0 {
		return nil
	}
	items := make([]TabSubNavItem, 0, len(screens))
	for _, s := range screens {
		href := "/strategies/" + instanceID + s.URLPattern
		icon := s.Icon
		if icon == "" {
			icon = "lucide--circle"
		}
		items = append(items, TabSubNavItem{
			Label:  langs.T(ctx, s.Title),
			Icon:   icon,
			Href:   href,
			Active: currentPath == href,
		})
	}
	return items
}

// TabRelatedPages renders the sub-nav on a tab landing page.
// The landing item is shown first (highlighted), followed by related sub-pages.
templ TabRelatedPages(tabGroup string, instanceID string, currentPath string) {
	{{ tab := strategynav.TabGroup(tabGroup) }}
	{{ items := tabSubNavItems(ctx, tab, instanceID, currentPath) }}
	if len(items) > 0 {
		{{ meta := strategynav.TabDisplay(tab) }}
		<div class="flex flex-wrap items-center gap-1 mb-4 text-sm">
			{{ landingHref := "/strategies/" + instanceID + meta.LandingURL }}
			<a
				href={ templ.SafeURL(landingHref) }
				hx-get={ string(templ.SafeURL(landingHref)) }
				hx-target="#tab-content"
				hx-swap="innerHTML"
				hx-push-url="true"
				class={ "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-colors",
					templ.KV("bg-primary/10 text-primary font-medium", currentPath == landingHref),
					templ.KV("text-base-content/75 hover:text-base-content hover:bg-base-200", currentPath != landingHref) }
			>
				<span class={ "iconify size-3.5 " + meta.Icon }></span>
				{ meta.Label }
			</a>
			<span class="text-base-content/20">|</span>
			for _, item := range items {
				<a
					href={ templ.SafeURL(item.Href) }
					hx-get={ string(templ.SafeURL(item.Href)) }
					hx-target="#tab-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					class={ "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg transition-colors",
						templ.KV("bg-primary/10 text-primary font-medium", item.Active),
						templ.KV("text-base-content/75 hover:text-base-content hover:bg-base-200", !item.Active) }
				>
					<span class={ "iconify size-3.5 " + item.Icon }></span>
					{ item.Label }
				</a>
			}
		</div>
	}
}

// TabBackLink renders the sub-nav on a sub-page within a tab.
// The current page is highlighted in the sub-nav bar.
templ TabBackLink(tabGroup string, instanceID string, currentPath string) {
	@TabRelatedPages(tabGroup, instanceID, currentPath)
}

// --- Page Header (breadcrumbs from graph) ---

// graphCrumbs builds breadcrumb steps for a screen from the navigation graph.
// For instance-scoped screens, steps above the current tab landing are removed
// since the chrome already shows the instance name and tab bar.
// ctx is required to resolve screen title lang keys.
func graphCrumbs(ctx context.Context, screenID string, instanceID string, instanceName string) []nav.BreadcrumbStep {
	chain := navGraph.BreadcrumbChain(strategynav.ScreenID(screenID), instanceID)

	// Skip entries up to and including ExecutionDashboard (the instance landing).
	// The chrome already shows instance name + tab bar.
	cutIdx := -1
	for i, entry := range chain {
		if entry.ScreenID == strategynav.GlobalDashboard || entry.ScreenID == strategynav.ExecutionDashboard {
			cutIdx = i
		}
	}
	if cutIdx >= 0 && cutIdx+1 < len(chain) {
		chain = chain[cutIdx+1:]
	} else if cutIdx >= 0 {
		return nil
	}

	steps := make([]nav.BreadcrumbStep, 0, len(chain))
	for _, entry := range chain {
		steps = append(steps, nav.BreadcrumbStep{
			Label: langs.T(ctx, entry.Label),
			URL:   entry.Href,
		})
	}
	return steps
}

// --- Shared nav context ---

// NavContext is embedded in every bespoke artifact data struct so templates can
// render their own TabBackLink sub-nav, matching the 21st-captable pattern
// where each content template owns its sub-nav.
type NavContext struct {
	InstanceID  string
	CurrentPath string
	ScreenID    string // navigation screen ID for graphCrumbs
	TabGroup    string // "ready", "fire", or "aim"
}

// --- Screen ID constants (for use in templ templates) ---

const (
	ScreenActivityOverview   = string(strategynav.ActivityOverview)
	ScreenSkillRuns          = string(strategynav.SkillRuns)
	ScreenSkillRunDetail     = string(strategynav.SkillRunDetail)
	ScreenReadyOverview      = string(strategynav.ReadyOverview)
	ScreenNorthStar          = string(strategynav.NorthStar)
	ScreenInsightAnalyses    = string(strategynav.InsightAnalyses)
	ScreenFoundations        = string(strategynav.StrategyFoundation)
	ScreenOpportunity        = string(strategynav.InsightOpportunity)
	ScreenFormula            = string(strategynav.StrategyFormula)
	ScreenRoadmap            = string(strategynav.RoadmapRecipe)
	ScreenPortfolio          = string(strategynav.ProductPortfolio)
	ScreenFireOverview       = string(strategynav.FireOverview)
	ScreenStrategyTrack      = string(strategynav.StrategyTrack)
	ScreenOrgOpsTrack        = string(strategynav.OrgOpsTrack)
	ScreenProductTrack       = string(strategynav.ProductTrack)
	ScreenCommercialTrack    = string(strategynav.CommercialTrack)
	ScreenFeatureDetail      = string(strategynav.FeatureDetail)
	ScreenValueModelDetail   = string(strategynav.ValueModelDetail)
	ScreenDefinitionDetail   = string(strategynav.DefinitionDetail)
	ScreenAimOverview        = string(strategynav.AimOverview)
	ScreenLRA                = string(strategynav.LRA)
	ScreenAssessment         = string(strategynav.AssessmentReport)
	ScreenAssumptions        = string(strategynav.Assumptions)
	ScreenCalibration        = string(strategynav.Calibration)
	ScreenCoherence          = string(strategynav.Coherence)
)

// PhaseRenderData bundles a phase title with its rendered content.
type PhaseRenderData struct {
	Title   string
	Content templ.Component
}

// InstancePhaseFullPage renders the full page shell with instance chrome and content.
// Tier 1 of RenderTriple: full page for direct browser loads.
templ InstancePhaseFullPage(title string, currentPath string, sidebarGroups []layout.SidebarGroup, instanceName string, tabs []TabProps, content templ.Component) {
	@InstanceShellPage(title, currentPath, sidebarGroups, instanceName, tabs) {
		@content
	}
}

// InstanceChromeWithContent renders the instance chrome with content pre-filled.
// Tier 2 of RenderTriple: sidebar navigation swaps into #main-content.
templ InstanceChromeWithContent(instanceName string, tabs []TabProps, currentPath string, content templ.Component) {
	@InstanceChrome(instanceName, tabs, currentPath) {
		@content
	}
}

// systemWarningBanner renders a persistent warning when critical subsystems
// (Memory) are not configured. Shown below the navbar on every page.
templ systemWarningBanner() {
	if !GetSystemConfig().MemoryConfigured {
		<div class="bg-warning/10 border-b border-warning/25 px-4 py-2 flex items-center gap-2 text-sm shrink-0">
			<span class="iconify lucide--alert-triangle size-4 text-warning shrink-0"></span>
			<span class="text-warning-content/80">
				<strong>{ langs.T(ctx, "warning.memory_not_configured.title") }</strong>{ langs.T(ctx, "warning.memory_not_configured.body") }
			</span>
			<a
				href="/settings"
				class="ml-auto text-xs font-medium text-warning-content/60 hover:text-warning-content underline"
			>{ langs.T(ctx, "nav.screen.settings") }</a>
		</div>
	}
}

// themeRestoreScript restores the saved theme from localStorage on page load.
templ themeRestoreScript() {
	<script>
		(function() {
			try {
				var saved = localStorage.getItem('go-daisy-theme');
				if (saved) {
					document.documentElement.setAttribute('data-theme', saved);
					if (saved === 'dark') {
						var sun = document.getElementById('theme-icon-sun');
						var moon = document.getElementById('theme-icon-moon');
						if (sun) sun.style.display = 'none';
						if (moon) moon.style.display = '';
					}
				}
			} catch(e) {}
		})();
	</script>
}
