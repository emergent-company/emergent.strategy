package ui

import (
	"strconv"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
)

// ExecutionData holds all data for the execution dashboard.
type ExecutionData struct {
	InstanceID   string
	InstanceName string
	Timeframe    string // e.g. "Q2 2026 – Q4 2026"
	Cycle        string // e.g. "Cycle 2"
	Status       string // roadmap status

	// Track OKR groups — each track has OKRs → KRs → Features
	Tracks []ExecutionTrack

	// Summary stats
	TotalOKRs      int
	TotalKRs       int
	ActiveFeatures int
	DraftFeatures  int
	Assumptions    int

	// Signal severity breakdown
	ActiveSignals   int
	CriticalSignals int
	WarningSignals  int

	// AIM data presence
	HasAssessmentData bool
	StrategicInsights []string // from latest assessment report

	// Strategy loop widget
	LoopCycleRunning bool
	LoopCycleStep    string // current step name (empty if not running)
	LoopPendingCount int    // pending review batches
	LoopLastVersion      string // "2 Jan 15:04" or ""
	LoopLastVersionID    string // version UUID for link target
	LoopLastVersionLabel string // version label, e.g. "Q2 Strategy" or ""
	LoopLastVersionDesc  string // version description for tooltip, e.g. "AIM cycle 2 completed with decision: pivot."

	// Strategic focus — north star and bets for at-a-glance context
	NorthStarVision   string             // truncated vision statement
	NorthStarMission  string             // truncated mission statement
	StrategicBets     []StrategicBetInfo  // current bets from strategy formula
	CoherenceScore    string             // e.g. "0.82" or ""
	EvidenceCount     int                // total evidence items
	UntestedCount     int                // assumptions with no testing feature
	AIMCycleCount     int                // completed AIM cycles
	VersionCount      int                // published versions
}

// ExecutionTrack represents one track's OKR execution data.
type ExecutionTrack struct {
	Name        string // e.g. "Product"
	Icon        string // lucide icon
	Objective   string // top-level track objective (from roadmap)
	OKRs        []ExecutionOKR
	Definitions []ExecutionDefinition // prioritized definitions for this track
}

// ExecutionDefinition is a track definition being built/operationalized this cycle.
type ExecutionDefinition struct {
	Name        string // display name
	CurrentTier int    // 1, 2, or 3
	Status      string // ready, draft, in-progress
	Href        string // link to the definition detail
}

// ExecutionOKR represents a single OKR with its key results.
type ExecutionOKR struct {
	ID        string
	Objective string
	KRs       []ExecutionKR
}

// ExecutionKR represents a single key result with linked features and AIM data.
type ExecutionKR struct {
	ID          string
	Description string
	Target      string
	Baseline    string
	TRLStart    string
	TRLTarget   string

	// Linked features
	Features []ExecutionFeature

	// Assumption bets
	Assumptions []ExecutionAssumption

	// AIM tracking — from latest assessment report
	AssessmentStatus string // met, missed, partial_met, exceeded — empty if no data
	AssessmentActual string // actual value achieved
}

// ExecutionFeature is a feature linked to a KR.
type ExecutionFeature struct {
	Key    string
	Name   string
	Status string
	Href   string
}

// ExecutionAssumption is an assumption being tested, with confidence.
type ExecutionAssumption struct {
	ID          string
	Description string
	Confidence  string // high, medium, low
	Criticality string // high, medium, low
}

// StrategicBetInfo is a strategic bet from the strategy formula.
type StrategicBetInfo struct {
	Name       string // bet name/title
	Hypothesis string // what we believe
	Track      string // which track (product, commercial, etc.)
}

// ExecutionDashboardContent renders the execution-focused strategy dashboard.
templ ExecutionDashboardContent(data ExecutionData) {
	@TabRelatedPages("execution", data.InstanceID, "/strategies/" + data.InstanceID)
	<div class="space-y-6">
		// ── Strategic focus ─────────────────────────────────────────────────
		@strategicFocusSection(data)

		// ── Header ──────────────────────────────────────────────────────────
		@executionHeader(data)

		// ── Strategy loop widget ────────────────────────────────────────────
		if data.LoopCycleRunning || data.LoopPendingCount > 0 || data.LoopLastVersion != "" {
			@strategyLoopWidget(data)
		}

		// ── Track cards ─────────────────────────────────────────────────────
		for _, track := range data.Tracks {
			if len(track.OKRs) > 0 {
				@executionTrackCard(track, data.InstanceID, data.HasAssessmentData)
			}
		}

		// ── Strategic insights from AIM ──────────────────────────────────────
		if len(data.StrategicInsights) > 0 {
			@executionInsightsStrip(data.StrategicInsights)
		}
	</div>
}

// ── Header ────────────────────────────────────────────────────────────────────

templ executionHeader(data ExecutionData) {
	<div class="rounded-xl border border-base-content/10 bg-base-100 px-5 py-4 flex flex-col gap-3 shadow-sm">
		<div class="flex items-start justify-between gap-4">
			<div>
				<div class="flex items-center gap-2 mb-1">
					<span class="iconify lucide--zap size-4 text-primary"></span>
					<span class="text-xs font-semibold uppercase tracking-widest text-primary">Execution</span>
					if data.Cycle != "" {
						<span class="badge badge-xs badge-ghost font-mono">{ data.Cycle }</span>
					}
				</div>
				if data.Timeframe != "" {
					<p class="text-lg font-bold text-base-content">{ data.Timeframe }</p>
				}
				<p class="text-xs text-base-content/50 mt-0.5">
					<span class="font-semibold text-base-content">{ strconv.Itoa(data.TotalOKRs) }</span> objectives
					<span class="mx-1 text-base-content/20">·</span>
					<span class="font-semibold text-base-content">{ strconv.Itoa(data.TotalKRs) }</span> key results
					<span class="mx-1 text-base-content/20">·</span>
					<span class="font-semibold text-base-content">{ strconv.Itoa(data.ActiveFeatures + data.DraftFeatures) }</span> features
					if data.HasAssessmentData {
						<span class="mx-1 text-base-content/20">·</span>
						<span class="text-success font-semibold">AIM tracked</span>
					}
				</p>
			</div>
			// Signal pills
			if data.ActiveSignals > 0 {
				<div class="flex items-center gap-2 shrink-0">
					if data.CriticalSignals > 0 {
					<span class="tooltip" data-tip="Coherence signals requiring immediate attention">
							<div class="flex items-center gap-1 rounded-lg bg-error/10 px-2.5 py-1.5 text-xs font-semibold text-error">
								<span class="iconify lucide--alert-circle size-3.5"></span>
								{ strconv.Itoa(data.CriticalSignals) } critical
							</div>
						</span>
					}
					if data.WarningSignals > 0 {
					<span class="tooltip" data-tip="Coherence signals to monitor">
							<div class="flex items-center gap-1 rounded-lg bg-warning/10 px-2.5 py-1.5 text-xs font-semibold text-warning-content">
								<span class="iconify lucide--alert-triangle size-3.5 text-warning"></span>
								{ strconv.Itoa(data.WarningSignals) } warnings
							</div>
						</span>
					}
				</div>
			}
		</div>
	</div>
}

// ── Track card ────────────────────────────────────────────────────────────────

templ executionTrackCard(track ExecutionTrack, instanceID string, hasAIM bool) {
	<div class={ "rounded-xl border bg-base-100 shadow-sm overflow-hidden", trackBorderColor(track.Name) }>
		// Track header
		<div class={ "flex items-center gap-3 px-5 py-3 border-b", trackBorderColor(track.Name), trackGradientBg(track.Name), "bg-gradient-to-r to-transparent" }>
			<span class={ "iconify size-4 shrink-0", trackIcon(track.Name), textColor(trackColor(track.Name)) }></span>
			<h3 class="text-sm font-bold text-base-content uppercase tracking-widest grow">{ formatTrackName(track.Name) }</h3>
			<span class="badge badge-xs badge-ghost">{ strconv.Itoa(len(track.OKRs)) } objectives · { executionTrackKRCount(track) } KRs</span>
		</div>

		// Definitions strip — what we are building/operationalizing to reach the OKRs
		if len(track.Definitions) > 0 {
			<div class="flex flex-wrap gap-2 px-5 py-3 border-b border-base-content/5 bg-base-200/30">
				<span class="text-xs text-base-content/40 font-medium self-center mr-1">{ langs.T(ctx, "ui.fire.track.definitions") }</span>
				for _, def := range track.Definitions {
					@execDefinitionChip(def)
				}
			</div>
		}

		// OKRs
		<div class="divide-y divide-base-content/5">
			for _, okr := range track.OKRs {
				@executionOKRSection(okr, track.Name, instanceID, hasAIM)
			}
		</div>
	</div>
}

templ execDefinitionChip(def ExecutionDefinition) {
	<a
		href={ templ.URL(def.Href) }
		hx-get={ def.Href }
		hx-target="#tab-content"
		hx-swap="innerHTML"
		hx-push-url="true"
		class="inline-flex items-center gap-1.5 rounded-md border border-base-content/10 bg-base-100 px-2 py-0.5 text-xs text-base-content/70 hover:border-primary/30 hover:bg-primary/5 transition-colors"
	>
		@execDefinitionChipPrefix(def)
		{ def.Name }
	</a>
}

templ execDefinitionChipPrefix(def ExecutionDefinition) {
	switch def.Status {
	case "in-progress":
		<span class="size-1.5 rounded-full bg-primary shrink-0"></span>
	case "draft":
		<span class="size-1.5 rounded-full bg-warning shrink-0"></span>
	case "delivered":
		<span class="size-1.5 rounded-full bg-success shrink-0"></span>
	default:
		if def.CurrentTier > 0 {
			<span class="font-mono text-base-content/30">T{ strconv.Itoa(def.CurrentTier) }</span>
		}
	}
}

func executionTrackKRCount(track ExecutionTrack) string {
	n := 0
	for _, o := range track.OKRs {
		n += len(o.KRs)
	}
	return strconv.Itoa(n)
}

templ executionOKRSection(okr ExecutionOKR, trackName string, instanceID string, hasAIM bool) {
	<div class="px-5 py-4 space-y-3">
		// Objective row
		<div class="flex items-start gap-2">
			<span class="tooltip" data-tip="Objective identifier">
				<span class="badge badge-xs badge-ghost font-mono shrink-0 mt-0.5">{ okr.ID }</span>
			</span>
			<p class="text-sm font-semibold text-base-content leading-snug">{ okr.Objective }</p>
		</div>
		// KR list
		if len(okr.KRs) > 0 {
			<div class="space-y-2 ml-1 pl-3 border-l-2 border-base-content/10">
				for _, kr := range okr.KRs {
					@executionKRRow(kr, trackName, instanceID, hasAIM)
				}
			</div>
		}
	</div>
}

templ executionKRRow(kr ExecutionKR, trackName string, instanceID string, hasAIM bool) {
	<div class="rounded-lg bg-base-200/40 px-3 py-2.5">
		<div class="flex items-start gap-2">
			<span class="tooltip" data-tip="Key Result identifier">
				<span class="badge badge-xs badge-ghost font-mono shrink-0 mt-0.5">{ kr.ID }</span>
			</span>
			<div class="min-w-0 grow space-y-1.5">

				// Description + AIM outcome on same row
				<div class="flex items-start justify-between gap-3">
					<p class="text-sm text-base-content leading-snug">{ kr.Description }</p>
					if kr.AssessmentStatus != "" {
						@execKROutcomeBadge(kr.AssessmentStatus)
					}
				</div>

				// Baseline → Target progression
				if kr.Baseline != "" || kr.Target != "" {
					<div class="flex items-center gap-1.5 text-xs text-base-content/60">
						if kr.Baseline != "" {
							<span class="font-mono">{ kr.Baseline }</span>
						}
						if kr.Baseline != "" && kr.Target != "" {
							<span class="iconify lucide--arrow-right size-3 text-base-content/40"></span>
						}
						if kr.Target != "" {
							<span class={ "font-mono font-medium", textColorSafe(trackColor(trackName)) }>{ kr.Target }</span>
						}
						// If we have actual, show it too
						if kr.AssessmentActual != "" {
							<span class="text-base-content/30 mx-0.5">|</span>
							<span class="iconify lucide--check-circle-2 size-3 text-success"></span>
							<span class="font-mono text-success font-medium">{ kr.AssessmentActual }</span>
						}
					</div>
				}

				// TRL progression
				if kr.TRLStart != "" || kr.TRLTarget != "" {
					<div class="flex items-center gap-1.5 text-xs">
						<span class="iconify lucide--flask-conical size-3 text-base-content/40"></span>
						if kr.TRLStart != "" {
							<span class="tooltip" data-tip="Technology Readiness Level">
								<span class="badge badge-xs badge-ghost">TRL { kr.TRLStart }</span>
							</span>
						}
						if kr.TRLStart != "" && kr.TRLTarget != "" {
							<span class="iconify lucide--arrow-right size-3 text-base-content/40"></span>
						}
						if kr.TRLTarget != "" {
							<span class="tooltip" data-tip="Technology Readiness Level">
								<span class={ "badge badge-xs", trackBadgeColor(trackName) }>TRL { kr.TRLTarget }</span>
							</span>
						}
					</div>
				}

				// Feature chips
				if len(kr.Features) > 0 {
					<div class="flex flex-wrap gap-1.5">
						for _, f := range kr.Features {
							<a
								href={ templ.URL(f.Href) }
								hx-get={ f.Href }
								hx-target="#tab-content"
								hx-swap="innerHTML"
								hx-push-url="true"
								class="inline-flex items-center gap-1.5 rounded-md border border-base-content/10 bg-base-100 px-2 py-0.5 text-xs hover:border-primary/30 hover:bg-primary/5 transition-colors"
							>
								@execFeatureStatusDot(f.Status)
								<span class="text-base-content/80">{ f.Name }</span>
							</a>
						}
					</div>
				}

				// Assumption bets (only if no features — keep rows tight)
				if len(kr.Assumptions) > 0 && len(kr.Features) == 0 {
					<div class="flex flex-wrap gap-1.5">
						for _, a := range kr.Assumptions {
							<span class="inline-flex items-center gap-1 rounded-md border border-base-content/10 bg-base-100/60 px-2 py-0.5 text-xs text-base-content/60">
								<span class={ "size-1.5 rounded-full shrink-0", criticalityDot(a.Criticality) }></span>
								{ a.ID }
								<span class="text-base-content/30">{ a.Confidence }</span>
							</span>
						}
					</div>
				}
			</div>
		</div>
	</div>
}

// execKROutcomeBadge renders an AIM outcome badge for a KR.
templ execKROutcomeBadge(status string) {
	switch status {
	case "exceeded":
		<span class="tooltip shrink-0" data-tip="Key Result exceeded its target">
			<span class="badge badge-xs badge-success gap-1">
				<span class="iconify lucide--trending-up size-3"></span>
				Exceeded
			</span>
		</span>
	case "met":
		<span class="tooltip shrink-0" data-tip="Key Result met its target">
			<span class="badge badge-xs badge-success gap-1">
				<span class="iconify lucide--check size-3"></span>
				Met
			</span>
		</span>
	case "partial_met", "partial":
		<span class="tooltip shrink-0" data-tip="Key Result partially met its target">
			<span class="badge badge-xs badge-warning gap-1">
				<span class="iconify lucide--minus size-3"></span>
				Partial
			</span>
		</span>
	case "missed":
		<span class="tooltip shrink-0" data-tip="Key Result missed its target">
			<span class="badge badge-xs badge-error gap-1">
				<span class="iconify lucide--x size-3"></span>
				Missed
			</span>
		</span>
	default:
		<!-- no badge -->
	}
}

templ execFeatureStatusDot(status string) {
	switch status {
		case "delivered":
			<span class="size-1.5 rounded-full bg-success shrink-0"></span>
		case "in-progress":
			<span class="size-1.5 rounded-full bg-primary shrink-0"></span>
		case "draft":
			<span class="size-1.5 rounded-full bg-warning shrink-0"></span>
		default:
			<span class="size-1.5 rounded-full bg-base-content/20 shrink-0"></span>
	}
}

// ── Insights strip ────────────────────────────────────────────────────────────

templ executionInsightsStrip(insights []string) {
	<div class="rounded-xl border border-info/20 bg-info/5 px-5 py-4">
		<div class="flex items-center gap-2 mb-3">
			<span class="iconify lucide--lightbulb size-4 text-info"></span>
			<span class="text-xs font-semibold uppercase tracking-widest text-info">Strategic Insights from AIM</span>
		</div>
		<ul class="space-y-1.5">
			for _, insight := range insights {
				<li class="flex items-start gap-2 text-sm text-base-content/80">
					<span class="iconify lucide--chevron-right size-3.5 text-info/60 mt-0.5 shrink-0"></span>
					{ insight }
				</li>
			}
		</ul>
	</div>
}

// strategicFocusSection renders the north star, strategic bets, and health summary
// at the top of the execution dashboard for quick strategic orientation.
templ strategicFocusSection(data ExecutionData) {
	if data.NorthStarVision == "" && len(data.StrategicBets) == 0 && data.CoherenceScore == "" {
		// No strategic data yet — skip section entirely
	} else {
		<div class="rounded-xl border border-base-content/10 bg-base-100 shadow-sm overflow-hidden">
			// ── North star banner ──
			if data.NorthStarVision != "" || data.NorthStarMission != "" {
				<div class="px-5 py-4 bg-gradient-to-r from-primary/5 to-transparent border-b border-base-content/5">
					<div class="flex items-start gap-3">
						<div class="rounded-lg bg-primary/10 p-1.5 shrink-0 mt-0.5">
							<span class="iconify lucide--star size-4 text-primary"></span>
						</div>
						<div class="min-w-0 space-y-1">
							if data.NorthStarVision != "" {
								<p class="text-sm font-medium text-base-content leading-snug">{ data.NorthStarVision }</p>
							}
							if data.NorthStarMission != "" {
								<p class="text-xs text-base-content/50 leading-relaxed">{ data.NorthStarMission }</p>
							}
						</div>
					</div>
				</div>
			}

			// ── Strategic bets + health indicators ──
			<div class="px-5 py-4">
				<div class="flex flex-col lg:flex-row gap-5">
					// Left: strategic bets
					if len(data.StrategicBets) > 0 {
						<div class="grow min-w-0">
							<div class="flex items-center gap-2 mb-2.5">
								<span class="iconify lucide--target size-3.5 text-base-content/40"></span>
								<span class="text-xs font-semibold uppercase tracking-widest text-base-content/40">Strategic Bets</span>
							</div>
							<div class="flex flex-wrap gap-2">
								for _, bet := range data.StrategicBets {
									@strategicBetChip(bet)
								}
							</div>
						</div>
					}

					// Right: health summary column
					<div class="shrink-0 flex flex-col gap-2 lg:border-l lg:border-base-content/5 lg:pl-5 lg:min-w-48">
						<span class="text-xs font-semibold uppercase tracking-widest text-base-content/40 mb-0.5">Health</span>
						// Coherence
						if data.CoherenceScore != "" {
							<div class="flex items-center justify-between gap-3 text-xs">
								<span class="text-base-content/60">{ langs.T(ctx, "nav.screen.coherence") }</span>
								<span class={ "font-mono font-semibold", instanceCoherenceColor(data.CoherenceScore) }>{ data.CoherenceScore }</span>
							</div>
						}
						// Untested assumptions
						if data.UntestedCount > 0 {
							<div class="flex items-center justify-between gap-3 text-xs">
								<span class="text-base-content/60">Untested assumptions</span>
								<span class="font-semibold text-warning">{ strconv.Itoa(data.UntestedCount) }</span>
							</div>
						}
						// Evidence
						if data.EvidenceCount > 0 {
							<div class="flex items-center justify-between gap-3 text-xs">
								<span class="text-base-content/60">Evidence items</span>
								<span class="font-semibold text-base-content/70">{ strconv.Itoa(data.EvidenceCount) }</span>
							</div>
						}
						// AIM cycles
						if data.AIMCycleCount > 0 {
							<div class="flex items-center justify-between gap-3 text-xs">
								<span class="text-base-content/60">AIM cycles</span>
								<span class="font-semibold text-base-content/70">{ strconv.Itoa(data.AIMCycleCount) }</span>
							</div>
						}
						// Versions
						if data.VersionCount > 0 {
							<div class="flex items-center justify-between gap-3 text-xs">
								<span class="text-base-content/60">{ langs.T(ctx, "nav.screen.versions") }</span>
								<span class="font-semibold text-base-content/70">{ strconv.Itoa(data.VersionCount) }</span>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// strategicBetChip renders a single strategic bet as a compact chip.
templ strategicBetChip(bet StrategicBetInfo) {
	<span class="tooltip tooltip-bottom" data-tip={ bet.Hypothesis }>
		<span class="inline-flex items-center gap-1.5 rounded-lg border border-base-content/10 bg-base-200/40 px-2.5 py-1.5 text-xs text-base-content/70 hover:bg-base-200 transition-colors">
			if bet.Track != "" {
				<span class={ "size-1.5 rounded-full shrink-0", betTrackDot(bet.Track) }></span>
			}
			<span class="font-medium text-base-content/80">{ bet.Name }</span>
		</span>
	</span>
}

func betTrackDot(track string) string {
	switch track {
	case "product":
		return "bg-info"
	case "commercial":
		return "bg-error"
	case "strategy":
		return "bg-primary"
	case "org_ops":
		return "bg-warning"
	default:
		return "bg-base-content/30"
	}
}

// strategyLoopWidgetHref returns the primary link target for the strategy loop widget.
// Links to the latest version detail if available, otherwise to the AIM overview.
func strategyLoopWidgetHref(data ExecutionData) string {
	if data.LoopLastVersionID != "" {
		return "/strategies/" + data.InstanceID + "/aim/versions/" + data.LoopLastVersionID
	}
	return "/strategies/" + data.InstanceID + "/aim"
}

// strategyLoopWidget renders a compact status card showing the current strategy loop state.
// Links to the latest version detail when available, or to the AIM overview otherwise.
templ strategyLoopWidget(data ExecutionData) {
	<a
		href={ templ.URL(strategyLoopWidgetHref(data)) }
		hx-get={ strategyLoopWidgetHref(data) }
		hx-target="#tab-content"
		hx-swap="innerHTML"
		hx-push-url="true"
		class="rounded-xl border border-base-content/10 bg-base-100 px-5 py-3 flex items-center gap-4 shadow-sm hover:bg-base-200 transition-colors group cursor-pointer"
	>
		<span class="iconify lucide--target size-5 text-base-content/50 group-hover:text-primary shrink-0"></span>
		<div class="flex items-center gap-4 grow min-w-0 text-xs text-base-content/60">
			if data.LoopCycleRunning {
				<span class="flex items-center gap-1.5">
					<span class="iconify lucide--loader-2 size-3 text-primary animate-spin"></span>
					<span class="font-semibold text-primary">
						if data.LoopCycleStep != "" {
							{ data.LoopCycleStep }
						} else {
							Cycle running
						}
					</span>
				</span>
			}
			if data.LoopPendingCount > 0 {
				<span class="flex items-center gap-1.5">
					<span class="iconify lucide--inbox size-3 text-info"></span>
					<span class="font-semibold text-info">{ strconv.Itoa(data.LoopPendingCount) } pending review(s)</span>
				</span>
			}
			if data.LoopLastVersion != "" {
				if data.LoopLastVersionDesc != "" {
					<span class="flex items-center gap-1.5 tooltip tooltip-bottom" data-tip={ data.LoopLastVersionDesc }>
						<span class="iconify lucide--history size-3"></span>
						if data.LoopLastVersionLabel != "" {
							{ data.LoopLastVersionLabel } — { data.LoopLastVersion }
						} else {
							Last version: { data.LoopLastVersion }
						}
					</span>
				} else {
					<span class="flex items-center gap-1.5">
						<span class="iconify lucide--history size-3"></span>
						if data.LoopLastVersionLabel != "" {
							{ data.LoopLastVersionLabel } — { data.LoopLastVersion }
						} else {
							Last version: { data.LoopLastVersion }
						}
					</span>
				}
			}
		</div>
		<span class="iconify lucide--arrow-right size-4 text-base-content/30 group-hover:text-primary shrink-0"></span>
	</a>
}
