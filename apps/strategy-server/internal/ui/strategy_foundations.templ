package ui

import (
	"strconv"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
)

// StrategyFoundationsData holds all data for the bespoke Strategy Foundations view.
type StrategyFoundationsData struct {
	NavContext
	ArtifactKey string
	Name        string
	Status      string
	LastUpdated string
	Confidence  string

	// References to the artifacts this one was derived from.
	References []RecordFact

	// Product Vision
	VisionStatement   string
	TargetTimeframe   string
	SuccessIndicators []FoundationIndicator

	// Value Proposition
	VPHeadline      string
	VPTargetSegment string
	ProofPoints     []FoundationProofPoint
	KeyBenefits     []string
	EconomicValue   FoundationEconomicValue

	// Strategic Sequencing
	SequencingPrinciple string
	Phases              []FoundationPhase

	// Information architecture and design principles
	ArchitecturePhilosophy string
	DesignPrinciples       []FoundationPrinciple

	// Sections whose entries share one card: the vision's alignment, the value
	// proposition's jobs, pains and feelings, the sequencing constraints, the
	// architecture's structure and patterns, the consistency validation and the
	// change log.
	Records []RecordSection

	// Stored content that no section above shows. It is rendered as stored,
	// under a notice, so that nothing in the artifact is dropped silently.
	Unshown map[string]any

	// Section completeness gaps
	Gaps []ReadyGap
}

type FoundationIndicator struct {
	Indicator string
	Target    string
}

type FoundationProofPoint struct {
	Claim string
	Proof string
}

type FoundationEconomicValue struct {
	CostSavings   string
	RevenueGains  string
	RiskReduction string
}

type FoundationPhase struct {
	Phase              string
	Name               string
	Focus              string
	Timeframe          string
	TargetSegment      string
	TargetProblem      string
	EnabledBy          string
	ValueDelivered     []string
	SuccessCriteria    []FoundationCriterion
	StrategicRationale string
}

type FoundationCriterion struct {
	Metric string
	Target string
}

type FoundationPrinciple struct {
	Principle     string
	Manifestation string
}

// Slots of the record sections on the page.
const (
	FoundationSlotVision     = "vision"
	FoundationSlotValueProp  = "valueprop"
	FoundationSlotSequencing = "sequencing"
	FoundationSlotArch       = "architecture"
	FoundationSlotValidation = "validation"
)

// Kinds of record section. Each has a title, icon and slot in foundationRecordStyles.
const (
	FoundationKindVisionTrends         = "vision_trends"
	FoundationKindVisionOpportunity    = "vision_opportunity"
	FoundationKindVisionDifferentiator = "vision_differentiator"
	FoundationKindJobs                 = "jobs_to_be_done"
	FoundationKindPains                = "pains_we_eliminate"
	FoundationKindFeelings             = "feelings_we_create"
	FoundationKindVPConsistency        = "value_proposition_consistency"
	FoundationKindDependencies         = "dependencies"
	FoundationKindSequenceRisks        = "risks_of_sequence"
	FoundationKindAlternative          = "alternative_considered"
	FoundationKindSequenceConsistency  = "sequencing_consistency"
	FoundationKindMentalModel          = "mental_model"
	FoundationKindNavigation           = "top_level_navigation"
	FoundationKindObjectTypes          = "key_object_types"
	FoundationKindPrimaryActions       = "primary_actions"
	FoundationKindDiscovery            = "information_discovery"
	FoundationKindCompetitiveIA        = "competitive_ia_comparison"
	FoundationKindIAConsistency        = "architecture_consistency"
	FoundationKindValidation           = "consistency_validation"
	FoundationKindValidatedAgainst     = "validated_against"
	FoundationKindKnownTensions        = "known_tensions"
	FoundationKindChangeLog            = "change_log"
)

var foundationRecordStyles = map[string]RecordStyle{
	FoundationKindVisionTrends:         {FoundationSlotVision, "Informed by Trends", "lucide--trending-up", "accent"},
	FoundationKindVisionOpportunity:    {FoundationSlotVision, "Opportunity Addressed", "lucide--crosshair", "accent"},
	FoundationKindVisionDifferentiator: {FoundationSlotVision, "Vision Differentiator", "lucide--sparkle", "accent"},
	FoundationKindJobs:                 {FoundationSlotValueProp, "Jobs To Be Done", "lucide--target", "primary"},
	FoundationKindPains:                {FoundationSlotValueProp, "Pains We Eliminate", "lucide--x-circle", "error"},
	FoundationKindFeelings:             {FoundationSlotValueProp, "Feelings We Create", "lucide--heart", "success"},
	FoundationKindVPConsistency:        {FoundationSlotValueProp, "Consistency Check", "lucide--check-check", "primary"},
	FoundationKindDependencies:         {FoundationSlotSequencing, "Dependencies", "lucide--git-branch", "secondary"},
	FoundationKindSequenceRisks:        {FoundationSlotSequencing, "Risks of the Sequence", "lucide--alert-triangle", "error"},
	FoundationKindAlternative:          {FoundationSlotSequencing, "Alternative Considered", "lucide--split", "secondary"},
	FoundationKindSequenceConsistency:  {FoundationSlotSequencing, "Consistency Check", "lucide--check-check", "secondary"},
	FoundationKindMentalModel:          {FoundationSlotArch, "Mental Model", "lucide--brain", "info"},
	FoundationKindNavigation:           {FoundationSlotArch, "Top-level Navigation", "lucide--navigation", "info"},
	FoundationKindObjectTypes:          {FoundationSlotArch, "Key Object Types", "lucide--boxes", "info"},
	FoundationKindPrimaryActions:       {FoundationSlotArch, "Primary Actions", "lucide--mouse-pointer-click", "info"},
	FoundationKindDiscovery:            {FoundationSlotArch, "Information Discovery", "lucide--search", "info"},
	FoundationKindCompetitiveIA:        {FoundationSlotArch, "Competitive Comparison", "lucide--swords", "info"},
	FoundationKindIAConsistency:        {FoundationSlotArch, "Consistency Check", "lucide--check-check", "info"},
	FoundationKindValidation:           {FoundationSlotValidation, "Consistency Validation", "lucide--shield-check", "success"},
	FoundationKindValidatedAgainst:     {FoundationSlotValidation, "Validated Against", "lucide--file-check", "success"},
	FoundationKindKnownTensions:        {FoundationSlotValidation, "Known Tensions", "lucide--scale", "warning"},
	FoundationKindChangeLog:            {FoundationSlotValidation, "Change Log", "lucide--history", "neutral"},
}

func (d StrategyFoundationsData) hasRecords(slot string) bool {
	return recordsInSlot(foundationRecordStyles, d.Records, slot)
}

func (d StrategyFoundationsData) hasVision() bool {
	return d.VisionStatement != "" || d.TargetTimeframe != "" || len(d.SuccessIndicators) > 0 || d.hasRecords(FoundationSlotVision)
}

func (d StrategyFoundationsData) hasValueProposition() bool {
	return d.VPHeadline != "" || d.VPTargetSegment != "" || len(d.ProofPoints) > 0 || len(d.KeyBenefits) > 0 ||
		d.EconomicValue != (FoundationEconomicValue{}) || d.hasRecords(FoundationSlotValueProp)
}

func (d StrategyFoundationsData) hasSequencing() bool {
	return d.SequencingPrinciple != "" || len(d.Phases) > 0 || d.hasRecords(FoundationSlotSequencing)
}

func (d StrategyFoundationsData) hasArchitecture() bool {
	return d.ArchitecturePhilosophy != "" || d.hasRecords(FoundationSlotArch)
}

// StrategyFoundationsContent renders the bespoke Strategy Foundations view.
templ StrategyFoundationsContent(data StrategyFoundationsData) {
	@TabBackLink(data.TabGroup, data.InstanceID, data.CurrentPath)
	<div class="space-y-8">
		@detailGapBanner(data.Gaps)
		// ── Hero ──
		@foundationsHero(data)

		// ── Product Vision ──
		if data.hasVision() {
			@foundationsVisionSection(data)
		}

		// ── Value Proposition ──
		if data.hasValueProposition() {
			@foundationsValuePropSection(data)
		}

		// ── Strategic Sequencing ──
		if data.hasSequencing() {
			@foundationsSequencingSection(data)
		}

		// ── Information Architecture ──
		if data.hasArchitecture() {
			@foundationsArchitectureSection(data)
		}

		// ── Design Principles ──
		if len(data.DesignPrinciples) > 0 {
			@foundationsDesignPrinciplesSection(data.DesignPrinciples)
		}

		@RecordSections(foundationRecordStyles, data.Records, FoundationSlotValidation)
		@StoredNotShown(data.Unshown)
	</div>
}

// ──────────────────────────────────────────────────────────────────────
// Hero
// ──────────────────────────────────────────────────────────────────────

templ foundationsHero(data StrategyFoundationsData) {
	<div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-accent/10 via-base-100 to-info/10 border border-accent/10">
		<div class="px-6 py-8 sm:px-8">
			<div class="flex items-start justify-between">
				<div class="space-y-2">
					<div class="flex items-center gap-2">
						<span class="iconify lucide--compass size-5 text-accent"></span>
						<span class="text-xs font-semibold uppercase tracking-widest text-accent">{ langs.T(ctx, "artifact.label.strategy_foundations") }</span>
						if data.Status != "" {
							@artifactStatusBadge(data.Status)
						}
						if data.Confidence != "" {
							<span class="tooltip" data-tip={ confidenceHint(data.Confidence) }><span class={ "badge badge-sm", confidenceBadgeClass(data.Confidence) }>{ data.Confidence } confidence</span></span>
						}
					</div>
					<h1 class="text-2xl font-bold text-base-content sm:text-3xl">{ data.Name }</h1>
					if len(data.References) > 0 {
						<p class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-base-content/75">
							for _, ref := range data.References {
								<span><span class="font-medium">{ ref.Label }:</span> <span class="font-mono">{ ref.Value }</span></span>
							}
						</p>
					}
				</div>
				if data.LastUpdated != "" {
			<div class="hidden sm:block text-right text-xs text-base-content/75">
					<p>Updated { data.LastUpdated }</p>
				</div>
				}
			</div>
		</div>
	</div>
}

// ──────────────────────────────────────────────────────────────────────
// Product Vision
// ──────────────────────────────────────────────────────────────────────

templ foundationsVisionSection(data StrategyFoundationsData) {
	<section>
		@sectionHeading("Product Vision", "lucide--eye", "accent", "Where we're heading")
		<div class="mt-4 space-y-4">
			if data.VisionStatement != "" {
				<div class="rounded-xl bg-gradient-to-r from-accent/5 to-transparent border border-accent/10 p-5">
					<blockquote class="text-base text-base-content leading-relaxed italic">
						{ data.VisionStatement }
					</blockquote>
				</div>
			}
			if data.TargetTimeframe != "" {
				<div>
					<span class="badge badge-sm badge-outline badge-accent">{ data.TargetTimeframe }</span>
				</div>
			}
			if len(data.SuccessIndicators) > 0 {
				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
					for _, ind := range data.SuccessIndicators {
						<div class="card bg-base-100 border border-base-content/15 shadow-sm">
							<div class="card-body p-3 text-center">
								if ind.Target != "" {
									<p class="text-lg font-bold text-base-content">{ ind.Target }</p>
								}
								<p class="text-xs text-base-content/80">{ ind.Indicator }</p>
							</div>
						</div>
					}
				</div>
			}
			@RecordSections(foundationRecordStyles, data.Records, FoundationSlotVision)
		</div>
	</section>
}

// ──────────────────────────────────────────────────────────────────────
// Value Proposition
// ──────────────────────────────────────────────────────────────────────

templ foundationsValuePropSection(data StrategyFoundationsData) {
	<section>
		@sectionHeading("Value Proposition", "lucide--sparkles", "primary", data.VPTargetSegment)
		<div class="mt-4 space-y-4">
			if data.VPHeadline != "" {
				<div class="rounded-xl bg-gradient-to-r from-primary/5 to-transparent border border-primary/10 p-5">
					<blockquote class="text-base text-base-content leading-relaxed italic">
						{ data.VPHeadline }
					</blockquote>
				</div>
			}
			// Proof Points
			if len(data.ProofPoints) > 0 {
				<div class="grid gap-3 md:grid-cols-2">
					for _, pp := range data.ProofPoints {
						<div class="card bg-base-100 border border-base-content/15 shadow-sm">
							<div class="card-body p-4">
								<p class="text-sm font-medium text-base-content">{ pp.Claim }</p>
					if pp.Proof != "" {
								<p class="text-xs text-base-content/80 mt-1">
									<span class="font-medium text-base-content/75">Proof:</span> { pp.Proof }
									</p>
								}
							</div>
						</div>
					}
				</div>
			}
			if len(data.KeyBenefits) > 0 {
				@bulletListCard("Key Benefits", data.KeyBenefits, "lucide--check-circle-2", "success")
			}
			// Economic Value
			if data.EconomicValue.CostSavings != "" || data.EconomicValue.RevenueGains != "" || data.EconomicValue.RiskReduction != "" {
				<div class="card bg-base-100 border border-base-content/15 shadow-sm">
					<div class="card-body p-4">
						<h4 class="text-xs font-semibold uppercase tracking-wide text-base-content/80 mb-3">Economic Value</h4>
						<div class="grid gap-4 md:grid-cols-3">
							if data.EconomicValue.CostSavings != "" {
								<div class="text-center">
									<span class="iconify lucide--piggy-bank size-5 text-success mx-auto mb-1"></span>
									<p class="text-lg font-bold text-base-content">{ data.EconomicValue.CostSavings }</p>
									<p class="text-xs text-base-content/80">Cost Savings</p>
								</div>
							}
							if data.EconomicValue.RevenueGains != "" {
								<div class="text-center">
									<span class="iconify lucide--trending-up size-5 text-accent mx-auto mb-1"></span>
									<p class="text-lg font-bold text-base-content">{ data.EconomicValue.RevenueGains }</p>
									<p class="text-xs text-base-content/80">Revenue Gains</p>
								</div>
							}
							if data.EconomicValue.RiskReduction != "" {
								<div class="text-center">
									<span class="iconify lucide--shield-check size-5 text-info mx-auto mb-1"></span>
									<p class="text-lg font-bold text-base-content">{ data.EconomicValue.RiskReduction }</p>
									<p class="text-xs text-base-content/80">Risk Reduction</p>
								</div>
							}
						</div>
					</div>
				</div>
			}
			@RecordSections(foundationRecordStyles, data.Records, FoundationSlotValueProp)
		</div>
	</section>
}

// ──────────────────────────────────────────────────────────────────────
// Strategic Sequencing
// ──────────────────────────────────────────────────────────────────────

templ foundationsSequencingSection(data StrategyFoundationsData) {
	<section>
		@sectionHeading("Strategic Sequencing", "lucide--list-ordered", "secondary", "How we phase our approach")
		<div class="mt-4 space-y-4">
			if data.SequencingPrinciple != "" {
				<div class="rounded-xl bg-gradient-to-r from-secondary/5 to-transparent border border-secondary/10 p-5">
					<blockquote class="text-base text-base-content leading-relaxed italic">
						{ data.SequencingPrinciple }
					</blockquote>
				</div>
			}
			if len(data.Phases) > 0 {
				<div class="flex flex-col gap-0">
					for i, phase := range data.Phases {
						@foundationsPhaseStep(phase, i, len(data.Phases))
					}
				</div>
			}
			@RecordSections(foundationRecordStyles, data.Records, FoundationSlotSequencing)
		</div>
	</section>
}

// ──────────────────────────────────────────────────────────────────────
// Information Architecture
// ──────────────────────────────────────────────────────────────────────

templ foundationsArchitectureSection(data StrategyFoundationsData) {
	<section>
		@sectionHeading("Information Architecture", "lucide--layout-panel-left", "info", "How users understand the product")
		<div class="mt-4 space-y-4">
			if data.ArchitecturePhilosophy != "" {
				<div class="rounded-xl bg-gradient-to-r from-info/5 to-transparent border border-info/10 p-5">
					<blockquote class="text-base text-base-content leading-relaxed italic">
						{ data.ArchitecturePhilosophy }
					</blockquote>
				</div>
			}
			@RecordSections(foundationRecordStyles, data.Records, FoundationSlotArch)
		</div>
	</section>
}

templ foundationsPhaseStep(phase FoundationPhase, idx, total int) {
	<div class="flex items-start gap-4">
		// Vertical connector
		<div class="flex flex-col items-center">
			<div class="flex items-center justify-center size-7 rounded-full bg-secondary/10 text-secondary text-xs font-bold shrink-0">
				{ strconv.Itoa(idx + 1) }
			</div>
			if idx < total-1 {
				<div class="w-0.5 h-8 bg-secondary/20"></div>
			}
		</div>
		<div class="pb-4 min-w-0 grow">
			<div class="flex items-center gap-2">
				if phase.Phase != "" {
					<span class="badge badge-xs badge-secondary">Phase { phase.Phase }</span>
				}
				<p class="text-sm font-semibold text-base-content">{ phase.Name }</p>
				if phase.Timeframe != "" {
					<span class="badge badge-xs badge-outline badge-secondary">{ phase.Timeframe }</span>
				}
			</div>
		if phase.Focus != "" {
			<p class="text-xs text-base-content/80 mt-0.5">{ phase.Focus }</p>
		}
		if phase.TargetSegment != "" {
			<p class="text-xs text-base-content/80 mt-0.5">
				<span class="font-medium text-base-content/75">Segment:</span> { phase.TargetSegment }
				</p>
			}
			if phase.TargetProblem != "" {
				<p class="text-xs text-base-content/80 mt-0.5">
					<span class="font-medium text-base-content/75">Problem:</span> { phase.TargetProblem }
				</p>
			}
			if phase.EnabledBy != "" {
				<p class="text-xs text-base-content/80 mt-0.5">
					<span class="font-medium text-base-content/75">Enabled by:</span> { phase.EnabledBy }
				</p>
			}
			if len(phase.ValueDelivered) > 0 {
				<div class="flex flex-wrap gap-1 mt-2">
					for _, v := range phase.ValueDelivered {
						<span class="badge badge-xs badge-ghost">{ v }</span>
					}
				</div>
			}
			if len(phase.SuccessCriteria) > 0 {
				<div class="mt-2 space-y-0.5">
					<p class="text-xs font-medium text-base-content/75">Success criteria</p>
					for _, c := range phase.SuccessCriteria {
						<p class="text-xs text-base-content/80">
							{ c.Metric }
							if c.Target != "" {
								<span class="font-mono text-accent"> { c.Target }</span>
							}
						</p>
					}
				</div>
			}
			if phase.StrategicRationale != "" {
				<p class="text-xs text-secondary/70 mt-1.5 italic">{ phase.StrategicRationale }</p>
			}
		</div>
	</div>
}

// ──────────────────────────────────────────────────────────────────────
// Design Principles
// ──────────────────────────────────────────────────────────────────────

templ foundationsDesignPrinciplesSection(principles []FoundationPrinciple) {
	<section>
		@sectionHeading("Design Principles", "lucide--ruler", "warning", "Standards that shape our product")
		<div class="mt-4 grid gap-3 md:grid-cols-2">
			for _, p := range principles {
				<div class="card bg-base-100 border border-base-content/15 shadow-sm">
					<div class="card-body p-4">
						<div class="flex items-center gap-2 mb-2">
							<span class="iconify lucide--compass size-4 text-warning"></span>
							<h4 class="text-sm font-bold text-base-content">{ p.Principle }</h4>
						</div>
						if p.Manifestation != "" {
							<p class="text-sm text-base-content/80 leading-relaxed">{ p.Manifestation }</p>
						}
					</div>
				</div>
			}
		</div>
	</section>
}
