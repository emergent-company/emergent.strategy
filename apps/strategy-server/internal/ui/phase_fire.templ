package ui

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
)

// FirePhaseData holds all data for the FIRE phase dashboard.
type FirePhaseData struct {
	InstanceID string

	// Features by status (for stat cards)
	DeliveredCount  int
	InProgressCount int
	DraftCount      int
	TotalFeatures   int

	// Bootstrap / alignment capabilities
	HasRoadmap         bool // roadmap_recipe exists — required for align-portfolio
	HasSkillExecutor   bool // LLM provider is configured
	MissingValueModels int  // number of tracks without a value model (0 = all present)

	// Canonical definition coverage
	CanonicalDefCount  int // total canonical definitions available (embedded templates)
	InstalledDefCount  int // definitions already in this instance
	MissingDefTracks   []string // track names missing all definitions (e.g. ["Strategy", "Org & Ops", "Commercial"])

	// Per-track data — the circular KR → ValueModel → Definitions model
	// Ordered: Strategy, OrgOps, Product, Commercial
	FireTracks []FireTrackData

	// Track definitions (legacy — used by trackCard)
	Tracks []TrackSummary

	// Value models
	ValueModels []ValueModelSummary

	// Recent features (top 10)
	RecentFeatures []FeatureSummary
}

// FireTrackData holds the full circular traceability data for one execution track.
type FireTrackData struct {
	// Identity
	Name  string // "Strategy", "Org & Ops", "Product", "Commercial"
	Icon  string
	Track string // DB key: "strategy", "org_ops", "product", "commercial"
	Color string // Tailwind color token: "primary", "secondary", "accent", "info"

	// From Roadmap Recipe — what the track committed to deliver
	Objectives []FireOKRObjective

	// Value Model — names the value generators that will deliver outcomes
	ValueModelExists  bool
	ValueModelLayers  []string // L1 layer names (the "what" being structured); unused for Product
	ValueModelCount   int      // total number of value models for this track

	// Product-only: per-product-line summaries shown inside the single Product column
	ProductLines []FireProductLineSummary

	// Definitions — requirements for delivering those outcomes
	DefinitionCount int
	DefinitionURL   string // e.g. /fire/strategy
}

// FireProductLineSummary is a compact summary for one product line shown in the FIRE overview column.
type FireProductLineSummary struct {
	Name   string
	Layers []string
}

// FireOKRKeyResult holds one key result with optional TRL progression.
type FireOKRKeyResult struct {
	Description    string
	TRLStart       int    // 0 = not set
	TRLTarget      int    // 0 = not set
	TRLProgression string // e.g. "TRL 3 → TRL 6"
}

// FireOKRObjective holds one objective and its key results for a track.
type FireOKRObjective struct {
	Objective  string
	KeyResults []FireOKRKeyResult
}

// TrackSummary shows definition counts per track.
type TrackSummary struct {
	Name  string
	Icon  string
	Count int
	Track string // DB track value
	URL   string // destination URL — overrides the default /fire/<track> if set
}

// ValueModelSummary shows value model status per track.
type ValueModelSummary struct {
	Track  string
	Status string
	Icon   string
}

// FeatureSummary is a minimal feature for listing.
type FeatureSummary struct {
	Key    string
	Name   string
	Status string
	Track  string
}

// FirePhaseContent renders the FIRE phase as a circular traceability map.
// Each track shows: Roadmap KRs → Value Model (what value generators exist) → Definitions (requirements).
// The circular arrow back from Definitions to KRs shows traceability: each definition traces to a KR.
templ FirePhaseContent(data FirePhaseData) {
	@TabRelatedPages("fire", data.InstanceID, "/strategies/"+data.InstanceID+"/fire")
	<div class="space-y-4">
		<!-- Header -->
		<div class="flex items-center justify-between">
			<div>
				<h2 class="text-base font-semibold text-base-content">{ langs.T(ctx, "ui.fire.phase_title") }</h2>
				<p class="text-xs text-base-content/75 mt-0.5">{ langs.T(ctx, "ui.fire.phase_subtitle") }</p>
			</div>
		<!-- Feature stat pills -->
		<div class="hidden md:flex items-center gap-3 text-xs">
			<span class="flex items-center gap-1 text-success">
				<span class="iconify lucide--check-circle-2 size-3.5"></span>
				{ fmt.Sprintf(langs.T(ctx, "ui.fire.stat.delivered"), data.DeliveredCount) }
			</span>
			<span class="flex items-center gap-1 text-primary">
				<span class="iconify lucide--loader-circle size-3.5"></span>
				{ fmt.Sprintf(langs.T(ctx, "ui.fire.stat.in_progress"), data.InProgressCount) }
			</span>
			<span class="flex items-center gap-1 text-base-content/65">
				<span class="iconify lucide--circle-dashed size-3.5"></span>
				{ fmt.Sprintf(langs.T(ctx, "ui.fire.stat.draft"), data.DraftCount) }
			</span>
		</div>
		</div>
		<!-- Missing definitions banner -->
		if len(data.MissingDefTracks) > 0 {
			@fireDefinitionsBanner(data)
		}
		<!-- Portfolio alignment status — read-only; alignment is automatic via AIM cycle -->
		if data.MissingValueModels > 0 {
			@fireAlignStatusBanner(data)
		}
		<!-- Four-track traceability grid -->
		if len(data.FireTracks) > 0 {
			<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3">
				for _, t := range data.FireTracks {
					@fireTrackColumn(data.InstanceID, t)
				}
			</div>
		}
		<!-- Handoff connector: FIRE → AIM -->
		<div class="flex flex-col items-center gap-1 py-1">
			<div class="w-px h-4 bg-error/40"></div>
			<svg width="16" height="10" viewBox="0 0 16 10" fill="none" class="text-error/60">
				<line x1="8" y1="0" x2="8" y2="6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
				<polyline points="4,4 8,9 12,4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></polyline>
			</svg>
			<span class="text-xs text-base-content/55 tracking-wide uppercase font-medium">{ langs.T(ctx, "ui.fire.connector.data_feeds") }</span>
		</div>
		<!-- AIM handoff banner -->
		<a
			href={ templ.URL("/strategies/" + data.InstanceID + "/aim") }
			hx-get={ "/strategies/" + data.InstanceID + "/aim" }
			hx-target="#tab-content"
			hx-swap="innerHTML"
			hx-push-url="true"
			class="card border border-error/25 bg-error/5 shadow-sm hover:shadow-md hover:scale-[1.005] transition-all duration-150 cursor-pointer w-full"
		>
			<div class="card-body p-4">
				<div class="flex items-center gap-2.5">
					<div class="rounded-lg p-2 bg-error/15 shrink-0">
						<span class="iconify lucide--activity size-4 text-error"></span>
					</div>
					<div class="min-w-0 flex-1">
						<div class="flex items-center gap-2">
							<h3 class="text-sm font-semibold text-base-content">{ langs.T(ctx, "ui.aim.phase_title") }</h3>
							<span class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-xs font-mono font-semibold bg-error/15 text-error">
								{ langs.T(ctx, "ui.aim.phase_badge") }
							</span>
						</div>
						<p class="text-xs text-base-content/65 mt-0.5">{ langs.T(ctx, "ui.aim.phase_subtitle") }</p>
					</div>
					<div class="hidden md:flex items-center gap-4 border-l border-base-content/15 pl-4 shrink-0">
						<div class="flex items-center gap-1.5 text-xs text-base-content/65">
							<span class="iconify lucide--zap size-3.5"></span>
							{ langs.T(ctx, "ui.aim.stat.signals") }
						</div>
						<div class="flex items-center gap-1.5 text-xs text-base-content/65">
							<span class="iconify lucide--bar-chart-2 size-3.5"></span>
							{ langs.T(ctx, "ui.aim.stat.metrics") }
						</div>
						<div class="flex items-center gap-1.5 text-xs text-base-content/65">
							<span class="iconify lucide--refresh-ccw size-3.5"></span>
							{ langs.T(ctx, "ui.aim.stat.calibration") }
						</div>
					</div>
					<span class="iconify lucide--chevron-right size-4 text-base-content/30 shrink-0"></span>
				</div>
			</div>
		</a>
	</div>
}

// fireTrackColumn renders one track's full circular traceability stack:
//
//	┌─────────────────┐
//	│  Track header   │  (name, icon, KR count)
//	├─────────────────┤
//	│  KRs from       │  (objectives + KR list)
//	│  Roadmap        │
//	├────────↓────────┤
//	│  Value Model    │  (layer names — what value generators exist)
//	├────────↓────────┤
//	│  Definitions    │  (count + link — requirements for delivery)
//	│        ↑ traces back to KRs
//	└─────────────────┘
templ fireTrackColumn(instanceID string, t FireTrackData) {
	<div class="flex flex-col gap-0 rounded-xl border border-base-content/15 overflow-hidden shadow-sm">
		<!-- Track header -->
		<a
			href={ templ.URL(t.DefinitionURL) }
			hx-get={ t.DefinitionURL }
			hx-target="#tab-content"
			hx-swap="innerHTML"
			hx-push-url="true"
			class={ "flex items-center gap-2.5 px-4 py-3 hover:opacity-90 transition-opacity cursor-pointer bg-" + t.Color + "/10 border-b border-" + t.Color + "/20" }
		>
			<div class={ "rounded-lg p-1.5 bg-" + t.Color + "/20 shrink-0" }>
				<span class={ "iconify size-4 text-" + t.Color + " " + t.Icon }></span>
			</div>
			<div class="min-w-0 flex-1">
				<h3 class="text-sm font-semibold text-base-content leading-tight">{ t.Name }</h3>
				<p class={ "text-xs text-" + t.Color + "/70" }>{ strconv.Itoa(len(t.Objectives)) } objectives</p>
			</div>
			<span class="iconify lucide--chevron-right size-3.5 text-base-content/30 shrink-0"></span>
		</a>
		<!-- Section 1: KRs from Roadmap -->
		<div class="bg-base-100 px-4 py-3 border-b border-base-content/8">
			<div class="flex items-center gap-1.5 mb-2">
				<span class="iconify lucide--target size-3.5 text-base-content/55"></span>
				<span class="text-xs font-medium text-base-content/75 uppercase tracking-wide">{ langs.T(ctx, "ui.fire.track.roadmap_krs") }</span>
			</div>
			if len(t.Objectives) == 0 {
				<p class="text-xs text-base-content/35 italic">{ langs.T(ctx, "ui.fire.track.no_okrs") }</p>
			} else {
				<div class="space-y-2">
					for _, obj := range t.Objectives {
						<div>
							<p class="text-xs font-medium text-base-content/80 leading-snug">{ obj.Objective }</p>
						if len(obj.KeyResults) > 0 {
							<ul class="mt-1 space-y-0.5">
								for _, kr := range obj.KeyResults {
									<li class="flex items-start gap-1.5 text-xs text-base-content/55 leading-snug">
										<span class="iconify lucide--arrow-right size-3 mt-0.5 shrink-0 text-base-content/30"></span>
										<span class="flex-1">
											{ kr.Description }
											if kr.TRLProgression != "" {
												<span class="ml-1 inline-flex items-center gap-0.5 rounded bg-base-content/10 px-1 py-0.5 font-mono text-xs text-base-content/80">
													<span class="iconify lucide--flask-conical size-2.5"></span>
													{ kr.TRLProgression }
												</span>
											}
										</span>
									</li>
								}
							</ul>
						}
						</div>
					}
				</div>
			}
		</div>
		<!-- Down arrow connector -->
		<div class="flex justify-center bg-base-100 py-1 border-b border-base-content/8">
			<span class="iconify lucide--arrow-down size-3.5 text-base-content/25"></span>
		</div>
		<!-- Section 2: Value Model -->
		<a
			href={ templ.URL(t.DefinitionURL) }
			hx-get={ t.DefinitionURL }
			hx-target="#tab-content"
			hx-swap="innerHTML"
			hx-push-url="true"
			class="bg-base-100 px-4 py-3 border-b border-base-content/8 hover:bg-base-100 transition-colors cursor-pointer block"
		>
			<div class="flex items-center gap-1.5 mb-2">
				<span class="iconify lucide--layers size-3.5 text-base-content/55"></span>
				<span class="text-xs font-medium text-base-content/75 uppercase tracking-wide">{ langs.T(ctx, "ui.fire.track.value_model") }</span>
				if t.ValueModelCount > 1 {
					<span class="text-xs text-base-content/35">({ strconv.Itoa(t.ValueModelCount) })</span>
				}
			</div>
			if !t.ValueModelExists {
				<p class="text-xs text-base-content/35 italic">{ langs.T(ctx, "ui.fire.value_model.not_defined") }</p>
			} else if len(t.ProductLines) > 0 {
				<!-- Product track: show each product line with its layers -->
				<div class="space-y-2">
					for _, pl := range t.ProductLines {
						<div>
							<p class="text-xs font-semibold text-base-content/65 mb-0.5">{ pl.Name }</p>
							if len(pl.Layers) > 0 {
								<div class="flex flex-wrap gap-1">
									for _, layer := range pl.Layers {
										<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs bg-base-content/10 text-base-content/80 leading-tight">{ layer }</span>
									}
								</div>
							}
						</div>
					}
				</div>
			} else if len(t.ValueModelLayers) == 0 {
				<p class="text-xs text-base-content/55">{ langs.T(ctx, "ui.fire.value_model.exists") }</p>
			} else {
				<div class="flex flex-wrap gap-1">
					for _, layer := range t.ValueModelLayers {
						<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs bg-base-content/10 text-base-content/80 leading-tight">{ layer }</span>
					}
				</div>
			}
		</a>
		<!-- Down arrow connector -->
		<div class="flex justify-center bg-base-100 py-1 border-b border-base-content/8">
			<span class="iconify lucide--arrow-down size-3.5 text-base-content/25"></span>
		</div>
		<!-- Section 3: Definitions -->
		<a
			href={ templ.URL(t.DefinitionURL) }
			hx-get={ t.DefinitionURL }
			hx-target="#tab-content"
			hx-swap="innerHTML"
			hx-push-url="true"
			class="bg-base-100 px-4 py-3 hover:bg-base-100 transition-colors cursor-pointer block"
		>
			<div class="flex items-center gap-1.5 mb-1.5">
				<span class="iconify lucide--file-text size-3.5 text-base-content/55"></span>
				<span class="text-xs font-medium text-base-content/75 uppercase tracking-wide">{ langs.T(ctx, "ui.fire.track.definitions") }</span>
			</div>
			<div class="flex items-center justify-between">
				<p class="text-sm font-semibold text-base-content">{ strconv.Itoa(t.DefinitionCount) }</p>
				<span class="text-xs text-base-content/55">{ langs.T(ctx, "ui.fire.track.definitions_hint") }</span>
			</div>
			<!-- Circular trace back label -->
			<p class="text-xs text-base-content/35 italic mt-1.5">{ langs.T(ctx, "ui.fire.track.traces_back") }</p>
		</a>
	</div>
}

templ trackCard(instanceID string, t TrackSummary) {
	{{ url := "/strategies/" + instanceID + "/fire/" + t.Track }}
	{{ if t.URL != "" { url = "/strategies/" + instanceID + t.URL } }}
	<a
		href={ templ.URL(url) }
		hx-get={ url }
		hx-target="#tab-content"
		hx-swap="innerHTML"
		hx-push-url="true"
		class="card bg-base-100 border border-base-content/15 shadow-sm hover:shadow-md transition-shadow cursor-pointer"
	>
		<div class="card-body p-4">
			<div class="flex items-center gap-3">
				<div class="rounded-lg bg-primary/10 p-1.5">
					<span class={ "iconify size-5 text-primary " + t.Icon }></span>
				</div>
				<div>
					<h3 class="text-sm font-semibold text-base-content">{ t.Name }</h3>
					<p class="text-xs text-base-content/65">{ fmt.Sprintf(langs.T(ctx, "ui.fire.track.definition_count"), t.Count) }</p>
				</div>
			</div>
		</div>
	</a>
}

templ valueModelBadge(vm ValueModelSummary) {
	<div class="flex items-center gap-2 rounded-lg bg-base-200/50 px-3 py-2">
		<span class={ "iconify size-4 text-base-content/75 " + vm.Icon }></span>
		<span class="text-sm text-base-content">{ vm.Track }</span>
		@featureStatusBadge(vm.Status)
	</div>
}

templ featureList(data FirePhaseData) {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body p-5">
			<h3 class="text-base font-semibold text-base-content mb-3">Features</h3>
			<div class="overflow-x-auto">
				<table class="table table-sm">
					<thead>
						<tr>
							<th>{ langs.T(ctx, "ui.table.key") }</th>
							<th>{ langs.T(ctx, "ui.table.name") }</th>
							<th>{ langs.T(ctx, "ui.table.status") }</th>
						</tr>
					</thead>
					<tbody>
						for _, f := range data.RecentFeatures {
							<tr
								class="hover cursor-pointer"
								hx-get={ "/strategies/" + data.InstanceID + "/artifacts/" + f.Key }
								hx-target="#tab-content"
								hx-swap="innerHTML"
								hx-push-url="true"
							>
								<td class="font-mono text-xs text-base-content/75">{ f.Key }</td>
								<td>{ f.Name }</td>
								<td>@featureStatusBadge(f.Status)</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

templ featureStatusBadge(status string) {
	switch status {
		case "delivered":
			<span class="badge badge-sm badge-success">{ langs.T(ctx, "ui.feature_status.delivered") }</span>
		case "in-progress":
			<span class="badge badge-sm badge-primary">{ langs.T(ctx, "ui.feature_status.in_progress") }</span>
		case "draft":
			<span class="badge badge-sm badge-warning">{ langs.T(ctx, "ui.feature_status.draft") }</span>
		case "ready":
			<span class="badge badge-sm badge-info">{ langs.T(ctx, "ui.feature_status.ready") }</span>
		case "active":
			<span class="badge badge-sm badge-success">{ langs.T(ctx, "ui.feature_status.active") }</span>
		case "placeholder":
			<span class="badge badge-sm badge-ghost">{ langs.T(ctx, "ui.feature_status.placeholder") }</span>
	default:
		<span class="badge badge-sm badge-ghost">{ status }</span>
	}
}

// fireDefinitionsBanner renders a banner when canonical track definitions are missing.
templ fireDefinitionsBanner(data FirePhaseData) {
	<div class="card bg-base-content/3 border border-base-content/15 shadow-sm">
		<div class="card-body p-4">
			<div class="flex items-start justify-between gap-4">
				<div class="flex items-start gap-3">
					<span class="iconify lucide--puzzle size-5 text-base-content/65 mt-0.5 shrink-0"></span>
					<div class="space-y-1.5">
						<p class="text-sm font-semibold">
							{ langs.T(ctx, "ui.fire.defs_banner.title") }
						</p>
						<p class="text-xs text-base-content/80 leading-relaxed max-w-lg">
							The EPF framework includes { strconv.Itoa(data.CanonicalDefCount) } canonical definitions
							across Strategy, Org & Ops, and Commercial tracks. These are process templates
							(hiring, pricing, fundraising, etc.) that structure what each track delivers.
							Currently missing from:
							<strong>{ strings.Join(data.MissingDefTracks, ", ") }</strong>.
						</p>
						<p class="text-xs text-base-content/65 leading-relaxed max-w-lg">
							Installing them gives the AI context about your delivery capabilities
							when aligning value models and generating assessments. Definitions are
							committed directly — no review step needed.
						</p>
					</div>
				</div>
		<form method="POST" action={ templ.URL("/strategies/" + data.InstanceID + "/fire/install-definitions") } class="shrink-0 self-center" onsubmit="let b=this.querySelector('button');b.disabled=true;b.innerHTML='<span class=\'loading loading-spinner loading-xs\'></span> Installing\u2026'">
				<button type="submit" class="btn btn-sm btn-outline">
					<span class="iconify lucide--download size-4"></span>
					{ langs.T(ctx, "ui.fire.defs_banner.install_btn") }
				</button>
			</form>
			</div>
		</div>
	</div>
}

// fireAlignStatusBanner renders a read-only notice when tracks are missing value models.
// Portfolio alignment is now automatic (runs via AIM cycle + periodic consistency check).
// There is no manual align button — this banner just explains the status.
templ fireAlignStatusBanner(data FirePhaseData) {
	<div class="card bg-base-100 border border-base-content/15">
		<div class="card-body p-4">
			<div class="flex items-center gap-3">
				<span class="iconify lucide--layers size-5 text-base-content/55 shrink-0"></span>
				<div>
					<p class="text-sm font-medium text-base-content/80">
						if data.MissingValueModels == len(data.FireTracks) {
							{ langs.T(ctx, "ui.fire.align_banner.no_value_models") }
						} else {
							{ fmt.Sprintf(langs.T(ctx, "ui.fire.align_banner.tracks_missing"), data.MissingValueModels) }
						}
					</p>
					<p class="text-xs text-base-content/65 mt-0.5">
						Value models are aligned automatically when the AIM cycle runs.
						Add <code class="font-mono text-xs">value_model_target</code> fields to your roadmap KRs to drive activation.
					</p>
				</div>
			</div>
		</div>
	</div>
}


