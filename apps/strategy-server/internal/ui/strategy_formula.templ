package ui

import (
	"strconv"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
)

// StrategyFormulaData holds all data for the bespoke Strategy Formula view.
type StrategyFormulaData struct {
	NavContext
	ArtifactKey  string
	Name         string
	Status       string
	Title        string
	LastUpdated  string
	Confidence   string

	ConfidenceRationale string
	NextValidation      []string
	// References to the artifacts this one was derived from (ID, opportunity, foundations, North Star).
	References []RecordFact

	// Positioning
	Category         string
	CategoryPosition string
	PositioningStmt  string
	TargetCustomer   string
	UniqueValue      string
	Taglines         []string

	// Competitive moat
	Differentiation string
	Advantages      []FormulaAdvantage
	VsCompetitors   []FormulaCompetitor
	BarriersToEntry []string

	// Business model
	RevenueModel      string
	PricingStrategy   string
	PricingPhilosophy string
	PricingTiers      []FormulaTier
	UnitEconomics     map[string]string
	UnitEconomicsText string

	// Value creation
	JourneyText  string
	UserJourney  []FormulaJourneyStep
	ValueDrivers []FormulaValueDriver

	// Risks
	Risks []FormulaRisk

	// Trade-offs
	TradeOffs []FormulaTradeOff

	// Success metrics
	NorthStarMetric   string
	SupportingMetrics []FormulaMetric

	// Ecosystem
	EcosystemSummary    string
	VsPointSolutions    string
	EcosystemComponents []FormulaEcoComponent
	EcosystemSynergies  []FormulaSynergy

	// Sections whose entries share one card: positioning summary and options,
	// key capabilities, growth engines, constraints, leading and lagging
	// indicators, expansion vectors and the change log.
	Records []RecordSection

	// Stored content that no section above shows. It is rendered as stored,
	// under a notice, so that nothing in the artifact is dropped silently.
	Unshown map[string]any

	// Section completeness gaps
	Gaps []ReadyGap
}

type FormulaAdvantage struct {
	Name, Description, Evidence, Defensibility string
}
type FormulaCompetitor struct {
	Competitor, TheirStrength, OurAngle, Wedge, Category string
}
type FormulaTier struct {
	Tier, Price, Target, Purpose, Limits string
	Features                             []string
}
type FormulaJourneyStep struct {
	Step, Description, Action, Value, Delight string
}
type FormulaValueDriver struct {
	Driver, Mechanism, Flywheel string
}
type FormulaRisk struct {
	Risk, Impact, Likelihood, Mitigation, Monitoring string
}
type FormulaTradeOff struct {
	Decision, Over, Rationale, WhatWeGain, WhatWeGiveUp string
}
type FormulaMetric struct {
	Metric, Target, Why string
}
type FormulaEcoComponent struct {
	Component, Metaphor, Role, StandaloneValue, EcosystemValue string
}
type FormulaSynergy struct {
	Synergy, How, UniqueToUs string
}

// Slots of the record sections on the page.
const (
	FormulaSlotMoat      = "moat"
	FormulaSlotValue     = "value"
	FormulaSlotBusiness  = "business"
	FormulaSlotTradeOffs = "tradeoffs"
	FormulaSlotMetrics   = "metrics"
	FormulaSlotEcosystem = "ecosystem"
	FormulaSlotLog       = "log"
)

// Kinds of record section. Each has a title, icon and slot in formulaRecordStyles.
const (
	FormulaKindPositioningSummary = "positioning_summary"
	FormulaKindPositioningOptions = "positioning_options"
	FormulaKindCapabilities       = "key_capabilities"
	FormulaKindGrowthEngines      = "growth_engines"
	FormulaKindConstraints        = "constraints"
	FormulaKindLeadingIndicators  = "leading_indicators"
	FormulaKindLaggingIndicators  = "lagging_indicators"
	FormulaKindExpansionVectors   = "expansion_vectors"
	FormulaKindChangeLog          = "change_log"
)

var formulaRecordStyles = map[string]RecordStyle{
	FormulaKindPositioningSummary: {FormulaSlotMoat, "Competitive Positioning", "lucide--map-pin", "primary"},
	FormulaKindPositioningOptions: {FormulaSlotMoat, "Positioning Options", "lucide--signpost", "primary"},
	FormulaKindCapabilities:       {FormulaSlotValue, "Key Capabilities", "lucide--wrench", "accent"},
	FormulaKindGrowthEngines:      {FormulaSlotBusiness, "Growth Engines", "lucide--rocket", "warning"},
	FormulaKindConstraints:        {FormulaSlotTradeOffs, "Constraints", "lucide--lock", "warning"},
	FormulaKindLeadingIndicators:  {FormulaSlotMetrics, "Leading Indicators", "lucide--gauge", "info"},
	FormulaKindLaggingIndicators:  {FormulaSlotMetrics, "Lagging Indicators", "lucide--chart-line", "info"},
	FormulaKindExpansionVectors:   {FormulaSlotEcosystem, "Expansion Vectors", "lucide--expand", "secondary"},
	FormulaKindChangeLog:          {FormulaSlotLog, "Change Log", "lucide--history", "neutral"},
}

func (d StrategyFormulaData) hasRecords(slot string) bool {
	return recordsInSlot(formulaRecordStyles, d.Records, slot)
}

func (d StrategyFormulaData) hasPositioning() bool {
	return d.PositioningStmt != "" || d.CategoryPosition != "" || d.Category != "" || d.TargetCustomer != "" ||
		d.UniqueValue != "" || len(d.Taglines) > 0
}

func (d StrategyFormulaData) hasMoat() bool {
	return d.Differentiation != "" || len(d.BarriersToEntry) > 0 || len(d.Advantages) > 0 ||
		len(d.VsCompetitors) > 0 || d.hasRecords(FormulaSlotMoat)
}

func (d StrategyFormulaData) hasValueCreation() bool {
	return d.JourneyText != "" || len(d.UserJourney) > 0 || len(d.ValueDrivers) > 0 || d.hasRecords(FormulaSlotValue)
}

func (d StrategyFormulaData) hasBusinessModel() bool {
	return d.RevenueModel != "" || d.PricingStrategy != "" || d.PricingPhilosophy != "" || len(d.PricingTiers) > 0 ||
		len(d.UnitEconomics) > 0 || d.UnitEconomicsText != "" || d.hasRecords(FormulaSlotBusiness)
}

func (d StrategyFormulaData) hasMetrics() bool {
	return d.NorthStarMetric != "" || len(d.SupportingMetrics) > 0 || d.hasRecords(FormulaSlotMetrics)
}

func (d StrategyFormulaData) hasEcosystem() bool {
	return d.EcosystemSummary != "" || d.VsPointSolutions != "" || len(d.EcosystemComponents) > 0 ||
		len(d.EcosystemSynergies) > 0 || d.hasRecords(FormulaSlotEcosystem)
}

templ StrategyFormulaContent(data StrategyFormulaData) {
	@TabBackLink(data.TabGroup, data.InstanceID, data.CurrentPath)
	<div class="space-y-8">
		@detailGapBanner(data.Gaps)
		// ── Hero ──
		<div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-secondary/10 via-base-100 to-accent/10 border border-secondary/10">
			<div class="px-6 py-8 sm:px-8">
				<div class="flex items-start justify-between">
					<div class="space-y-2">
						<div class="flex items-center gap-2">
							<span class="iconify lucide--brain size-5 text-secondary"></span>
							<span class="text-xs font-semibold uppercase tracking-widest text-secondary">{ langs.T(ctx, "artifact.label.strategy_formula") }</span>
							if data.Status != "" {
								@artifactStatusBadge(data.Status)
							}
							if data.Confidence != "" {
								<span class="tooltip" data-tip={ confidenceHint(data.Confidence) }><span class={ "badge badge-sm", confidenceBadgeClass(data.Confidence) }>{ data.Confidence } confidence</span></span>
							}
						</div>
						<h1 class="text-2xl font-bold text-base-content sm:text-3xl">{ data.Title }</h1>
						if len(data.References) > 0 {
							<p class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-base-content/75">
								for _, ref := range data.References {
									<span><span class="font-medium">{ ref.Label }:</span> <span class="font-mono">{ ref.Value }</span></span>
								}
							</p>
						}
						if data.ConfidenceRationale != "" {
							<p class="text-sm text-base-content/80 max-w-3xl">{ data.ConfidenceRationale }</p>
						}
						if len(data.NextValidation) > 0 {
							<div class="pt-1">
								<p class="text-xs font-semibold uppercase tracking-wide text-base-content/75 mb-1">Next validation needed</p>
								<div class="flex flex-wrap gap-1">
									for _, v := range data.NextValidation {
										<span class="badge badge-sm badge-outline badge-secondary">{ v }</span>
									}
								</div>
							</div>
						}
					</div>
					if data.LastUpdated != "" {
				<div class="hidden sm:block text-right text-xs text-base-content/75">
						<p>Updated { data.LastUpdated }</p>
					</div>
					}
				</div>
			</div>
		</div>

		// ── Positioning ──
		if data.hasPositioning() {
			<section>
				@sectionHeading("Positioning", "lucide--crosshair", "secondary", data.CategoryPosition)
				<div class="mt-4 space-y-4">
					if data.PositioningStmt != "" {
						<div class="rounded-xl bg-gradient-to-r from-secondary/5 to-transparent border border-secondary/10 p-5">
							<blockquote class="text-base text-base-content leading-relaxed italic">{ data.PositioningStmt }</blockquote>
						</div>
					}
					<div class="grid gap-4 md:grid-cols-2">
						if data.Category != "" {
							@editorialCard("Category", data.Category, "lucide--tag")
						}
						if data.TargetCustomer != "" {
							@editorialCard("Target Customer", data.TargetCustomer, "lucide--users")
						}
						if data.UniqueValue != "" {
							@editorialCard("Unique Value", data.UniqueValue, "lucide--sparkles")
						}
					</div>
					if len(data.Taglines) > 0 {
						<div class="flex flex-wrap gap-2">
							for _, t := range data.Taglines {
								<span class="badge badge-outline badge-secondary">{ t }</span>
							}
						</div>
					}
				</div>
			</section>
		}

		// ── Competitive Moat ──
		if data.hasMoat() {
			<section>
				@sectionHeading("Competitive Moat", "lucide--shield", "primary", data.Differentiation)
				<div class="mt-4 space-y-4">
					if len(data.Advantages) > 0 {
						<h4 class="text-sm font-semibold text-base-content/80">Advantages</h4>
						<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
							for _, a := range data.Advantages {
								<div class="card bg-base-100 border border-base-content/15 shadow-sm">
									<div class="card-body p-4">
										<h5 class="text-sm font-bold text-base-content">{ a.Name }</h5>
										if a.Description != "" {
											<p class="text-xs text-base-content/80 mt-1">{ a.Description }</p>
										}
										if a.Evidence != "" {
											<p class="text-xs text-base-content/75 mt-1"><span class="font-medium">Evidence:</span> { a.Evidence }</p>
										}
										if a.Defensibility != "" {
											<div class="mt-2">
												<span class="badge badge-xs badge-outline badge-primary">{ a.Defensibility }</span>
											</div>
										}
									</div>
								</div>
							}
						</div>
					}
					if len(data.BarriersToEntry) > 0 {
						<h4 class="text-sm font-semibold text-base-content/80 mt-2">Barriers to entry</h4>
						<div class="flex flex-wrap gap-2">
							for _, b := range data.BarriersToEntry {
								<span class="badge badge-outline badge-primary h-auto whitespace-normal py-1">{ b }</span>
							}
						</div>
					}
					if len(data.VsCompetitors) > 0 {
						<h4 class="text-sm font-semibold text-base-content/80 mt-2">vs Competitors</h4>
						<div class="space-y-2">
							for _, c := range data.VsCompetitors {
								@competitorRow(c)
							}
						</div>
					}
					@RecordSections(formulaRecordStyles, data.Records, FormulaSlotMoat)
				</div>
			</section>
		}

		// ── Value Creation Journey ──
		if data.hasValueCreation() {
			<section>
				@sectionHeading("Value Creation", "lucide--route", "accent", "How users experience value")
				if data.JourneyText != "" {
					<p class="mt-4 text-sm text-base-content/80 leading-relaxed">{ data.JourneyText }</p>
				}
				if len(data.UserJourney) > 0 {
					<div class="mt-4">
						<div class="flex flex-col gap-0">
							for i, step := range data.UserJourney {
								@journeyStep(step, i, len(data.UserJourney))
							}
						</div>
					</div>
				}
				if len(data.ValueDrivers) > 0 {
					<div class="mt-6 grid gap-3 md:grid-cols-3">
						for _, d := range data.ValueDrivers {
							<div class="card bg-base-100 border border-base-content/15 shadow-sm">
								<div class="card-body p-4">
									<h5 class="text-sm font-bold text-base-content">{ d.Driver }</h5>
									if d.Mechanism != "" {
										<p class="text-xs text-base-content/80 mt-1">{ d.Mechanism }</p>
									}
									if d.Flywheel != "" {
										<p class="text-xs text-accent/70 mt-2 italic">{ d.Flywheel }</p>
									}
								</div>
							</div>
						}
					</div>
				}
				@RecordSections(formulaRecordStyles, data.Records, FormulaSlotValue)
			</section>
		}

		// ── Business Model ──
		if data.hasBusinessModel() {
			<section>
				@sectionHeading("Business Model", "lucide--wallet", "warning", data.RevenueModel)
				<div class="mt-4 space-y-4">
					if data.PricingStrategy != "" {
						<p class="text-sm text-base-content/80 leading-relaxed">{ data.PricingStrategy }</p>
					}
					if data.PricingPhilosophy != "" {
						<p class="text-sm text-base-content/80 leading-relaxed">{ data.PricingPhilosophy }</p>
					}
					if len(data.PricingTiers) > 0 {
						<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
							for _, t := range data.PricingTiers {
								@tierCard(t)
							}
						</div>
					}
					if data.UnitEconomicsText != "" {
						<div class="card bg-base-100 border border-base-content/15 shadow-sm">
							<div class="card-body p-4">
								<h4 class="text-xs font-semibold uppercase tracking-wide text-base-content/80 mb-2">Unit Economics</h4>
								<p class="text-sm text-base-content/80 leading-relaxed">{ data.UnitEconomicsText }</p>
							</div>
						</div>
					}
					if len(data.UnitEconomics) > 0 {
						<div class="card bg-base-100 border border-base-content/15 shadow-sm">
							<div class="card-body p-4">
								<h4 class="text-xs font-semibold uppercase tracking-wide text-base-content/80 mb-3">Unit Economics Targets</h4>
								<div class="flex flex-wrap gap-4">
									for _, k := range sortedMapKeys(data.UnitEconomics) {
										<div class="text-center">
											<p class="text-lg font-bold text-base-content">{ data.UnitEconomics[k] }</p>
											<p class="text-xs text-base-content/80">{ k }</p>
										</div>
									}
								</div>
							</div>
						</div>
					}
					@RecordSections(formulaRecordStyles, data.Records, FormulaSlotBusiness)
				</div>
			</section>
		}

		// ── Risks ──
		if len(data.Risks) > 0 {
			<section>
				@sectionHeading("Risks", "lucide--alert-triangle", "error", strconv.Itoa(len(data.Risks)) + " identified risks")
				<div class="mt-4 space-y-2">
					for _, r := range data.Risks {
						@riskRow(r)
					}
				</div>
			</section>
		}

		// ── Trade-offs ──
		if len(data.TradeOffs) > 0 {
			<section>
				@sectionHeading("Trade-offs", "lucide--scale", "warning", "Conscious strategic decisions")
				<div class="mt-4 space-y-3">
					for _, t := range data.TradeOffs {
						@tradeOffCard(t)
					}
				</div>
			</section>
		}
		@RecordSections(formulaRecordStyles, data.Records, FormulaSlotTradeOffs)

		// ── Success Metrics ──
		if data.hasMetrics() {
			<section>
				@sectionHeading("Success Metrics", "lucide--bar-chart-3", "info", "")
				<div class="mt-4 space-y-4">
					if data.NorthStarMetric != "" {
						<div class="rounded-xl bg-gradient-to-r from-info/5 to-transparent border border-info/10 p-5">
							<p class="text-xs font-semibold uppercase tracking-wide text-info mb-1">North Star Metric</p>
							<p class="text-sm text-base-content leading-relaxed">{ data.NorthStarMetric }</p>
						</div>
					}
					if len(data.SupportingMetrics) > 0 {
						<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
							for _, m := range data.SupportingMetrics {
								<div class="card bg-base-100 border border-base-content/15 shadow-sm">
									<div class="card-body p-3">
										<p class="text-sm font-medium text-base-content">{ m.Metric }</p>
										if m.Target != "" {
											<p class="text-xs text-accent font-mono mt-1">{ m.Target }</p>
										}
								if m.Why != "" {
									<p class="text-xs text-base-content/80 mt-1">{ m.Why }</p>
								}
									</div>
								</div>
							}
						</div>
					}
					@RecordSections(formulaRecordStyles, data.Records, FormulaSlotMetrics)
				</div>
			</section>
		}

		// ── Ecosystem ──
		if data.hasEcosystem() {
			<section>
				@sectionHeading("Ecosystem", "lucide--network", "secondary", data.EcosystemSummary)
				if data.VsPointSolutions != "" {
					<p class="mt-4 text-sm text-base-content/80 leading-relaxed"><span class="font-medium">Versus point solutions:</span> { data.VsPointSolutions }</p>
				}
				if len(data.EcosystemComponents) > 0 {
					<div class="mt-4 grid gap-4 lg:grid-cols-3">
						for _, comp := range data.EcosystemComponents {
							@ecoComponentCard(comp)
						}
					</div>
				}
				if len(data.EcosystemSynergies) > 0 {
					<div class="mt-4 space-y-2">
						for _, syn := range data.EcosystemSynergies {
							<div class="rounded-lg bg-base-100 px-4 py-3">
								<p class="text-sm font-medium text-base-content">{ syn.Synergy }</p>
								if syn.How != "" {
									<p class="text-xs text-base-content/80 mt-1">{ syn.How }</p>
								}
								if syn.UniqueToUs != "" {
									<p class="text-xs text-base-content/80 mt-1"><span class="font-medium">Unique to us:</span> { syn.UniqueToUs }</p>
								}
							</div>
						}
					</div>
				}
				@RecordSections(formulaRecordStyles, data.Records, FormulaSlotEcosystem)
			</section>
		}

		@RecordSections(formulaRecordStyles, data.Records, FormulaSlotLog)
		@StoredNotShown(data.Unshown)
	</div>
}

// ── Formula sub-components ──

templ competitorRow(c FormulaCompetitor) {
	<div class="rounded-lg border border-base-content/12 bg-base-100 px-4 py-3">
		<div class="flex items-start gap-4">
			<div class="min-w-0 grow">
				<p class="text-sm font-semibold text-base-content">vs { c.Competitor }</p>
				if c.Category != "" {
					<p class="text-xs text-base-content/65">{ c.Category }</p>
				}
					<div class="grid gap-x-6 gap-y-1 md:grid-cols-2 mt-1 text-xs text-base-content/80">
				if c.TheirStrength != "" {
					<span><span class="font-medium text-base-content/75">Their strength:</span> { c.TheirStrength }</span>
					}
					if c.OurAngle != "" {
						<span><span class="font-medium text-accent/70">Our angle:</span> { c.OurAngle }</span>
					}
				</div>
			</div>
			if c.Wedge != "" {
				<span class="badge badge-xs badge-outline badge-accent shrink-0">{ c.Wedge }</span>
			}
		</div>
	</div>
}

templ journeyStep(step FormulaJourneyStep, idx, total int) {
	<div class="flex items-start gap-4">
		// Vertical connector
		<div class="flex flex-col items-center">
			<div class="flex items-center justify-center size-7 rounded-full bg-accent/10 text-accent text-xs font-bold shrink-0">
				{ strconv.Itoa(idx + 1) }
			</div>
			if idx < total-1 {
				<div class="w-0.5 h-8 bg-accent/20"></div>
			}
		</div>
		<div class="pb-4 min-w-0">
			<p class="text-sm font-semibold text-base-content">{ step.Step }</p>
			if step.Description != "" {
				<p class="text-xs text-base-content/80 mt-0.5">{ step.Description }</p>
			}
			if step.Action != "" {
				<p class="text-xs text-base-content/80 mt-0.5">{ step.Action }</p>
			}
			if step.Value != "" {
				<p class="text-xs text-accent/70 mt-0.5">{ step.Value }</p>
			}
			if step.Delight != "" {
				<p class="text-xs text-base-content/75 mt-0.5 italic">{ step.Delight }</p>
			}
		</div>
	</div>
}

templ tierCard(t FormulaTier) {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body p-4 text-center">
			<h5 class="text-sm font-bold text-base-content">{ t.Tier }</h5>
			if t.Price != "" {
				<p class="text-lg font-bold text-accent mt-1">{ t.Price }</p>
			}
			if t.Target != "" {
				<p class="text-xs text-base-content/80 mt-1">{ t.Target }</p>
			}
			if t.Purpose != "" {
				<p class="text-xs text-base-content/80 mt-1">{ t.Purpose }</p>
			}
			if t.Limits != "" {
				<p class="text-xs text-base-content/75 mt-1">{ t.Limits }</p>
			}
			if len(t.Features) > 0 {
				<div class="flex flex-wrap justify-center gap-1 mt-2">
					for _, f := range t.Features {
						<span class="badge badge-xs badge-ghost">{ f }</span>
					}
				</div>
			}
		</div>
	</div>
}

templ riskRow(r FormulaRisk) {
	<details class="group rounded-lg border border-base-content/15 bg-base-100 shadow-sm">
		<summary class="flex cursor-pointer items-center gap-3 px-4 py-3 text-sm select-none">
			<span class={ "size-2 rounded-full shrink-0", likelihoodDot(r.Likelihood) }></span>
			<span class="grow font-medium text-base-content">{ r.Risk }</span>
			if r.Likelihood != "" {
				<span class="flex items-center gap-1 shrink-0 text-xs text-base-content/65">
					<span>Likelihood</span>
					<span class={ "badge badge-xs", likelihoodBadge(r.Likelihood) }>{ r.Likelihood }</span>
				</span>
			}
			if r.Impact != "" {
				<span class="flex items-center gap-1 shrink-0 text-xs text-base-content/65">
					<span>Impact</span>
					<span class={ "badge badge-xs", likelihoodBadge(r.Impact) }>{ r.Impact }</span>
				</span>
			}
			<span class="iconify lucide--chevron-right size-3.5 text-base-content/30 transition-transform group-open:rotate-90"></span>
		</summary>
		<div class="border-t border-base-content/5 px-4 pb-3 pt-2 text-xs text-base-content/80 space-y-1">
		if r.Mitigation != "" {
			<p><span class="font-medium text-base-content/75">Mitigation:</span> { r.Mitigation }</p>
		}
		if r.Monitoring != "" {
			<p><span class="font-medium text-base-content/75">Monitoring:</span> { r.Monitoring }</p>
			}
		</div>
	</details>
}

templ tradeOffCard(t FormulaTradeOff) {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body p-4">
			<p class="text-sm font-semibold text-base-content">{ t.Decision }</p>
			if t.Over != "" {
				<p class="text-xs text-base-content/75 mt-0.5"><span class="font-medium">Over:</span> { t.Over }</p>
			}
		if t.Rationale != "" {
			<p class="text-xs text-base-content/80 mt-1">{ t.Rationale }</p>
			}
			<div class="grid gap-4 md:grid-cols-2 mt-3">
				if t.WhatWeGain != "" {
					<div class="flex items-start gap-2">
						<span class="iconify lucide--plus-circle size-3.5 text-success mt-0.5 shrink-0"></span>
						<span class="text-xs text-base-content/80">{ t.WhatWeGain }</span>
					</div>
				}
				if t.WhatWeGiveUp != "" {
					<div class="flex items-start gap-2">
						<span class="iconify lucide--minus-circle size-3.5 text-error mt-0.5 shrink-0"></span>
						<span class="text-xs text-base-content/80">{ t.WhatWeGiveUp }</span>
					</div>
				}
			</div>
		</div>
	</div>
}

templ ecoComponentCard(comp FormulaEcoComponent) {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body p-4">
			<div class="flex items-center gap-2 mb-2">
				<span class="iconify lucide--component size-4 text-secondary"></span>
				<h5 class="text-sm font-bold text-base-content">{ comp.Component }</h5>
			</div>
		if comp.Metaphor != "" {
			<p class="text-xs text-secondary italic mb-2">{ comp.Metaphor }</p>
			}
		if comp.Role != "" {
			<p class="text-xs text-base-content/80">{ comp.Role }</p>
			}
			if comp.StandaloneValue != "" || comp.EcosystemValue != "" {
				<div class="mt-2 pt-2 border-t border-base-content/5 space-y-1">
					if comp.StandaloneValue != "" {
						<p class="text-xs text-base-content/80"><span class="font-medium">Standalone value:</span> { comp.StandaloneValue }</p>
					}
					if comp.EcosystemValue != "" {
						<p class="text-xs text-base-content/80"><span class="font-medium">Ecosystem value:</span> { comp.EcosystemValue }</p>
					}
				</div>
			}
		</div>
	</div>
}
