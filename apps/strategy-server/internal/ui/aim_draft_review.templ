package ui

import (
	"context"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
)

// AimDraftReviewData holds data for the AI draft review screen.
type AimDraftReviewData struct {
	NavContext

	InstanceID     string
	BatchID        string
	Description    string // batch description
	ArtifactType   string // predominant artifact type in the batch
	Items          []AimDraftReviewItem
	PreviewContent templ.Component // optional: rendered preview of the draft artifact (legacy, used when single item)
	Previews       []AimDraftPreview // multi-artifact previews — one per previewable mutation
}

// AimDraftPreview is a single rich preview panel for one artifact in the batch.
type AimDraftPreview struct {
	ArtifactType string
	ArtifactKey  string
	Content      templ.Component
}

// AimDraftReviewItem is a single staged mutation shown in the review screen.
type AimDraftReviewItem struct {
	ArtifactType  string
	ArtifactKey   string
	Action        string          // create | update | archive
	ChangeSummary string          // AI-generated summary of what changed (bullet points)
	Preview       templ.Component // optional: bespoke rendered preview of the draft artifact
}

// AimDraftReviewContent renders the AI draft review screen.
templ AimDraftReviewContent(data AimDraftReviewData) {
	@StepBackLink(data.NavContext)
	<div class="space-y-6">
		// Header card with integrated actions
		<div class="rounded-xl border border-primary/30 bg-primary/5 px-6 py-5">
			<div class="flex items-start gap-4">
				<span class="iconify lucide--sparkles size-6 text-primary mt-0.5 shrink-0"></span>
				<div class="grow min-w-0">
					<p class="text-xs font-semibold uppercase tracking-widest text-primary/70 mb-1">{ langs.T(ctx, "page.draft_review") }</p>
					<p class="text-sm text-base-content leading-relaxed">
						if data.Description != "" {
							{ data.Description }
						} else {
							This batch was drafted by the AIM agent. Review the contents below before committing.
						}
					</p>
				</div>
			</div>
			// Commit / Discard actions — always visible in the header
			<div class="flex items-center justify-between gap-4 mt-4 pt-4 border-t border-primary/15">
				<p class="text-xs text-base-content/65">
					if len(data.Items) > 1 {
						All { itemCountLabel(len(data.Items)) } will be committed or discarded together.
					} else {
						Committing applies this change to your strategy.
					}
				</p>
				<div class="flex items-center gap-3 shrink-0">
					<form method="POST" action={ templ.URL("/strategies/" + data.InstanceID + "/aim/draft-review/" + data.BatchID + "/discard") }>
						<button type="submit" class="btn btn-sm btn-ghost text-error">
							<span class="iconify lucide--trash-2 size-3.5"></span>
							{ langs.T(ctx, "action.discard") }
						</button>
					</form>
					<form method="POST" action={ templ.URL("/strategies/" + data.InstanceID + "/aim/draft-review/" + data.BatchID + "/commit") }>
						<button type="submit" class="btn btn-sm btn-primary gap-2">
							<span class="iconify lucide--check size-3.5"></span>
							{ langs.T(ctx, "action.commit") }
						</button>
					</form>
				</div>
			</div>
		</div>

		// Unified list — each item shows its summary, change description, and
		// an expandable preview. No separate sections.
		if len(data.Items) == 0 {
			<div class="card bg-base-100 border border-base-content/15 shadow-sm">
				<div class="card-body p-5">
					<div class="text-center py-8">
						<span class="iconify lucide--file-question size-10 text-base-content/30 mx-auto mb-3 block"></span>
						<p class="text-sm text-base-content/75">No staged mutations found in this batch.</p>
					</div>
				</div>
			</div>
		} else {
			<div class="space-y-3">
				for _, item := range data.Items {
					@aimDraftReviewItem(item)
				}
			</div>
		}

		// Legacy single-preview fallback (when items don't carry inline previews).
		if len(data.Previews) == 0 && data.PreviewContent != nil {
			<div class="rounded-xl border border-base-content/15 bg-base-100 overflow-hidden">
				<div class="px-6 py-3 border-b border-base-content/15 bg-base-100">
					<p class="text-xs font-semibold uppercase tracking-widest text-base-content/65">Draft Preview</p>
				</div>
				<div class="p-4">
					@data.PreviewContent
				</div>
			</div>
		}
	</div>
}

// aimDraftReviewItem renders a single staged mutation with change summary and
// an inline expandable preview.
templ aimDraftReviewItem(item AimDraftReviewItem) {
	<div class="rounded-xl border border-base-content/15 bg-base-100 overflow-hidden">
		// Header row — artifact name, action badge
		<div class="flex items-center gap-3 px-5 py-3">
			<span class={ "iconify size-4 shrink-0", draftActionIcon(item.Action), draftActionColor(item.Action) }></span>
			<div class="grow min-w-0">
				<p class="text-sm font-semibold text-base-content">{ artifactTypeLabelI18n(ctx, item.ArtifactType) }</p>
			</div>
			<span class="tooltip shrink-0" data-tip={ draftActionHint(item.Action) }><span class={ "badge badge-sm", draftActionBadgeClass(item.Action) }>{ item.Action }</span></span>
		</div>
		// Change summary — what the AI changed
		if item.ChangeSummary != "" {
			<div class="px-5 pb-3">
				<div class="pl-7 border-l-2 border-primary/20">
					<p class="text-xs text-base-content/80 whitespace-pre-line leading-relaxed">{ item.ChangeSummary }</p>
				</div>
			</div>
		}
		// Expandable full preview
		if item.Preview != nil {
			<details class="group">
				<summary class="flex items-center justify-between gap-3 px-5 py-2.5 border-t border-base-content/5 bg-base-100 cursor-pointer select-none list-none text-xs text-base-content/65 hover:text-base-content/80">
					<div class="flex items-center gap-2">
						<span class="iconify lucide--eye size-3.5"></span>
						<span>View full draft</span>
					</div>
					<span class="iconify lucide--chevron-down size-3.5 group-open:rotate-180 transition-transform"></span>
				</summary>
				<div class="border-t border-base-content/5 p-4">
					@item.Preview
				</div>
			</details>
		}
	</div>
}

func draftActionIcon(action string) string {
	switch action {
	case "create":
		return "lucide--plus-circle"
	case "update":
		return "lucide--pencil"
	case "archive":
		return "lucide--archive"
	default:
		return "lucide--file"
	}
}

func draftActionColor(action string) string {
	switch action {
	case "create":
		return "text-success"
	case "update":
		return "text-primary"
	case "archive":
		return "text-warning"
	default:
		return "text-base-content/65"
	}
}

func draftActionHint(action string) string {
	switch action {
	case "create":
		return "New artifact will be created"
	case "update":
		return "Existing artifact will be updated with changes"
	case "archive":
		return "Artifact will be archived and no longer active"
	default:
		return action
	}
}

func draftActionBadgeClass(action string) string {
	switch action {
	case "create":
		return "badge-success"
	case "update":
		return "badge-info"
	case "archive":
		return "badge-warning"
	default:
		return "badge-ghost"
	}
}

// artifactTypeLabel returns a human-readable label for an artifact type string.
func artifactTypeLabel(t string) string {
	switch t {
	case "north_star":
		return "North Star"
	case "strategy_foundations":
		return "Strategy Foundations"
	case "insight_analyses":
		return "Insight Analyses"
	case "insight_opportunity":
		return "Insight Opportunity"
	case "strategy_formula":
		return "Strategy Formula"
	case "roadmap_recipe":
		return "Roadmap Recipe"
	case "living_reality_assessment":
		return "Living Reality Assessment"
	case "assessment_report":
		return "Assessment Report"
	case "calibration_memo":
		return "Calibration Memo"
	case "feature":
		return "Feature"
	case "value_model":
		return "Value Model"
	default:
		// Fallback: replace underscores with spaces.
		out := []byte(t)
		for i, b := range out {
			if b == '_' {
				out[i] = ' '
			}
		}
		return string(out)
	}
}

// artifactTypeLabelI18n returns a translated human-readable label for an artifact type string.
func artifactTypeLabelI18n(ctx context.Context, t string) string {
	switch t {
	case "north_star":
		return langs.T(ctx, "artifact.label.north_star")
	case "strategy_foundations":
		return langs.T(ctx, "artifact.label.strategy_foundations")
	case "insight_analyses":
		return langs.T(ctx, "artifact.label.insight_analyses")
	case "insight_opportunity":
		return langs.T(ctx, "artifact.label.insight_opportunity")
	case "strategy_formula":
		return langs.T(ctx, "artifact.label.strategy_formula")
	case "roadmap_recipe":
		return langs.T(ctx, "artifact.label.roadmap_recipe")
	case "living_reality_assessment":
		return langs.T(ctx, "artifact.label.living_reality_assessment")
	case "assessment_report":
		return langs.T(ctx, "artifact.label.assessment_report")
	case "calibration_memo":
		return langs.T(ctx, "artifact.label.calibration_memo")
	default:
		return artifactTypeLabel(t)
	}
}

func itemCountLabel(n int) string {
	if n == 1 {
		return "1 item"
	}
	return itoa(n) + " items"
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	result := ""
	neg := n < 0
	if neg {
		n = -n
	}
	for n > 0 {
		result = string(rune('0'+n%10)) + result
		n /= 10
	}
	if neg {
		result = "-" + result
	}
	return result
}
