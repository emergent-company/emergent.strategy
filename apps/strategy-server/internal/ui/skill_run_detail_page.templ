package ui

import "fmt"

// SkillRunDetailData holds data for a single skill run detail page.
type SkillRunDetailData struct {
	Nav NavContext

	RunID             string
	SkillName         string
	Status            string
	Trigger           string
	Model             string
	ChunksCompleted   int
	ChunkCount        int
	TotalInputTokens  int
	TotalOutputTokens int
	DurationSec       float64
	StartedAt         string
	CompletedAt       string
	Error             string
	BatchID           string

	// Per-chunk log
	Chunks []SkillRunChunkRow
}

// SkillRunChunkRow is a single chunk entry from the chunk_log.
type SkillRunChunkRow struct {
	Chunk            int
	OutputKey        string
	ArtifactType     string
	Status           string // staged | failed
	Attempts         int
	InputTokens      int
	OutputTokens     int
	ContextTruncated bool
	DroppedFeatures  int
	Errors           []string
	Duration         string // formatted
}

// SkillRunDetailContent renders the skill run detail page.
templ SkillRunDetailContent(data SkillRunDetailData) {
	@TabRelatedPages("execution", data.Nav.InstanceID, data.Nav.CurrentPath)
	<div class="space-y-6">
		// Back link
		<a
			href={ templ.URL("/strategies/" + data.Nav.InstanceID + "/skill-runs") }
			hx-get={ "/strategies/" + data.Nav.InstanceID + "/skill-runs" }
			hx-target="#tab-content"
			hx-swap="innerHTML"
			hx-push-url="true"
			class="inline-flex items-center gap-1.5 text-xs text-base-content/65 hover:text-base-content transition-colors"
		>
			<span class="iconify lucide--arrow-left size-3"></span>
			Back to Skill Runs
		</a>

		// Header
		<div class="rounded-xl border border-base-content/15 bg-base-100 shadow-sm px-6 py-5">
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-3">
					<span class={ "iconify size-5", cascadeRunIcon(data.Status), cascadeRunIconColor(data.Status) }></span>
					<div>
						<p class="text-lg font-bold text-base-content">{ cascadeSkillLabel(data.SkillName) }</p>
						<div class="flex items-center gap-3 mt-1 text-xs text-base-content/65">
							@cascadeTriggerBadge(data.Trigger)
							if data.Model != "" {
								<span class="flex items-center gap-1">
									<span class="iconify lucide--brain size-3"></span>
									{ data.Model }
								</span>
							}
							if data.StartedAt != "" {
								<span>{ data.StartedAt }</span>
							}
						</div>
					</div>
				</div>
				<div class="flex items-center gap-3">
					@skillRunStatusBadge(data.Status)
					if data.BatchID != "" {
						<a
							href={ templ.URL("/strategies/" + data.Nav.InstanceID + "/aim/draft-review/" + data.BatchID) }
							class="btn btn-xs btn-primary"
						>Review draft</a>
					}
				</div>
			</div>

			// Error row
			if data.Error != "" {
				<div class="mt-3 rounded-lg bg-error/10 border border-error/20 px-4 py-2 text-sm text-error">
					{ data.Error }
				</div>
			}
		</div>

		// Stats row
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
			<div class="rounded-xl border border-base-content/15 bg-base-100 px-5 py-4">
				<p class="text-xs font-semibold uppercase tracking-widest text-base-content/65">Chunks</p>
				<p class="text-xl font-bold text-base-content mt-1">{ itoa(data.ChunksCompleted) } / { itoa(data.ChunkCount) }</p>
			</div>
			<div class="rounded-xl border border-base-content/15 bg-base-100 px-5 py-4">
				<p class="text-xs font-semibold uppercase tracking-widest text-base-content/65">Input Tokens</p>
				<p class="text-xl font-bold text-base-content mt-1">{ formatTokens(data.TotalInputTokens) }</p>
			</div>
			<div class="rounded-xl border border-base-content/15 bg-base-100 px-5 py-4">
				<p class="text-xs font-semibold uppercase tracking-widest text-base-content/65">Output Tokens</p>
				<p class="text-xl font-bold text-base-content mt-1">{ formatTokens(data.TotalOutputTokens) }</p>
			</div>
			<div class="rounded-xl border border-base-content/15 bg-base-100 px-5 py-4">
				<p class="text-xs font-semibold uppercase tracking-widest text-base-content/65">Duration</p>
				<p class="text-xl font-bold text-base-content mt-1">
					if data.DurationSec > 0 {
						{ formatDuration(data.DurationSec) }
					} else {
						—
					}
				</p>
			</div>
		</div>

		// Chunk log
		if len(data.Chunks) > 0 {
			<div class="rounded-xl border border-base-content/15 bg-base-100 overflow-hidden">
				<div class="px-5 py-3 border-b border-base-content/5">
					<p class="text-xs font-semibold uppercase tracking-widest text-base-content/65">Chunk Log</p>
				</div>
				<div class="divide-y divide-base-content/5">
					for _, chunk := range data.Chunks {
						@skillRunChunkRow(chunk)
					}
				</div>
			</div>
		}
	</div>
}

templ skillRunChunkRow(chunk SkillRunChunkRow) {
	<div class={ "px-5 py-4", templ.KV("bg-error/5", chunk.Status == "failed") }>
		<div class="flex items-start justify-between gap-4">
			// Left: chunk info
			<div class="min-w-0 grow space-y-1">
				<div class="flex items-center gap-2">
					<span class={ "font-mono text-xs font-bold", templ.KV("text-success", chunk.Status == "staged"), templ.KV("text-error", chunk.Status == "failed") }>
						#{ itoa(chunk.Chunk) }
					</span>
					if chunk.OutputKey != "" {
						<span class="text-sm font-medium text-base-content">{ chunk.OutputKey }</span>
					}
					if chunk.ArtifactType != "" {
						<span class="badge badge-xs badge-ghost">{ chunk.ArtifactType }</span>
					}
					if chunk.Status == "staged" {
						<span class="iconify lucide--check size-3.5 text-success"></span>
					} else if chunk.Status == "failed" {
						<span class="iconify lucide--x size-3.5 text-error"></span>
					}
				</div>
				// Truncation warning
				if chunk.ContextTruncated && chunk.DroppedFeatures > 0 {
					<div class="flex items-center gap-1.5 text-xs text-warning">
						<span class="iconify lucide--alert-triangle size-3"></span>
						{ fmt.Sprintf("%d features dropped from context", chunk.DroppedFeatures) }
					</div>
				}
				// Errors
				if len(chunk.Errors) > 0 {
					<div class="space-y-0.5">
						for _, errMsg := range chunk.Errors {
							<p class="text-xs text-error/80">{ errMsg }</p>
						}
					</div>
				}
			</div>
			// Right: stats
			<div class="flex items-center gap-4 text-xs text-base-content/65 shrink-0">
				if chunk.Attempts > 1 {
					<span class="flex items-center gap-1 text-warning">
						<span class="iconify lucide--refresh-cw size-3"></span>
						{ itoa(chunk.Attempts) } attempts
					</span>
				}
				<span class="font-mono">{ formatTokens(chunk.InputTokens) } in</span>
				<span class="font-mono">{ formatTokens(chunk.OutputTokens) } out</span>
				if chunk.Duration != "" {
					<span>{ chunk.Duration }</span>
				}
			</div>
		</div>
	</div>
}
