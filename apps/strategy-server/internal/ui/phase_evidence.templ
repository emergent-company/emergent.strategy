package ui

import (
	"strconv"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
)

// EvidenceItem is a single evidence item shown in the evidence collection page.
type EvidenceItem struct {
	ArtifactKey      string
	SourceName       string
	SourceType       string
	Summary          string
	Tags             []string
	ProcessingStatus string
	CreatedAt        string
}

// EvidencePageData holds all data for the evidence collection page.
type EvidencePageData struct {
	NavContext

	InstanceID string

	// Existing evidence items
	Items      []EvidenceItem
	TotalCount int

	// Tag counts for the summary strip
	TagCounts map[string]int
}

// ---------------------------------------------------------------------------
// Source types and their suggested tags.
// ---------------------------------------------------------------------------

var evidenceSourceTypes = []evidenceSourceOption{
	{"pitch_deck", "Pitch Deck", []string{"vision", "strategy", "pitch"}},
	{"market_research", "Market Research", []string{"market", "trends", "user_research"}},
	{"competitive_analysis", "Competitive Analysis", []string{"competitive", "market"}},
	{"product_doc", "Product Document", []string{"product", "technical"}},
	{"strategy_notes", "Strategy Notes", []string{"strategy", "vision"}},
	{"user_research", "User Research", []string{"user_research", "market"}},
	{"interview_notes", "Interview Notes", []string{"vision", "strategy", "user_research"}},
	{"sales_call", "Sales Call Notes", []string{"competitive", "market", "product"}},
	{"other", "Other", []string{}},
}

type evidenceSourceOption struct {
	Value           string
	Label           string
	SuggestedTags   []string
}

// EvidencePageContent renders the evidence collection page.
templ EvidencePageContent(data EvidencePageData) {
	@TabRelatedPages("aim", data.InstanceID, "/strategies/" + data.InstanceID + "/aim")
	<div class="space-y-6">
		// Header
		<div class="flex items-center justify-between">
			<div>
				<h2 class="text-base font-semibold text-base-content">{ langs.T(ctx, "nav.screen.evidence") }</h2>
				<p class="text-xs text-base-content/75 mt-0.5">
					Load source material to ground AI-generated strategy drafts in real context.
				</p>
			</div>
			if data.TotalCount > 0 {
				<div class="badge badge-ghost badge-lg">
					{ strconv.Itoa(data.TotalCount) } items loaded
				</div>
			}
		</div>

		// Ingest form
		@evidenceIngestCard(data.InstanceID)

		// Evidence list
		if len(data.Items) > 0 {
			@evidenceList(data)
		} else {
			@evidenceEmptyState()
		}
	</div>
}

// evidenceIngestCard renders the evidence submission form.
templ evidenceIngestCard(instanceID string) {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body p-5">
			<h3 class="text-sm font-semibold text-base-content/80 uppercase tracking-widest mb-4">
				Add Evidence
			</h3>
			<form
				method="POST"
				action={ templ.URL("/strategies/" + instanceID + "/evidence/ingest") }
				class="space-y-4"
			>
				// Source name + type row
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="label pb-1">
							<span class="label-text text-xs font-medium">Source name</span>
						</label>
						<input
							type="text"
							name="source_name"
							placeholder="e.g. Q1 Board Deck, Customer Interview #3"
							required
							class="input input-sm input-bordered w-full"
						/>
					</div>
					<div>
						<label class="label pb-1">
							<span class="label-text text-xs font-medium">Source type</span>
						</label>
						<select
							name="source_type"
							class="select select-sm select-bordered w-full"
						>
							for _, opt := range evidenceSourceTypes {
								<option value={ opt.Value }>{ opt.Label }</option>
							}
						</select>
					</div>
				</div>

				// Content textarea
				<div>
					<label class="label pb-1">
						<span class="label-text text-xs font-medium">Content</span>
						<span class="label-text-alt text-base-content/55">Paste, summarise, or type notes</span>
					</label>
					<textarea
						name="content"
						rows="6"
						placeholder="Paste document content, interview notes, or any strategic context here..."
						required
						class="textarea textarea-bordered w-full text-sm font-mono leading-relaxed"
					></textarea>
				</div>

				// Summary (optional)
				<div>
					<label class="label pb-1">
						<span class="label-text text-xs font-medium">One-line summary</span>
						<span class="label-text-alt text-base-content/55">Optional — AI-readable headline</span>
					</label>
					<input
						type="text"
						name="summary"
						placeholder="e.g. Board confirms $2M seed with focus on SMB market"
						class="input input-sm input-bordered w-full"
					/>
				</div>

				// Tags input
				<div>
					<label class="label pb-1">
						<span class="label-text text-xs font-medium">Tags</span>
						<span class="label-text-alt text-base-content/55">Comma-separated — affects which bootstrap skills use this item</span>
					</label>
					<input
						type="text"
						name="tags"
						placeholder="vision, market, competitive, strategy, user_research, pitch"
						class="input input-sm input-bordered w-full font-mono"
					/>
					// Suggested tags per source type (shown as hint)
					<div class="mt-1 flex flex-wrap gap-1">
						<span class="text-xs text-base-content/55">Common tags:</span>
						for _, tag := range []string{"vision", "strategy", "market", "competitive", "user_research", "pitch", "product", "trends"} {
							<button
								type="button"
								class="badge badge-xs badge-ghost hover:badge-primary cursor-pointer"
								onclick="appendTag(this.textContent, 'tags')"
							>{ tag }</button>
						}
					</div>
				</div>

				// Confidence
				<div class="flex items-center gap-4">
					<div>
						<label class="label pb-1">
							<span class="label-text text-xs font-medium">Confidence</span>
						</label>
						<select name="confidence" class="select select-xs select-bordered">
							<option value="high">High</option>
							<option value="medium" selected>Medium</option>
							<option value="low">Low</option>
						</select>
					</div>
					<div class="flex-1"></div>
					<button type="submit" class="btn btn-sm btn-primary self-end">
						<span class="iconify lucide--plus size-3.5"></span>
						Add evidence
					</button>
				</div>
			</form>
		</div>
	</div>
	// Tag helper JS (inline, minimal)
	<script>
function appendTag(tag, fieldName) {
  const input = document.querySelector('input[name="' + fieldName + '"]');
  if (!input) return;
  const current = input.value.split(',').map(t => t.trim()).filter(Boolean);
  if (!current.includes(tag)) {
    current.push(tag);
    input.value = current.join(', ');
  }
}
</script>
}

// evidenceList renders the list of existing evidence items.
templ evidenceList(data EvidencePageData) {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body p-5">
			<div class="flex items-center justify-between mb-4">
				<h3 class="text-sm font-semibold text-base-content/80 uppercase tracking-widest">
					Loaded Evidence ({ strconv.Itoa(data.TotalCount) })
				</h3>
				// Tag summary chips
				if len(data.TagCounts) > 0 {
					<div class="flex flex-wrap gap-1">
						for tag, count := range data.TagCounts {
							<span class="badge badge-xs badge-ghost" title={ strconv.Itoa(count) + " items" }>
								{ tag } ({ strconv.Itoa(count) })
							</span>
						}
					</div>
				}
			</div>
			<div class="space-y-2">
				for _, item := range data.Items {
					@evidenceItemRow(item, data.InstanceID)
				}
			</div>
		</div>
	</div>
}

// evidenceItemRow renders a single evidence item.
templ evidenceItemRow(item EvidenceItem, instanceID string) {
	<div class="flex items-start gap-3 py-2 border-b border-base-content/5 last:border-0">
		<span class="iconify lucide--file-text size-4 text-base-content/55 shrink-0 mt-0.5"></span>
		<div class="min-w-0 grow space-y-0.5">
			<div class="flex items-center gap-2 flex-wrap">
				<span class="text-xs font-medium text-base-content">{ item.SourceName }</span>
				<span class="badge badge-xs badge-ghost">{ item.SourceType }</span>
				if item.ProcessingStatus == "processed" {
					<span class="badge badge-xs badge-success">processed</span>
				} else if item.ProcessingStatus == "archived" {
					<span class="badge badge-xs badge-ghost opacity-50">archived</span>
				}
			</div>
			if item.Summary != "" {
				<p class="text-xs text-base-content/75 line-clamp-1">{ item.Summary }</p>
			}
			<div class="flex items-center gap-2 flex-wrap">
				for _, tag := range item.Tags {
					<span class="badge badge-xs badge-primary badge-outline">{ tag }</span>
				}
				<span class="text-xs text-base-content/30 ml-auto">{ item.CreatedAt }</span>
			</div>
		</div>
	</div>
}

// evidenceEmptyState renders the empty state when no evidence exists.
templ evidenceEmptyState() {
	<div class="card bg-base-100 border border-base-content/15 shadow-sm">
		<div class="card-body items-center py-12 text-center">
			<span class="iconify lucide--database size-12 text-base-content/20 mb-3 block"></span>
			<h3 class="text-sm font-semibold text-base-content/75 mb-1">No evidence loaded yet</h3>
			<p class="text-xs text-base-content/55 max-w-sm">
				Add source material above — pitch decks, market research, interview notes, or any
				strategic context. Evidence is used to ground AI-generated strategy drafts.
			</p>
		</div>
	</div>
}

// ---------------------------------------------------------------------------
// Guided interview mode (task 1.5)
// ---------------------------------------------------------------------------

// InterviewQuestion is a single question in the guided strategy interview.
type InterviewQuestion struct {
	ID          string   // form field name prefix, e.g. "q_vision"
	Question    string
	Hint        string
	Tags        []string // evidence tags to apply to the answer
	SourceType  string   // evidence source_type for this question
	AlreadyCovered bool  // true when evidence with matching tags already exists
}

// EvidenceInterviewData holds data for the guided interview page.
type EvidenceInterviewData struct {
	NavContext

	InstanceID string
	Questions  []InterviewQuestion
	AllCovered bool // true when all questions have existing evidence
}

// EvidenceInterviewContent renders the guided interview page.
templ EvidenceInterviewContent(data EvidenceInterviewData) {
	@TabRelatedPages("aim", data.InstanceID, "/strategies/" + data.InstanceID + "/aim")
	<div class="space-y-6">
		// Header
		<div>
			<a href={ templ.URL("/strategies/" + data.InstanceID + "/aim/evidence") } class="text-xs text-base-content/65 hover:text-base-content flex items-center gap-1 mb-2">
				<span class="iconify lucide--arrow-left size-3"></span>
				Back to evidence
			</a>
			<h2 class="text-base font-semibold text-base-content">{ langs.T(ctx, "page.strategy_interview") }</h2>
			<p class="text-xs text-base-content/75 mt-0.5">
				Answer these questions to load structured context for AI-generated strategy drafts.
				Each answer becomes a tagged evidence item. Skip questions you cannot answer yet.
			</p>
		</div>

		if data.AllCovered {
			<div class="alert alert-success shadow-sm">
				<span class="iconify lucide--check-circle size-5"></span>
				<span class="text-sm font-medium">All questions have evidence. Your strategy is well-grounded.</span>
			</div>
		}

		<form method="POST" action={ templ.URL("/strategies/" + data.InstanceID + "/evidence/interview") } class="space-y-6">
			for _, q := range data.Questions {
				@interviewQuestion(q)
			}
			<div class="flex justify-end">
				<button type="submit" class="btn btn-primary">
					<span class="iconify lucide--save size-4"></span>
					{ langs.T(ctx, "action.save") }
				</button>
			</div>
		</form>
	</div>
}

// interviewQuestion renders a single interview question card.
templ interviewQuestion(q InterviewQuestion) {
	<div class={ "card border shadow-sm", templ.KV("border-success/20 bg-success/5", q.AlreadyCovered), templ.KV("border-base-content/15 bg-base-100", !q.AlreadyCovered) }>
		<div class="card-body p-5">
			<div class="flex items-start gap-3">
				if q.AlreadyCovered {
					<span class="iconify lucide--check-circle size-4 text-success shrink-0 mt-0.5"></span>
				} else {
					<span class="iconify lucide--circle size-4 text-base-content/30 shrink-0 mt-0.5"></span>
				}
				<div class="grow space-y-3">
					<div>
						<p class="text-sm font-medium text-base-content">{ q.Question }</p>
						if q.Hint != "" {
							<p class="text-xs text-base-content/65 mt-0.5">{ q.Hint }</p>
						}
						<div class="flex flex-wrap gap-1 mt-1">
							for _, tag := range q.Tags {
								<span class="badge badge-xs badge-primary badge-outline">{ tag }</span>
							}
						</div>
					</div>
					if !q.AlreadyCovered {
						<textarea
							name={ q.ID }
							rows="4"
							placeholder="Type your answer here..."
							class="textarea textarea-bordered w-full text-sm"
						></textarea>
					} else {
						<p class="text-xs text-success/70 italic">Evidence already loaded for this topic.</p>
					}
				</div>
			</div>
		</div>
	</div>
}
