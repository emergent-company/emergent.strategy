package ui

import (
	"fmt"
	"time"

	"github.com/emergent-company/emergent-strategy/apps/strategy-server/internal/langs"
	"github.com/emergent-company/go-daisy/components/layout"
)

// GithubSyncStatus represents the GitHub App sync state for a single instance.
type GithubSyncStatus struct {
	InstanceID    string
	InstanceName  string
	Repo          string              // "owner/repo" or "" if not configured
	ActiveBranch  string              // non-empty when tracking a non-default branch (e.g. "dev")
	SyncState     string              // "in_sync" | "server_ahead" | "github_ahead" | "diverged" | "unlinked" | ""
	LocalSHA      string              // first 7 chars of the server's tracked commit SHA
	RemoteSHA     string              // first 7 chars of the remote HEAD SHA
	Configured    bool                // GitHub App is configured server-side
	RepoLinked    bool                // this instance has a github_repo set
	LastSyncAt    *time.Time
	LastSyncPR    string              // PR URL of last sync (may be empty)
	LastStatus    string              // "pr_created" | "failed" | "pending" | ""
	LastDirection string              // "export" | "import" | ""
	Workspaces    []WorkspaceScanItem // all workspaces for the move dropdown
}

// MemoryHealthStatus represents the current connectivity to the Memory server.
type MemoryHealthStatus struct {
	Configured         bool   // EPF_MEMORY_URL + PROJECT + TOKEN are set
	Healthy            bool   // ping succeeded
	URL                string // configured URL (empty if not configured)
	ProjectID          string // configured project ID
	Version            string // server version from health check
	Error              string // last error message (empty if healthy)
	TotalGraphObjects  int    // total artifact objects in the Memory graph (0 if unavailable)
}

// InstanceMemoryStatus tracks the ingest state of a single strategy instance.
type InstanceMemoryStatus struct {
	ID                    string
	Name                  string
	OrgName               string
	MemorySyncStatus      string     // "", "synced", "pending", "failed"
	ArtifactCount         int        // total artifacts in DB
	GraphObjectCount      int        // layer:artifact objects in Memory
	GraphEdgeCount        int        // layer:artifact edges in Memory
	DecomposedObjectCount int        // layer:decomposed objects in Memory
	DecomposedEdgeCount   int        // layer:decomposed edges in Memory
	LastSyncedAt          *time.Time // last successful sync time
}

// SettingsData is the full data bundle for the settings page.
type SettingsData struct {
	Memory      MemoryHealthStatus
	Instances   []InstanceMemoryStatus
	GithubSync  []GithubSyncStatus // one entry per instance; empty when App not configured
	Github      GithubConfigStatus // server-side GitHub configuration state
	ActiveLang  string             // current locale code, e.g. "en" or "nb"
}

// GithubConfigStatus describes which GitHub mechanisms are configured server-side.
type GithubConfigStatus struct {
	AppConfigured   bool   // GITHUB_APP_ID + private key set (powers sync card + AIM auto-push)
	OAuthConfigured bool   // GITHUB_OAUTH_CLIENT_ID + secret set (powers /github/connect flow)
	AppSlug         string // public app slug, if known
}

// SettingsPage renders the full settings page with shell.
templ SettingsPage(currentPath string, sidebarGroups []layout.SidebarGroup, data SettingsData) {
	@StrategyShellPage("Settings — Emergent Strategy", currentPath, sidebarGroups) {
		@SettingsMainContent(data)
	}
}

// SettingsMainContent is the tier-2 (sidebar nav) component: the scroll wrapper
// + content without the outer HTML shell. Used by RenderTriple for sidebar navigation.
templ SettingsMainContent(data SettingsData) {
	<div class="flex flex-col flex-1 min-h-0 overflow-y-auto">
		@SettingsContent(data)
	</div>
}

// SettingsContent renders the settings content (inner body, no shell).
templ SettingsContent(data SettingsData) {
	<div class="px-6 py-5 space-y-6">
		<!-- Page header -->
		<div>
			<h1 class="text-xl font-bold text-base-content">{ langs.T(ctx, "page.settings.title") }</h1>
			<p class="text-sm text-base-content/60 mt-0.5">{ langs.T(ctx, "page.settings.subtitle") }</p>
		</div>

		<!-- Memory server status card -->
		@memoryStatusCard(data.Memory)

		<!-- Per-instance ingest status -->
		if len(data.Instances) > 0 {
			@instanceIngestTable(data.Instances)
		}

		<!-- GitHub sync status -->
		if data.Github.AppConfigured && len(data.GithubSync) > 0 {
			@githubSyncCard(data.GithubSync)
		} else {
			@githubNotConfiguredCard(data.Github)
		}

		<!-- Language preference -->
		@langPickerCard(data.ActiveLang)
	</div>
}

// githubNotConfiguredCard renders the GitHub section when GitHub is not (fully)
// configured server-side. It mirrors the Memory "not configured" pattern so the
// section is always visible with actionable setup guidance, rather than silently
// disappearing.
templ githubNotConfiguredCard(g GithubConfigStatus) {
	<div class="rounded-xl border border-base-content/10 bg-base-100 shadow-sm overflow-hidden">
		<!-- Header -->
		<div class="flex items-center gap-3 px-5 py-4 border-b border-base-content/10">
			<span class="iconify lucide--github size-5 text-base-content/60"></span>
			<div class="grow">
				<h2 class="text-sm font-bold text-base-content uppercase tracking-widest">{ langs.T(ctx, "settings.github_sync.title") }</h2>
				<p class="text-xs text-base-content/50 mt-0.5">{ langs.T(ctx, "settings.github_sync.subtitle") }</p>
			</div>
			if g.AppConfigured {
				<span class="badge badge-success badge-sm">{ langs.T(ctx, "settings.github.app_configured") }</span>
			} else {
				<span class="badge badge-ghost badge-sm">{ langs.T(ctx, "settings.github.not_configured") }</span>
			}
		</div>

		<!-- Body -->
		<div class="px-5 py-4 space-y-4">
			<!-- Mechanism status chips -->
			<div class="flex flex-wrap gap-2">
			@githubMechanismChip(langs.T(ctx, "settings.github.app_label"), g.AppConfigured, "repo sync + AIM auto-push")
			@githubMechanismChip(langs.T(ctx, "settings.github.oauth_label"), g.OAuthConfigured, "user connect flow")
			</div>

			if !g.AppConfigured {
				<div class="rounded-lg bg-base-200/60 border border-base-content/10 px-4 py-3 space-y-2">
					<p class="text-sm text-base-content/70">
						The GitHub App is not configured, so repo sync and the per-instance sync
						status are unavailable. In local dev, <code class="bg-base-300/40 px-1 rounded">dev-setup.sh</code>
						rewrites <code class="bg-base-300/40 px-1 rounded">.env.local</code> on every run, so put
						GitHub credentials in a gitignored <code class="bg-base-300/40 px-1 rounded">.env.local.secrets</code>
						file (appended automatically on every run) and restart:
					</p>
					<pre class="text-xs text-base-content/80 bg-base-300/40 rounded p-3 overflow-x-auto"># .env.local.secrets
GITHUB_APP_ID=&lt;app-id&gt;
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/app-private-key.pem
GITHUB_APP_SLUG=&lt;app-slug&gt;

# Optional — for the user connect flow:
GITHUB_OAUTH_CLIENT_ID=&lt;client-id&gt;
GITHUB_OAUTH_CLIENT_SECRET=&lt;client-secret&gt;
GITHUB_OAUTH_STATE_SECRET=&lt;random-string&gt;</pre>
				</div>
			}

			if g.OAuthConfigured {
				<!-- OAuth connect flow IS available even without the App. -->
				<div class="rounded-lg bg-info/10 border border-info/25 px-4 py-3 flex items-start gap-2">
					<span class="iconify lucide--info size-4 text-info shrink-0 mt-0.5"></span>
					<div class="text-sm text-base-content/80 space-y-1">
					<p>{ langs.T(ctx, "settings.github.oauth_available_note") }</p>
					<a href="/github/connect" class="inline-flex items-center gap-1 btn btn-xs btn-primary mt-1">
						<span class="iconify lucide--plug size-3"></span>
						{ langs.T(ctx, "settings.github.connect_btn") }
					</a>
					</div>
				</div>
			}
		</div>
	</div>
}

// githubMechanismChip renders a small on/off chip for one GitHub mechanism.
templ githubMechanismChip(label string, on bool, note string) {
	if on {
		<span class="inline-flex items-center gap-1.5 badge badge-success badge-sm" title={ note }>
			<span class="iconify lucide--check size-3"></span>
			{ label }
		</span>
	} else {
		<span class="inline-flex items-center gap-1.5 badge badge-ghost badge-sm text-base-content/40" title={ note }>
			<span class="iconify lucide--x size-3"></span>
			{ label }
		</span>
	}
}

// memoryStatusCard renders the Memory server health section.
templ memoryStatusCard(m MemoryHealthStatus) {
	<div class="rounded-xl border border-base-content/10 bg-base-100 shadow-sm overflow-hidden">
		<!-- Header -->
		<div class="flex items-center gap-3 px-5 py-4 border-b border-base-content/10">
			<span class="iconify lucide--brain-circuit size-5 text-base-content/60"></span>
			<div class="grow">
			<h2 class="text-sm font-bold text-base-content uppercase tracking-widest">{ langs.T(ctx, "settings.memory.title") }</h2>
			<p class="text-xs text-base-content/50 mt-0.5">{ langs.T(ctx, "settings.memory.subtitle") }</p>
			</div>
			<!-- Status badge -->
			if !m.Configured {
				<span class="badge badge-ghost badge-sm">{ langs.T(ctx, "settings.memory.not_configured") }</span>
			} else if m.Healthy {
				<span class="inline-flex items-center gap-1.5 badge badge-success badge-sm">
					<span class="size-1.5 rounded-full bg-success-content inline-block"></span>
					{ langs.T(ctx, "settings.memory.connected") }
				</span>
			} else {
				<span class="inline-flex items-center gap-1.5 badge badge-error badge-sm">
					<span class="size-1.5 rounded-full bg-error-content inline-block"></span>
					{ langs.T(ctx, "settings.memory.unreachable") }
				</span>
			}
		</div>

		<!-- Body -->
		<div class="px-5 py-4 space-y-4">
			if !m.Configured {
				<!-- Not configured state -->
				<div class="rounded-lg bg-base-200/60 border border-base-content/10 px-4 py-3 space-y-2">
					<p class="text-sm text-base-content/70">
						Memory is not configured. Set the following environment variables and restart the server:
					</p>
					<pre class="text-xs text-base-content/80 bg-base-300/40 rounded p-3 overflow-x-auto">EPF_MEMORY_URL=http://localhost:3002
EPF_MEMORY_PROJECT=&lt;project-id&gt;
EPF_MEMORY_TOKEN=&lt;standalone-api-key&gt;
EPF_MEMORY_AUTH_MODE=api-key</pre>
					<p class="text-xs text-base-content/50">
						Start the Memory server with <code class="bg-base-300/40 px-1 rounded">memory server ctl start</code>,
						then re-run <code class="bg-base-300/40 px-1 rounded">task dev-up</code> to auto-detect it.
					</p>
				</div>
			} else {
			<!-- Configured state: show connection details -->
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
			@settingsKV(langs.T(ctx, "settings.memory.kv.url"), m.URL)
			@settingsKV(langs.T(ctx, "settings.memory.kv.project_id"), m.ProjectID)
			if m.Version != "" {
				@settingsKV(langs.T(ctx, "settings.memory.kv.server_version"), m.Version)
			}
			if m.TotalGraphObjects > 0 {
				@settingsKV(langs.T(ctx, "settings.memory.kv.graph_objects"), fmt.Sprintf("%d", m.TotalGraphObjects))
			}
			if m.Error != "" {
				<div class="sm:col-span-2">
					<dt class="text-xs font-medium text-base-content/50 uppercase tracking-wide mb-0.5">{ langs.T(ctx, "settings.memory.kv.last_error") }</dt>
						<dd class="text-xs text-error font-mono break-all">{ m.Error }</dd>
					</div>
				}
			</div>

				if !m.Healthy {
					<div class="rounded-lg bg-error/10 border border-error/25 px-4 py-3 flex items-start gap-2">
						<span class="iconify lucide--alert-triangle size-4 text-error shrink-0 mt-0.5"></span>
						<p class="text-sm text-error">
							Cannot reach Memory server at <strong>{ m.URL }</strong>.
							Check that the server is running: <code class="bg-error/10 px-1 rounded">memory server ctl status</code>
						</p>
					</div>
				}
			}
		</div>
	</div>
}

// instanceIngestTable renders per-instance Memory sync status.
templ instanceIngestTable(instances []InstanceMemoryStatus) {
	<div class="rounded-xl border border-base-content/10 bg-base-100 shadow-sm overflow-hidden">
		<div class="flex items-center gap-3 px-5 py-4 border-b border-base-content/10">
			<span class="iconify lucide--layers size-5 text-base-content/60"></span>
			<div class="grow">
			<h2 class="text-sm font-bold text-base-content uppercase tracking-widest">{ langs.T(ctx, "settings.instances.title") }</h2>
			<p class="text-xs text-base-content/50 mt-0.5">{ langs.T(ctx, "settings.instances.subtitle") }</p>
			</div>
			<span class="badge badge-ghost badge-sm">{ fmt.Sprintf("%d instances", len(instances)) }</span>
		</div>
		<div class="divide-y divide-base-content/5">
			for _, inst := range instances {
				@instanceIngestRow(inst)
			}
		</div>
	</div>
}

// instanceIngestRow renders a single instance row in the ingest table.
templ instanceIngestRow(inst InstanceMemoryStatus) {
	<div class="flex items-center gap-4 px-5 py-3">
		<!-- Instance name + org -->
		<div class="grow min-w-0">
			<p class="text-sm font-medium text-base-content truncate">{ inst.Name }</p>
			if inst.OrgName != "" {
				<p class="text-xs text-base-content/50">{ inst.OrgName }</p>
			}
		if inst.LastSyncedAt != nil {
			<p class="text-xs text-base-content/40 mt-0.5">{ langs.T(ctx, "settings.instance.synced_at") } { inst.LastSyncedAt.Format("2 Jan 15:04") }</p>
		}
		</div>

		<!-- Graph counts -->
		<div class="text-right shrink-0 hidden sm:block">
		<p class="text-xs text-base-content/50">{ fmt.Sprintf(langs.T(ctx, "settings.instance.artifact_count"), inst.ArtifactCount) }</p>
		if inst.GraphObjectCount > 0 {
			<p class="text-xs text-base-content/40">{ fmt.Sprintf(langs.T(ctx, "settings.instance.graph_counts"), inst.GraphObjectCount, inst.GraphEdgeCount) }</p>
		}
		if inst.DecomposedObjectCount > 0 {
			<p class="text-xs text-base-content/30">{ fmt.Sprintf(langs.T(ctx, "settings.instance.decomposed_counts"), inst.DecomposedObjectCount, inst.DecomposedEdgeCount) }</p>
		}
		</div>

		<!-- Sync status badge -->
		<div class="shrink-0">
			@ingestStatusBadge(inst.MemorySyncStatus)
		</div>
	</div>
}

// ingestStatusBadge renders a status chip for memory sync state.
templ ingestStatusBadge(status string) {
	switch status {
		case "synced":
			<span class="inline-flex items-center gap-1.5 badge badge-success badge-sm">
				<span class="iconify lucide--check size-3"></span>
				{ langs.T(ctx, "ui.status.synced") }
			</span>
		case "pending":
			<span class="inline-flex items-center gap-1.5 badge badge-warning badge-sm">
				<span class="iconify lucide--clock size-3"></span>
				{ langs.T(ctx, "ui.status.pending") }
			</span>
		case "failed":
			<span class="inline-flex items-center gap-1.5 badge badge-error badge-sm">
				<span class="iconify lucide--x size-3"></span>
				{ langs.T(ctx, "ui.status.failed") }
			</span>
		default:
			<span class="badge badge-ghost badge-sm text-base-content/40">{ langs.T(ctx, "ui.status.not_synced") }</span>
	}
}

// settingsKV renders a key-value definition pair.
templ settingsKV(label, value string) {
	<div>
		<dt class="text-xs font-medium text-base-content/50 uppercase tracking-wide mb-0.5">{ label }</dt>
		<dd class="text-sm text-base-content font-mono break-all">{ value }</dd>
	</div>
}

// githubSyncCard renders the GitHub sync status section.
templ githubSyncCard(instances []GithubSyncStatus) {
	<div class="rounded-xl border border-base-content/10 bg-base-100 shadow-sm overflow-hidden">
		<!-- Header -->
		<div class="flex items-center gap-3 px-5 py-4 border-b border-base-content/10">
			<span class="iconify lucide--github size-5 text-base-content/60"></span>
			<div class="grow">
			<h2 class="text-sm font-bold text-base-content uppercase tracking-widest">{ langs.T(ctx, "settings.github_sync.title") }</h2>
			<p class="text-xs text-base-content/50 mt-0.5">{ langs.T(ctx, "settings.github_sync.subtitle") }</p>
			</div>
			<span class="badge badge-ghost badge-sm">{ fmt.Sprintf("%d instances", len(instances)) }</span>
			<a href="/github/connect" class="btn btn-xs btn-ghost border border-base-content/20 gap-1">
				<span class="iconify lucide--plug size-3"></span>
				{ langs.T(ctx, "settings.github.connect_repo_btn") }
			</a>
		</div>
		<div class="divide-y divide-base-content/5">
			for _, inst := range instances {
				@githubSyncRow(inst)
			}
		</div>
	</div>
}

// githubSyncRow renders a single instance row in the GitHub sync table.
templ githubSyncRow(inst GithubSyncStatus) {
	<div class="px-5 py-4 space-y-2">
		<!-- Top row: instance name + state badge + action buttons -->
		<div class="flex items-start gap-4">
			<!-- Instance name + repo + branch -->
			<div class="grow min-w-0">
				<p class="text-sm font-semibold text-base-content truncate">{ inst.InstanceName }</p>
				if inst.RepoLinked {
					<div class="flex items-center gap-1.5 flex-wrap mt-0.5">
						<a href={ templ.SafeURL("https://github.com/" + inst.Repo) } target="_blank" rel="noopener"
							class="text-xs text-base-content/60 hover:text-primary font-mono">
							{ inst.Repo }
						</a>
						if inst.ActiveBranch != "" {
							<span class="inline-flex items-center gap-1 text-xs text-info font-mono bg-info/10 rounded px-1.5 py-0.5">
								<span class="iconify lucide--git-branch size-3"></span>
								{ inst.ActiveBranch }
							</span>
						}
					</div>
				} else {
					<p class="text-xs text-base-content/40 mt-0.5">{ langs.T(ctx, "settings.github.no_repo_configured") }</p>
				}

				<!-- SHA comparison row -->
				if inst.LocalSHA != "" || inst.RemoteSHA != "" {
					<div class="flex items-center gap-2 mt-1 text-xs text-base-content/40 font-mono">
						if inst.LocalSHA != "" {
							<span title="Server's last synced commit">server: { inst.LocalSHA }</span>
						}
						if inst.LocalSHA != "" && inst.RemoteSHA != "" {
							<span>→</span>
						}
						if inst.RemoteSHA != "" {
							<span title="Remote HEAD commit">remote: { inst.RemoteSHA }</span>
						}
					</div>
				}

				<!-- Last sync info -->
				if inst.LastSyncAt != nil {
					<p class="text-xs text-base-content/40 mt-0.5">
					if inst.LastDirection == "import" {
						imported { inst.LastSyncAt.Format("2 Jan 15:04") }
					} else {
						{ langs.T(ctx, "settings.instance.synced_at") } { inst.LastSyncAt.Format("2 Jan 15:04") }
					}
					if inst.LastSyncPR != "" {
						· <a href={ templ.SafeURL(inst.LastSyncPR) } target="_blank" rel="noopener"
							class="text-primary hover:underline">{ langs.T(ctx, "settings.github.view_pr") }</a>
					}
					</p>
				}
			</div>

			<!-- Right: state badge + buttons -->
			<div class="flex items-center gap-2 shrink-0">
				@githubSyncStateBadge(inst.SyncState, inst.RepoLinked)
				if inst.Configured && inst.RepoLinked {
					<!-- Push to GitHub button -->
					<form method="POST" action="/settings/sync" class="inline">
						<input type="hidden" name="instance_id" value={ inst.InstanceID }/>
					<button type="submit"
						class="btn btn-xs btn-ghost border border-base-content/20 gap-1"
						title="Push strategy artifacts to GitHub">
						<span class="iconify lucide--upload size-3"></span>
						{ langs.T(ctx, "settings.github.push_btn") }
					</button>
					</form>
					<!-- Import from GitHub button -->
					<form method="POST" action="/settings/import" class="inline">
						<input type="hidden" name="instance_id" value={ inst.InstanceID }/>
					<button type="submit"
						class={ "btn btn-xs gap-1 " + importButtonClass(inst.SyncState) }
						title="Import EPF artifacts from GitHub">
						<span class="iconify lucide--download size-3"></span>
						{ langs.T(ctx, "settings.github.import_btn") }
					</button>
					</form>
				}
			</div>
		</div>
		<!-- Move to workspace -->
		if len(inst.Workspaces) > 0 {
			<form method="POST" action={ templ.SafeURL("/strategies/" + inst.InstanceID + "/move") }
				class="flex items-center gap-2 flex-wrap">
				<span class="iconify lucide--folder-symlink size-3.5 text-base-content/30 shrink-0"></span>
				<span class="text-xs text-base-content/40">Move to:</span>
				<select
					name="workspace_id"
					class="select select-xs select-bordered"
					onchange="const inp=this.form.querySelector('.move-ws-input');if(inp){inp.style.display=this.value==='__new__'?'':'none';inp.required=this.value==='__new__';}"
				>
					for _, ws := range inst.Workspaces {
						<option value={ ws.ID }>{ ws.OrgName } / { ws.Name }</option>
					}
					<option value="__new__">+ New workspace...</option>
				</select>
				<input
					type="text"
					name="new_workspace_name"
					placeholder="New workspace name"
					class="move-ws-input input input-xs input-bordered w-40"
					style="display:none"
				/>
				<button type="submit" class="btn btn-xs btn-ghost border border-base-content/20 gap-1">
					<span class="iconify lucide--check size-3"></span>
					Move
				</button>
			</form>
		}
	</div>
}

// importButtonClass returns the DaisyUI button class for the import button based on sync state.
func importButtonClass(state string) string {
	switch state {
	case "github_ahead":
		return "btn-primary"
	case "diverged":
		return "btn-warning"
	case "server_ahead":
		return "btn-ghost border border-base-content/20"
	default:
		return "btn-ghost border border-base-content/20"
	}
}

// githubSyncStateBadge renders the sync state badge (four-state matrix).
templ githubSyncStateBadge(state string, repoLinked bool) {
	switch state {
		case "in_sync":
			<span class="inline-flex items-center gap-1.5 badge badge-success badge-sm">
				<span class="iconify lucide--check size-3"></span>
				{ langs.T(ctx, "ui.sync_state.in_sync") }
			</span>
		case "server_ahead":
			<span class="inline-flex items-center gap-1.5 badge badge-info badge-sm" title={ langs.T(ctx, "ui.sync_state.server_ahead_tip") }>
				<span class="iconify lucide--upload size-3"></span>
				{ langs.T(ctx, "ui.sync_state.server_ahead") }
			</span>
		case "github_ahead":
			<span class="inline-flex items-center gap-1.5 badge badge-warning badge-sm" title={ langs.T(ctx, "ui.sync_state.github_ahead_tip") }>
				<span class="iconify lucide--download size-3"></span>
				{ langs.T(ctx, "ui.sync_state.github_ahead") }
			</span>
		case "diverged":
			<span class="inline-flex items-center gap-1.5 badge badge-error badge-sm" title={ langs.T(ctx, "ui.sync_state.diverged_tip") }>
				<span class="iconify lucide--git-merge size-3"></span>
				{ langs.T(ctx, "ui.sync_state.diverged") }
			</span>
		default:
			if !repoLinked {
				<span class="badge badge-ghost badge-sm text-base-content/40">{ langs.T(ctx, "ui.sync_state.not_linked") }</span>
			} else {
				<span class="badge badge-ghost badge-sm text-base-content/40">{ langs.T(ctx, "ui.sync_state.never_synced") }</span>
			}
	}
}

// githubSyncStatusBadge renders a simple status badge for the last sync log entry.
// Used for non-state display (e.g. "PR Created").
templ githubSyncStatusBadge(status string, repoLinked bool) {
	switch status {
		case "pr_created", "merged":
			<span class="inline-flex items-center gap-1.5 badge badge-success badge-sm">
				<span class="iconify lucide--git-pull-request size-3"></span>
				{ langs.T(ctx, "ui.sync_status.pr_created") }
			</span>
		case "pending":
			<span class="inline-flex items-center gap-1.5 badge badge-warning badge-sm">
				<span class="iconify lucide--clock size-3"></span>
				{ langs.T(ctx, "ui.status.pending") }
			</span>
		case "failed":
			<span class="inline-flex items-center gap-1.5 badge badge-error badge-sm">
				<span class="iconify lucide--x size-3"></span>
				{ langs.T(ctx, "ui.status.failed") }
			</span>
		default:
			if !repoLinked {
				<span class="badge badge-ghost badge-sm text-base-content/40">{ langs.T(ctx, "ui.sync_state.not_linked") }</span>
			} else {
				<span class="badge badge-ghost badge-sm text-base-content/40">{ langs.T(ctx, "ui.sync_state.never_synced") }</span>
			}
	}
}

// langPickerCard renders the language preference section of the settings page.
templ langPickerCard(activeLang string) {
	<div class="rounded-xl border border-base-content/10 bg-base-100 shadow-sm overflow-hidden">
		<div class="flex items-center gap-3 px-5 py-4 border-b border-base-content/10">
			<span class="iconify lucide--languages size-5 text-base-content/60"></span>
			<div class="grow">
				<h2 class="text-sm font-bold text-base-content uppercase tracking-widest">{ langs.T(ctx, "settings.lang.title") }</h2>
				<p class="text-xs text-base-content/50 mt-0.5">{ langs.T(ctx, "settings.lang.subtitle") }</p>
			</div>
		</div>
		<div class="px-5 py-4">
			<form method="POST" action="/settings/lang" class="flex items-center gap-3">
				<select name="lang" class="select select-sm select-bordered">
					<option value="en" selected?={ activeLang == "en" || activeLang == "" }>English</option>
					<option value="nb" selected?={ activeLang == "nb" }>Norsk (bokmål)</option>
				</select>
				<button type="submit" class="btn btn-sm btn-primary gap-1">
					<span class="iconify lucide--check size-3.5"></span>
					{ langs.T(ctx, "settings.lang.save_btn") }
				</button>
			</form>
		</div>
	</div>
}
